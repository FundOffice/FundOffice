<UserControl
    x:Class="Vetting.View.VettingReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Vetting.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Vetting.ViewModel"
    d:DataContext="{d:DesignInstance vm:VettingReportViewModel}"
    d:Height="900"
    d:Width="1000"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SpinnerStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeDashArray" Value="2 2" />
            <Setter Property="StrokeDashCap" Value="Round" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform x:Name="SpinTransform" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="run">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.Angle"
                                    From="0"
                                    To="360"
                                    Duration="0:0:0.8" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="run" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:ProviderRunViewModel}">
            <local:ProviderRunView />
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel
        Margin="16"
        AllowDrop="True"
        Background="Transparent"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <DockPanel>
            <Button
                Margin="10,0,0,0"
                Command="{Binding SaveNameCommand}"
                Content="保存"
                DockPanel.Dock="Right"
                Style="{StaticResource ButtonSuccess}" />
            <hc:TextBox
                hc:InfoElement.ShowClearButton="True"
                hc:InfoElement.Title="尽调名称"
                hc:InfoElement.TitlePlacement="Left"
                Text="{Binding NameEdit, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
        </DockPanel>

        <Separator Margin="5,10" />

        <GroupBox Header="文件列表" Style="{StaticResource GroupBoxTab}">

            <ListBox ItemsSource="{Binding OriginalFiles}">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListBoxItemCustom}" TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="4,4" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <!--  逐步模式：解析、生成、AI回答、查看问题、推荐产品  -->
                                    <DockPanel
                                        DockPanel.Dock="Right"
                                        IsEnabled="{Binding GenerateTemplatesCommand.IsRunning, Converter={StaticResource Boolean2BooleanReConverter}}"
                                        Visibility="{Binding IsAutoMode, Converter={StaticResource Boolean2VisibilityReConverter}}">
                                        <Button
                                            Command="{Binding FillTemplateCommand}"
                                            Content="生成"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource ButtonSuccess}" />
                                        <Button
                                            Margin="4,0"
                                            Command="{Binding AIAnswerCustomQuestionsCommand}"
                                            Content="AI回答"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource ButtonPrimary}"
                                            Visibility="Collapsed" />

                                        <ToggleButton
                                            x:Name="RecommendToggle"
                                            Margin="4,0"
                                            Background="Orange"
                                            BorderBrush="Orange"
                                            Content="推荐产品"
                                            DockPanel.Dock="Right"
                                            IsChecked="{Binding IsRecommendOpen}"
                                            Style="{StaticResource ToggleButtonPrimary}" />
                                    </DockPanel>
                                    <!--  自动模式：只显示自动运行  -->
                                    <Button
                                        Command="{Binding RunAutoCommand}"
                                        Content="自动运行"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource ButtonSuccess}"
                                        Visibility="{Binding IsAutoMode, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                    <!--  逐步模式：解析按钮  -->
                                    <Button
                                        Command="{Binding GenerateTemplatesCommand}"
                                        Content="解析"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource ButtonPrimary}"
                                        Visibility="{Binding IsAutoMode, Converter={StaticResource Boolean2VisibilityReConverter}}" />

                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding FileName}" />
                                    <Button
                                        Margin="5,0"
                                        Command="{Binding OpenFileCommand}"
                                        Content="打开"
                                        Style="{StaticResource ButtonInfo.Small}" />
                                </DockPanel>

                                <!--  推荐产品浮层（文件级）  -->
                                <Popup
                                    AllowsTransparency="True"
                                    IsOpen="{Binding IsRecommendOpen}"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=RecommendToggle}"
                                    StaysOpen="False">
                                    <Border
                                        MinWidth="400"
                                        Padding="8"
                                        Background="White"
                                        BorderBrush="Gray"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <DockPanel Grid.Column="0" Margin="4">
                                                <TextBlock
                                                    Margin="0,0,0,4"
                                                    DockPanel.Dock="Top"
                                                    FontWeight="SemiBold"
                                                    Text="所有产品（拖到右侧添加）" />
                                                <ListBox
                                                    x:Name="AvailableFundList"
                                                    AllowDrop="True"
                                                    DisplayMemberPath="Name"
                                                    DragOver="FundList_DragOver"
                                                    Drop="FundList_Drop"
                                                    ItemsSource="{Binding AvailableFunds}"
                                                    PreviewMouseMove="FundList_PreviewMouseMove"
                                                    SelectedItem="{Binding SelectedAvailable}" />
                                            </DockPanel>
                                            <DockPanel Grid.Column="1" Margin="4">
                                                <TextBlock
                                                    Margin="0,0,0,4"
                                                    DockPanel.Dock="Top"
                                                    FontWeight="SemiBold"
                                                    Text="推荐产品（拖动排序，拖回左侧移除）" />
                                                <ListBox
                                                    x:Name="RecommendedFundList"
                                                    AllowDrop="True"
                                                    DisplayMemberPath="Name"
                                                    DragOver="FundList_DragOver"
                                                    Drop="FundList_Drop"
                                                    ItemsSource="{Binding RecommendedFunds}"
                                                    PreviewMouseMove="FundList_PreviewMouseMove"
                                                    SelectedItem="{Binding SelectedRecommended}" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </Popup>

                                <!--  Provider 运行状态  -->
                                <ListBox
                                    ItemsSource="{Binding Providers}"
                                    Style="{StaticResource ListBoxCustom}"
                                    Visibility="{Binding Providers.Count, Converter={StaticResource Int2VisibilityConverter}}" />

                                <!--  填充输出日志  -->
                                <TextBox
                                    MaxHeight="150"
                                    Margin="0,5,0,0"
                                    IsReadOnly="True"
                                    Text="{Binding Output, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto"
                                    Visibility="{Binding Output, Converter={StaticResource StringToVisibilityConverter}}" />

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>


    </StackPanel>
</UserControl>
