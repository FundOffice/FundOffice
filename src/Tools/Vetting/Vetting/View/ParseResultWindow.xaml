<Window
    x:Class="Vetting.View.ParseResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Title="解析结果"
    Width="900"
    Height="600"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Margin="0,0,0,8" FontSize="14" FontWeight="SemiBold">
            <Run Text="文件:" />
            <Run Text="{Binding FileName}" />
            <Run Text="  Provider:" />
            <Run Text="{Binding ProviderName}" Foreground="Gray" />
        </TextBlock>

        <!-- 左右分栏：操作列表 + 详情 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：按 entity 分组的操作 TreeView -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                <TreeView ItemsSource="{Binding OperationGroups}" BorderThickness="0">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxHeight="40" />
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <!-- 右侧：选中项详情 -->
            <Border Grid.Column="1" Margin="8,0,0,0" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="类型:" Foreground="Gray" />
                        <TextBlock Text="{Binding SelectedOperation.TypeLabel}" Margin="0,0,0,8" FontWeight="SemiBold" />

                        <TextBlock Text="实体:" Foreground="Gray" Visibility="{Binding SelectedOperation.Entity, Converter={StaticResource StringToVisibilityConverter}}" />
                        <TextBlock Text="{Binding SelectedOperation.Entity}" Margin="0,0,0,8" Visibility="{Binding SelectedOperation.Entity, Converter={StaticResource StringToVisibilityConverter}}" />

                        <TextBlock Text="属性:" Foreground="Gray" Visibility="{Binding SelectedOperation.Property, Converter={StaticResource StringToVisibilityConverter}}" />
                        <TextBlock Text="{Binding SelectedOperation.Property}" Margin="0,0,0,8" Visibility="{Binding SelectedOperation.Property, Converter={StaticResource StringToVisibilityConverter}}" />

                        <TextBlock Text="问题:" Foreground="Gray" Visibility="{Binding SelectedOperation.Question, Converter={StaticResource StringToVisibilityConverter}}" />
                        <TextBlock Text="{Binding SelectedOperation.Question}" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="{Binding SelectedOperation.Question, Converter={StaticResource StringToVisibilityConverter}}" />

                        <TextBlock Text="位置:" Foreground="Gray" Visibility="{Binding SelectedOperation.LocationText, Converter={StaticResource StringToVisibilityConverter}}" />
                        <TextBlock Text="{Binding SelectedOperation.LocationText}" Margin="0,0,0,8" Visibility="{Binding SelectedOperation.LocationText, Converter={StaticResource StringToVisibilityConverter}}" />

                        <TextBlock Text="描述:" Foreground="Gray" Visibility="{Binding SelectedOperation.Description, Converter={StaticResource StringToVisibilityConverter}}" />
                        <TextBlock Text="{Binding SelectedOperation.Description}" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="{Binding SelectedOperation.Description, Converter={StaticResource StringToVisibilityConverter}}" />

                        <TextBlock Text="属性映射:" Foreground="Gray" Visibility="{Binding SelectedOperation.PropertiesText, Converter={StaticResource StringToVisibilityConverter}}" />
                        <TextBox Text="{Binding SelectedOperation.PropertiesText}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding SelectedOperation.PropertiesText, Converter={StaticResource StringToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部：附件需求列表 -->
        <GroupBox Grid.Row="2" Header="附件需求" Margin="0,8,0,0" Style="{StaticResource GroupBoxTab}">
            <ListBox ItemsSource="{Binding RequiredFiles}" BorderThickness="0" MaxHeight="150">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Foreground="Gray" Margin="8,0,0,0">
                                <Run Text="印章:" />
                                <Run Text="{Binding StampedText}" />
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Right" Foreground="Blue" Margin="8,0,0,0">
                                <Run Text="映射:" />
                                <Run Text="{Binding MapText}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Raw}" TextWrapping="Wrap" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
    </Grid>
</Window>