<Window
    x:Class="Vetting.View.ParseResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Vetting.Entity"
    xmlns:vc="clr-namespace:Vetting.Copilot;assembly=Vetting.Copilot"
    Title="解析结果"
    Width="800"
    Height="700"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>

        <DataTemplate DataType="{x:Type vc:PropItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Text="{Binding Header}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="15,0"
                    Text="→" />
                <TextBlock Grid.Column="2" Text="{Binding Prop}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vc:RecommendPropItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,8,0" Foreground="Gray">
                    <Run Text="{Binding Row, StringFormat=[{0}}" />
                    <Run Text="," />
                    <Run Text="{Binding Col, StringFormat={}{0}]}" />
                </TextBlock>

                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    Text="{Binding Header}" />
                <TextBlock
                    Grid.Column="2"
                    Margin="15,0"
                    Text="→" />
                <TextBlock Grid.Column="3" Text="{Binding Prop}" />
            </Grid>
        </DataTemplate>

        <!--  标量属性模板 (ScalarOp)  -->
        <DataTemplate x:Key="type_a">
            <Border
                Margin="0,0,0,4"
                Padding="8,5"
                BorderBrush="#DDD"
                BorderThickness="1"
                CornerRadius="3">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        FontWeight="SemiBold"
                        Foreground="RoyalBlue"
                        Text="type a" />
                    <StackPanel
                        Margin="0,0,10,0"
                        Orientation="Horizontal"
                        Visibility="{Binding HasEntity, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,3,0"
                            Foreground="Gray"
                            Text="映射:" />
                        <TextBlock Text="{Binding Entity}" />
                    </StackPanel>
                    <StackPanel
                        Margin="0,0,10,0"
                        Orientation="Horizontal"
                        Visibility="{Binding HasProperty, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,3,0"
                            Foreground="Gray"
                            Text="属性:" />
                        <TextBlock Text="{Binding Property}" />
                    </StackPanel>
                    <StackPanel
                        Margin="0,0,10,0"
                        Orientation="Horizontal"
                        Visibility="{Binding HasQuestion, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,3,0"
                            Foreground="Gray"
                            Text="问题:" />
                        <TextBlock Text="{Binding Question}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasLocation, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,3,0"
                            Foreground="Gray"
                            Text="位置:" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            Text="{Binding LocationText}" />
                    </StackPanel>
                </WrapPanel>
            </Border>
        </DataTemplate>

        <!--  列表展开模板 (ListExpandOp)  -->
        <DataTemplate x:Key="type_c">
            <Border
                Margin="0,0,0,4"
                Padding="8,5"
                Background="#F8FFF8"
                BorderBrush="#4CAF50"
                BorderThickness="1"
                CornerRadius="3">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            FontWeight="SemiBold"
                            Foreground="#4CAF50"
                            Text="type c" />
                        <StackPanel
                            Margin="0,0,10,0"
                            Orientation="Horizontal"
                            Visibility="{Binding HasEntity, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock
                                Margin="0,0,3,0"
                                Foreground="Gray"
                                Text="映射:" />
                            <TextBlock Text="{Binding Entity}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasRange, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock
                                Margin="0,0,3,0"
                                Foreground="Gray"
                                Text="范围:" />
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="11"
                                Text="{Binding RangeText}" />
                        </StackPanel>
                    </WrapPanel>

                    <ListBox
                        Background="#F0FFF0"
                        BorderThickness="0"
                        IsHitTestVisible="False"
                        ItemsSource="{Binding PropertyMaps}"
                        Style="{StaticResource ListBoxCustom}"
                        Visibility="{Binding HasPropertiesMap, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  网格模板 (GridOp)  -->
        <DataTemplate x:Key="type_d">
            <Border
                Margin="0,0,0,4"
                Padding="8,5"
                Background="#FFF8F0"
                BorderBrush="#FF9800"
                BorderThickness="1"
                CornerRadius="3">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            FontWeight="SemiBold"
                            Foreground="#FF9800"
                            Text="{Binding TypeLabel}" />
                        <StackPanel
                            Margin="0,0,10,0"
                            Orientation="Horizontal"
                            Visibility="{Binding HasEntity, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock
                                Margin="0,0,3,0"
                                Foreground="Gray"
                                Text="映射:" />
                            <TextBlock Text="{Binding Entity}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasRange, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock
                                Margin="0,0,3,0"
                                Foreground="Gray"
                                Text="范围:" />
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="11"
                                Text="{Binding RangeText}" />
                        </StackPanel>
                    </WrapPanel>

                    <ListBox
                        Background="#FFF5E6"
                        BorderThickness="0"
                        IsHitTestVisible="False"
                        ItemsSource="{Binding PropertyMaps}"
                        Style="{StaticResource ListBoxCustom}"
                        Visibility="{Binding HasPropertiesMap, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  段落问题模板 (ParagraphOp)  -->
        <DataTemplate x:Key="type_z">
            <Border
                Margin="0,0,0,4"
                Padding="8,5"
                Background="#FAF0FC"
                BorderBrush="#9C27B0"
                BorderThickness="1"
                CornerRadius="3">
                <StackPanel>
                    <DockPanel>
                        <Button
                            Margin="0,0,4,0"
                            Padding="6,2"
                            Command="{Binding ToggleExpandCommand}"
                            Content="▼"
                            DockPanel.Dock="Right"
                            Style="{StaticResource ButtonPrimary.Small}"
                            Visibility="{Binding HasQuestion, Converter={StaticResource Boolean2VisibilityConverter}}" />

                        <Button
                            Margin="5,0"
                            Padding="10,3"
                            Command="{Binding SaveQACommand}"
                            Content="保存"
                            DockPanel.Dock="Right"
                            Style="{StaticResource ButtonPrimary.Small}"
                            Visibility="{Binding IsExpanded, Converter={StaticResource Boolean2VisibilityConverter}}" />

                        <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                FontWeight="SemiBold"
                                Foreground="#9C27B0"
                                Text="type z" />
                            <StackPanel
                                Margin="0,0,10,0"
                                Orientation="Horizontal"
                                Visibility="{Binding HasEntity, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <TextBlock
                                    Margin="0,0,3,0"
                                    Foreground="Gray"
                                    Text="映射:" />
                                <TextBlock Text="{Binding Entity}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,0,10,0"
                                Orientation="Horizontal"
                                Visibility="{Binding HasProperty, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <TextBlock
                                    Margin="0,0,3,0"
                                    Foreground="Gray"
                                    Text="属性:" />
                                <TextBlock Text="{Binding Property}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,0,10,0"
                                Orientation="Horizontal"
                                Visibility="{Binding HasQuestion, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <TextBlock
                                    Margin="0,0,3,0"
                                    Foreground="Gray"
                                    Text="问题:" />
                                <TextBlock Text="{Binding Question}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasLocation, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <TextBlock
                                    Margin="0,0,3,0"
                                    Foreground="Gray"
                                    Text="位置:" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Text="{Binding LocationText}" />
                            </StackPanel>
                        </WrapPanel>
                    </DockPanel>

                    <!--  展开区域：TextBox + 保存按钮  -->
                    <StackPanel Margin="0,5,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <TextBox
                            MinHeight="60"
                            Margin="0,0,0,5"
                            AcceptsReturn="True"
                            Text="{Binding ManualAnswer, UpdateSourceTrigger=PropertyChanged}" />

                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  推荐产品模板 (RecommendOp)  -->
        <DataTemplate x:Key="type_b">
            <Border
                Margin="0,0,0,4"
                Padding="8,5"
                Background="#FDF0F5"
                BorderBrush="#E91E63"
                BorderThickness="1"
                CornerRadius="3">
                <StackPanel>
                    <DockPanel>

                        <DockPanel DockPanel.Dock="Right">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="Blue"
                                Text="{Binding BoundFundName}" />
                            <ToggleButton
                                x:Name="BindToggle"
                                Margin="4,0"
                                Padding="6,2"
                                Content="绑定"
                                IsChecked="{Binding IsPopupOpen}"
                                Style="{StaticResource ToggleButtonPrimary.Small}" />
                            <Popup
                                AllowsTransparency="True"
                                IsOpen="{Binding IsPopupOpen}"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=BindToggle}"
                                StaysOpen="False">
                                <Border
                                    MinWidth="300"
                                    MaxHeight="350"
                                    Padding="8"
                                    Background="White"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <DockPanel>
                                        <TextBox
                                            Margin="0,0,0,6"
                                            DockPanel.Dock="Top"
                                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                                        <ListBox
                                            DisplayMemberPath="Name"
                                            ItemsSource="{Binding FilteredFunds}"
                                            SelectedItem="{Binding SelectedFund}" />
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </DockPanel>


                        <TextBlock
                            Margin="0,0,8,0"
                            FontWeight="SemiBold"
                            Foreground="#E91E63"
                            Text="type b" />
                        <StackPanel
                            Margin="0,0,10,0"
                            Orientation="Horizontal"
                            Visibility="{Binding HasEntity, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock
                                Margin="0,0,3,0"
                                Foreground="Gray"
                                Text="映射:" />
                            <TextBlock Text="{Binding Entity}" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,0,10,0"
                            Orientation="Horizontal"
                            Visibility="{Binding HasTable, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock
                                Margin="0,0,3,0"
                                Foreground="Gray"
                                Text="表格:" />
                            <TextBlock Text="{Binding Table}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasRange, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock
                                Margin="0,0,3,0"
                                Foreground="Gray"
                                Text="范围:" />
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="11"
                                Text="{Binding RangeText}" />
                        </StackPanel>


                    </DockPanel>


                    <ListBox
                        Background="#FFF0F5"
                        BorderThickness="0"
                        IsHitTestVisible="False"
                        ItemsSource="{Binding RecommendProps}"
                        Style="{StaticResource ListBoxCustom}"
                        Visibility="{Binding HasRecommendProps, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  未知表格模板 (UnknownTableOp)  -->
        <DataTemplate x:Key="type_g">
            <Border
                Margin="0,0,0,4"
                Padding="8,5"
                Background="#F5F5F5"
                BorderBrush="#607D8B"
                BorderThickness="1"
                CornerRadius="3">
                <StackPanel>
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            FontWeight="SemiBold"
                            Foreground="#607D8B"
                            Text="type g" />
                        <StackPanel
                            Margin="0,0,10,0"
                            Orientation="Horizontal"
                            Visibility="{Binding HasDescription, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock
                                Margin="0,0,3,0"
                                Foreground="Gray"
                                Text="描述:" />
                            <TextBlock Text="{Binding Description}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasRange, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <TextBlock
                                Margin="0,0,3,0"
                                Foreground="Gray"
                                Text="范围:" />
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="11"
                                Text="{Binding RangeText}" />
                        </StackPanel>
                    </WrapPanel>
                    <ListBox
                        Background="#EFEFEF"
                        BorderThickness="0"
                        IsHitTestVisible="False"
                        ItemsSource="{Binding PropertyMaps}"
                        Style="{StaticResource ListBoxCustom}"
                        Visibility="{Binding HasPropertiesMap, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  默认模板  -->
        <DataTemplate x:Key="DefaultTemplate">
            <Border
                Margin="0,0,0,4"
                Padding="8,5"
                BorderBrush="#DDD"
                BorderThickness="1"
                CornerRadius="3">
                <TextBlock Text="{Binding TypeLabel}" />
            </Border>
        </DataTemplate>

        <!--  使用 ContentControl + DataTrigger 选择模板  -->
        <Style x:Key="OperationItemStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource DefaultTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding OpType}" Value="Scalar">
                    <Setter Property="ContentTemplate" Value="{StaticResource type_a}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OpType}" Value="ListExpand">
                    <Setter Property="ContentTemplate" Value="{StaticResource type_c}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OpType}" Value="Grid">
                    <Setter Property="ContentTemplate" Value="{StaticResource type_d}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OpType}" Value="Paragraph">
                    <Setter Property="ContentTemplate" Value="{StaticResource type_z}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OpType}" Value="Recommend">
                    <Setter Property="ContentTemplate" Value="{StaticResource type_b}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding OpType}" Value="UnknownTable">
                    <Setter Property="ContentTemplate" Value="{StaticResource type_g}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type c:ParsedJson}">
            <TextBlock Text="{Binding Time, StringFormat=MM-dd HH:mm:ss}" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HistoryPanel">
            <WrapPanel IsItemsHost="True" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,6"
            FontSize="14"
            FontWeight="SemiBold"
            Text="历史解析结果" />

        <!--  历史列表  -->
        <DockPanel
            Grid.Row="1"
            Margin="0,0,0,6"
            LastChildFill="True">
            <Button
                Margin="4,0,0,0"
                Padding="4,2"
                Command="{Binding DeleteSelectedCommand}"
                Content="删除"
                DockPanel.Dock="Right"
                Style="{StaticResource ButtonDanger}" />
            <ListBox
                BorderBrush="#CCC"
                FontFamily="Consolas"
                FontSize="12"
                ItemsPanel="{StaticResource HistoryPanel}"
                ItemsSource="{Binding HistoryItems}"
                SelectedItem="{Binding SelectedItem}" />
        </DockPanel>


        <!--  操作列表  -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Operations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" Style="{StaticResource OperationItemStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
