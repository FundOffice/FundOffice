                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Question, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                Header="问题" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Answer, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                Header="回答" />
