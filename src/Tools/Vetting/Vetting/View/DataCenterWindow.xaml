            <TabItem Header="推荐产品">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="4">
                        <TextBlock
                            Margin="0,0,0,4"
                            DockPanel.Dock="Top"
                            FontWeight="SemiBold"
                            Text="所有产品（拖到右侧添加）" />
                        <ListBox
                            x:Name="AllFundsList"
                            AllowDrop="True"
                            DisplayMemberPath="Name"
                            DragOver="OnDragOver"
                            Drop="OnAllFundsDrop"
                            ItemsSource="{Binding FundInfos}"
                            PreviewMouseMove="OnListPreviewMouseMove"
                            SelectedItem="{Binding GlobalSelectedAvailable}" />
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="4">
                        <TextBlock
                            Margin="0,0,0,4"
                            DockPanel.Dock="Top"
                            FontWeight="SemiBold"
                            Text="推荐产品（拖动排序，拖到左侧移除）" />
                        <ListBox
                            x:Name="RecFundsList"
                            AllowDrop="True"
                            DisplayMemberPath="Name"
                            DragOver="OnDragOver"
                            Drop="OnRecFundsDrop"
                            ItemsSource="{Binding GlobalRecommendedFunds}"
                            PreviewMouseMove="OnListPreviewMouseMove"
                            SelectedItem="{Binding GlobalSelectedRecommended}" />
                    </DockPanel>
                </Grid>
            </TabItem>


            <TabItem Header="奖项">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button
                            Margin="4"
                            Command="{Binding AddItemCommand}"
                            CommandParameter="Award"
                            Content="新增"
                            Style="{StaticResource ButtonSuccess}" />
                        <Button
                            Margin="4"
                            Command="{Binding DeleteItemCommand}"
                            Content="删除"
                            Style="{StaticResource ButtonDanger}" />
                        <Button
                            Margin="4"
                            Command="{Binding ClearItemsCommand}"
                            CommandParameter="Award"
                            Content="清空"
                            Style="{StaticResource ButtonDanger}" />
                    </StackPanel>
                    <DataGrid
                        AutoGenerateColumns="False"
                        ItemsSource="{Binding Awards}"
                        SelectedItem="{Binding CurrentItem, Mode=OneWayToSource}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding Time, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                Header="获奖时间" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Entity2, UpdateSourceTrigger=PropertyChanged, Delay=200}"
