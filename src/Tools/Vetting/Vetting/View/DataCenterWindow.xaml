                            <DataGridTextColumn
                                Width="200"
                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                Header="奖项名称" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Evaluator, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                Header="评价机构" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="资产规模">
