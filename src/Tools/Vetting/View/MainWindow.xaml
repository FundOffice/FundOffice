<Window
    x:Class="Vetting.View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Vetting.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Vetting.ViewModel"
    x:Name="root"
    Title="AI尽调"
    Width="1200"
    Height="850"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:VettingReportViewModel}">
            <local:VettingReportView />
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="8">
        <hc:UniformSpacingPanel DockPanel.Dock="Top" Spacing="8">
            <Button
                Background="GreenYellow"
                Command="{Binding NewVettingCommand}"
                Content="新建尽调" />
            <Button
                Command="{Binding SetAIConfigCommand}"
                Content="AI设置"
                Style="{StaticResource ButtonPrimary}" />
            <Button
                Background="Orange"
                Command="{Binding OpenDataCenterCommand}"
                Content="数据中心"
                Foreground="White" />

            <Border
                Margin="50,0,0,0"
                BorderBrush="RoyalBlue"
                BorderThickness="1"
                CornerRadius="5">
                <DockPanel>
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Text="请选择AI接口" />

                    <ListBox
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        ItemsPanel="{StaticResource StackHorizontalItemsPanelTemplate}"
                        ItemsSource="{Binding Source={x:Static vm:MainWindowViewModel.GlobalProviders}}"
                        SelectionMode="Multiple"
                        Style="{StaticResource ListBoxCustom}">

                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListBoxItemCustom}" TargetType="ListBoxItem">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox
                                    Margin="5,0"
                                    Content="{Binding Name}"
                                    IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </hc:UniformSpacingPanel>

        <Separator Margin="5" DockPanel.Dock="Top" />

        <DockPanel>
            <hc:SearchBar
                hc:InfoElement.Title="筛选"
                DockPanel.Dock="Top"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ListBox
                Width="400"
                ItemsSource="{Binding VettingView.View}"
                SelectedItem="{Binding SelectedVetting}">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListBoxItemBaseStyle}" TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel HorizontalAlignment="Stretch">
                            <Button
                                x:Name="del"
                                Command="{Binding DataContext.DeleteVettingCommand, ElementName=root}"
                                CommandParameter="{Binding}"
                                Content="删除"
                                DockPanel.Dock="Right"
                                Style="{StaticResource ButtonDanger.Small}"
                                Visibility="Collapsed" />
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="{Binding CreateTime, StringFormat=yyyy-MM-dd}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                        </DockPanel>

                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="del" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </DataTemplate.Triggers>

                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <hc:SimplePanel>
            <ContentControl Content="{Binding SelectedVetting}" />

            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                hc:Growl.GrowlParent="True" />
        </hc:SimplePanel>
    </DockPanel>
</Window>
