<UserControl
    x:Class="Vetting.View.VettingReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Vetting.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Vetting.ViewModel"
    d:DataContext="{d:DesignInstance vm:VettingReportViewModel}"
    d:Height="900"
    d:Width="1000"
    mc:Ignorable="d">

    <UserControl.Resources>
        <local:Int2VisibilityConverter x:Key="Int2VisibilityConverter" />
        <local:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <Style x:Key="SpinnerStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stroke" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeDashArray" Value="2 2" />
            <Setter Property="StrokeDashCap" Value="Round" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform x:Name="SpinTransform" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="run">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.Angle"
                                    From="0"
                                    To="360"
                                    Duration="0:0:0.8" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="run" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:VettingParseTaskViewModel}">
            <StackPanel Margin="0,4">
                <DockPanel>
                    <!--  Done: 绿勾  -->
                    <TextBlock
                        DockPanel.Dock="Left"
                        Foreground="Green"
                        Text="✔"
                        Visibility="{Binding Status, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Done}" />
                    <!--  Error: 红叉  -->
                    <TextBlock
                        DockPanel.Dock="Left"
                        Foreground="Red"
                        Text="✖"
                        Visibility="{Binding Status, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Error}" />
                    <!--  Running: spinner  -->
                    <Ellipse
                        DockPanel.Dock="Left"
                        Style="{StaticResource SpinnerStyle}"
                        Visibility="{Binding Status, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Running}" />
                    <!--  Pending: 灰点  -->
                    <Ellipse
                        Width="8"
                        Height="8"
                        Margin="3,0"
                        DockPanel.Dock="Left"
                        Fill="Gray"
                        Visibility="{Binding Status, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Pending}" />

                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding TaskName}" />
                    <TextBlock
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Foreground="Gray"
                        Text="{Binding Elapsed}" />
                    <TextBlock
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Foreground="Gray"
                        Text="{Binding UsageText}" />


                    <TextBlock
                        Foreground="Red"
                        Text="{Binding ErrorMessage}"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
                </DockPanel>

                <!--  展开时显示 Output 和 ErrorMessage  -->
                <ItemsControl ItemsSource="{Binding Output}" Visibility="{Binding IsExpanded, Converter={StaticResource Boolean2VisibilityConverter}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel
        Margin="16"
        AllowDrop="True"
        Background="Transparent"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <DockPanel>
            <Button
                Margin="10,0,0,0"
                Command="{Binding SaveNameCommand}"
                Content="保存"
                DockPanel.Dock="Right"
                Style="{StaticResource ButtonSuccess}" />
            <hc:TextBox
                hc:InfoElement.ShowClearButton="True"
                hc:InfoElement.Title="尽调名称"
                hc:InfoElement.TitlePlacement="Left"
                Text="{Binding NameEdit, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
        </DockPanel>

        <Separator Margin="5,10" />

        <GroupBox Header="文件列表" Style="{StaticResource GroupBoxTab}">

            <ListBox ItemsSource="{Binding OriginalFiles}">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListBoxItemCustom}" TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="4,4" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <Button
                                        Command="{Binding GenerateTemplatesCommand}"
                                        Content="解析成模板"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource ButtonPrimary}" />

                                    <TextBlock VerticalAlignment="Center" Text="{Binding FileName}" />
                                    <Button
                                        Margin="5,0"
                                        Command="{Binding OpenFileCommand}"
                                        Content="打开"
                                        Style="{StaticResource ButtonInfo.Small}" />
                                </DockPanel>


                                <ListBox
                                    ItemsSource="{Binding Tasks}"
                                    Style="{StaticResource ListBoxCustom}"
                                    Visibility="{Binding Tasks.Count, Converter={StaticResource Int2VisibilityConverter}}" />

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>


        <Separator />

        <GroupBox
            Header="模板列表"
            Style="{StaticResource GroupBoxTab}"
            Visibility="{Binding TemplateFiles.Count, Converter={StaticResource Int2VisibilityConverter}}">
            <ListBox ItemsSource="{Binding TemplateFiles}">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListBoxItemCustom}" TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="4,4" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <Button
                                        Margin="4,0"
                                        Command="{Binding FillTemplateCommand}"
                                        Content="填充模板"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource ButtonSuccess}" />
                                    <Button
                                        Margin="4,0"
                                        Command="{Binding AIAnswerCustomQuestionsCommand}"
                                        Content="AI回答"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource ButtonPrimary}" />
                                    <Button
                                        Margin="4,0"
                                        Command="{Binding ViewCustomQuestionsCommand}"
                                        Content="查看问题"
                                        DockPanel.Dock="Right" />


                                    <TextBlock VerticalAlignment="Center" Text="{Binding FileName}" />

                                    <Button
                                        Margin="5,0"
                                        Command="{Binding OpenFileCommand}"
                                        Content="打开"
                                        Style="{StaticResource ButtonInfo.Small}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>


        <GroupBox
            Header="报告列表"
            Style="{StaticResource GroupBoxTab}"
            Visibility="{Binding FinalFiles.Count, Converter={StaticResource Int2VisibilityConverter}}">
            <ListBox ItemsSource="{Binding FinalFiles}">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ListBoxItemCustom}" TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="4,4" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Button
                                Command="{Binding OpenFileCommand}"
                                Content="打开"
                                DockPanel.Dock="Right"
                                Style="{StaticResource ButtonInfo.Small}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding FileName}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>


    </StackPanel>
</UserControl>
