<Window
    x:Class="Vetting.View.CustomQuestionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Vetting.ViewModel"
    Title="{Binding WindowTitle}"
    Width="560"
    Height="480"
    d:DataContext="{d:DesignInstance Type=vm:CustomQuestionsViewModel}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Questions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding Question}"
                            TextWrapping="Wrap" />
                        <hc:TextBox
                            Margin="0,4,0,0"
                            hc:InfoElement.Title="{Binding Placeholder}"
                            hc:InfoElement.TitlePlacement="Left"
                            AcceptsReturn="True"
                            Text="{Binding Answer, UpdateSourceTrigger=LostFocus}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Window>
