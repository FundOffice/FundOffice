        <Geometry x:Key="f.check">M438.6 105.4c12.5 12.5 12.5 32.8 0 45.3l-256 256c-12.5 12.5-32.8 12.5-45.3 0l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L160 338.7 393.4 105.4c12.5-12.5 32.8-12.5 45.3 0z</Geometry>
        <Geometry x:Key="f.trash-can">M135.2 17.7C140.6 6.8 151.7 0 163.8 0L284.2 0c12.1 0 23.2 6.8 28.6 17.7L320 32l96 0c17.7 0 32 14.3 32 32s-14.3 32-32 32L32 96C14.3 96 0 81.7 0 64S14.3 32 32 32l96 0 7.2-14.3zM32 128l384 0 0 320c0 35.3-28.7 64-64 64L96 512c-35.3 0-64-28.7-64-64l0-320zm96 64c-8.8 0-16 7.2-16 16l0 224c0 8.8 7.2 16 16 16s16-7.2 16-16l0-224c0-8.8-7.2-16-16-16zm96 0c-8.8 0-16 7.2-16 16l0 224c0 8.8 7.2 16 16 16s16-7.2 16-16l0-224c0-8.8-7.2-16-16-16zm96 0c-8.8 0-16 7.2-16 16l0 224c0 8.8 7.2 16 16 16s16-7.2 16-16l0-224c0-8.8-7.2-16-16-16z</Geometry>

        <DataTemplate x:Key="AllocationTemplate">
            <DockPanel LastChildFill="False">
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                <TextBlock
                    Width="50"
                    Margin="5,0"
                    Text="{Binding Ratio, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0}%}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="EditAllocationTemplate">
            <Border
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="8">
                <DockPanel LastChildFill="False">
                    <hc:ComboBox
                        MinWidth="100"
                        VerticalAlignment="Center"
                        IsEditable="True"
                        ItemsSource="{Binding DataContext.Recipients, RelativeSource={RelativeSource AncestorType=local:AllocWindow}}"
                        SelectedItem="{Binding Name}"
                        Text="{Binding Name}" />
                    <TextBox
                        Width="50"
                        Margin="5,0"
                        Text="{Binding Ratio, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        hc:IconElement.Geometry="{StaticResource f.trash-can}"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.DeleteCommand}"
                        CommandParameter="{Binding}"
                        Foreground="Red"
                        Style="{StaticResource ButtonIcon.Small}" />
                </DockPanel>
            </Border>
        </DataTemplate>


        <Style x:Key="EditSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            Margin="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <!--  使用 Grid 让 Viewbox 自动填满  -->
                            <Viewbox
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform">
                                <Path
                                    x:Name="ico"
                                    Data="{StaticResource f.eye}"
                                    Fill="Black" />
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ico" Property="Data" Value="{StaticResource f.pen}" />
                                <Setter TargetName="ico" Property="Fill" Value="Green" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="EditSwitch.Small"
            BasedOn="{StaticResource EditSwitch}"
            TargetType="ToggleButton">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="8">
        <hc:SimplePanel DockPanel.Dock="Top">
            <hc:TextBox hc:InfoElement.Placeholder="请输入投资者名称" Text="{Binding SearchInvestor, UpdateSourceTrigger=PropertyChanged, Delay=200}" />

            <Button
                HorizontalAlignment="Right"
                hc:IconElement.Geometry="{StaticResource DeleteFillCircleGeometry}"
                Command="{Binding ClearSearchCommand}"
                Style="{StaticResource ButtonIcon.Small}" />

        </hc:SimplePanel>

        <Separator Margin="0,5" DockPanel.Dock="Top" />

        <ListBox
            BorderThickness="0"
            ItemsSource="{Binding InvestorSource.View}"
            Style="{StaticResource ListBoxCustom}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel MinHeight="30" LastChildFill="False">
                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                        <ToggleButton
                            Margin="5,0"
                            BorderThickness="0"
                            IsChecked="{Binding IsEditMode}"
                            Style="{StaticResource EditSwitch.Small}" />

                        <Button
                            hc:IconElement.Geometry="{StaticResource AddGeometry}"
                            Command="{Binding AddCommand}"
                            Style="{StaticResource ButtonIcon.Small}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource Boolean2VisibilityConverter}}" />

                        <Button
                            hc:IconElement.Geometry="{StaticResource f.check}"
                            Command="{Binding ConfirmCommand}"
                            Foreground="Green"
                            Style="{StaticResource ButtonIcon.Small}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource Boolean2VisibilityConverter}}" />



                        <ListBox
                            x:Name="alloc"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            ItemTemplate="{StaticResource AllocationTemplate}"
                            ItemsPanel="{StaticResource WrapHorizontalItemsPanelTemplate}"
                            ItemsSource="{Binding Allocations}"
                            Style="{StaticResource ListBoxCustom}" />


                    </DockPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                            <Setter TargetName="alloc" Property="ItemTemplate" Value="{StaticResource EditAllocationTemplate}" />
                        </DataTrigger>

                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</Window>
