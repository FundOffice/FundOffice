<Window
    x:Class="FMO.FeeCalc.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO.FeeCalc"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="管理费计算器   -   暂不支持差异化管理费的基金"
    Width="1100"
    Height="750"
    Icon="/logo.ico"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.DataContext>
        <local:MainWindowViewModel />
    </Window.DataContext>
    <DockPanel Margin="8">

        <DockPanel DockPanel.Dock="Top">
            <DockPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="2,0" />
                </Style>
                <Style BasedOn="{StaticResource DatePicker.Small}" TargetType="DatePicker">
                    <Setter Property="Width" Value="100" />
                </Style>
            </DockPanel.Resources>
            <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                <DockPanel DockPanel.Dock="Right">
                    <hc:ProgressButton
                        Command="{Binding SyncByAPICommand}"
                        Content="API同步数据"
                        Style="{StaticResource ProgressButtonPrimary}" />

                    <Button
                        Margin="10,0"
                        Command="{Binding ImportFeeDataCommand}"
                        Content="导入费用数据"
                        Style="{StaticResource ButtonInfo}" />

                    <Button
                        Margin="10,0"
                        Command="{Binding ImportTADataCommand}"
                        Content="导入TA数据"
                        Style="{StaticResource ButtonInfo}" />

                    <Button
                        Margin="10,0"
                        Background="Gold"
                        Command="{Binding SetAllocCommand}"
                        Content="配置分配方案" />

                </DockPanel>

                <DockPanel IsEnabled="{Binding IsWorking, Converter={StaticResource Boolean2BooleanReConverter}}">
                    <TextBlock Text="起始日期" />
                    <DatePicker SelectedDate="{Binding Begin, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="终止日期" />
                    <DatePicker SelectedDate="{Binding End, UpdateSourceTrigger=PropertyChanged}" />

                </DockPanel>

                <Button
                    Width="100"
                    Margin="10,0"
                    Command="{Binding CalcCommand}"
                    Content="计算"
                    Style="{StaticResource ButtonSuccess}" />




            </DockPanel>

            <DockPanel>

                <ComboBox
                    Width="70"
                    ItemsSource="{Binding Years}"
                    SelectedIndex="0"
                    SelectedItem="{Binding Year}"
                    Style="{StaticResource ComboBox.Small}" />

                <ListBox
                    BorderThickness="0"
                    IsEnabled="{Binding IsWorking, Converter={StaticResource Boolean2BooleanReConverter}}"
                    ItemsSource="{Binding MonthQuarters}"
                    Style="{StaticResource ListBoxCustom}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SetDateRangeCommand}"
                                CommandParameter="{Binding .}"
                                Content="{Binding .}"
                                Style="{StaticResource ButtonDefault.Small}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </DockPanel>

        <Separator Margin="0,5" DockPanel.Dock="Top" />

        <DockPanel DockPanel.Dock="Top">
            <Button Command="{Binding SelectAllCommand}" Content="全选" />
            <Button Command="{Binding DeselectAllCommand}" Content="全不选" />

            <hc:TextBox
                Margin="10,0,0,0"
                hc:InfoElement.Placeholder="请输入产品名"
                Text="{Binding SearchFundKey, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
        </DockPanel>

        <hc:SimplePanel Margin="0,5,0,0">

            <ListBox
                IsEnabled="{Binding IsWorking, Converter={StaticResource Boolean2BooleanReConverter}}"
                ItemsSource="{Binding FundSource.View}"
                SelectionMode="Multiple"
                Style="{StaticResource ListBoxCustom}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <hc:WaterfallPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <WrapPanel>
                            <CheckBox
                                Margin="0,5"
                                Content="{Binding Fund.ShortName}"
                                IsChecked="{Binding IsChoosed}"
                                IsEnabled="{Binding IsDataValid}" />

                            <TextBlock
                                Margin="30,0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="OrangeRed"
                                Text="{Binding Error}" />
                        </WrapPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer
                Margin="0,200,0,0"
                HorizontalAlignment="Right"
                VerticalScrollBarVisibility="Hidden">
                <StackPanel
                    Margin="0,10,10,10"
                    VerticalAlignment="Bottom"
                    hc:Growl.GrowlParent="True" />
            </ScrollViewer>
        </hc:SimplePanel>
    </DockPanel>
</Window>
