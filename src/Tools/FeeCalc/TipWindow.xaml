<Window
    x:Class="FMO.FeeCalc.TipWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FMO.FeeCalc"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="提示"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance Type=local:TipWindowViewModel}"
    mc:Ignorable="d">
    <StackPanel>
        <DockPanel HorizontalAlignment="Center" TextElement.FontSize="16">
            <TextBlock Text="{Binding SuccessCount, StringFormat=成功: {0}}" />
            <TextBlock Margin="10,0" Text="{Binding ErrorCount, StringFormat=失败: {0}}" />
            <TextBlock Text="{Binding SkipCount, StringFormat=跳过: {0}}" />
        </DockPanel>

        <ListView
            MaxHeight="700"
            Margin="0,4"
            ItemsSource="{Binding Items}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <!--  成功绿色  -->
                        <DataTrigger Binding="{Binding ItemType}" Value="Success">
                            <Setter Property="Foreground" Value="Green" />
                        </DataTrigger>
                        <!--  跳过橙黄  -->
                        <DataTrigger Binding="{Binding ItemType}" Value="Skip">
                            <Setter Property="Foreground" Value="DarkOrange" />
                        </DataTrigger>
                        <!--  错误红色  -->
                        <DataTrigger Binding="{Binding ItemType}" Value="Error">
                            <Setter Property="Foreground" Value="Red" />
                        </DataTrigger>
                        <!--  信息蓝色  -->
                        <DataTrigger Binding="{Binding ItemType}" Value="Info">
                            <Setter Property="Foreground" Value="DodgerBlue" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.View>
                <GridView>
                    <GridViewColumn
                        Width="70"
                        DisplayMemberBinding="{Binding RowNum}"
                        Header="行号" />
                    <GridViewColumn
                        Width="Auto"
                        DisplayMemberBinding="{Binding Msg}"
                        Header="备注信息" />
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</Window>
