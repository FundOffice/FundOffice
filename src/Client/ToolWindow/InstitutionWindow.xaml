<Window
    x:Class="FMO.InstitutionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comp="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:FMO.Shared;assembly=SharedUI"
    Title="编辑机构"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance Type=local:InstitutionWindowViewModel}"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SharedUI;component/Themes/NewFileControl.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:IdentityViewMdoel}">
                <DockPanel>
                    <ComboBox
                        Width="150"
                        BorderThickness="0"
                        ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:InstitutionWindow}, Path=DataContext.IDTypes}"
                        SelectedItem="{Binding Type}" />
                    <TextBox BorderThickness="0" Text="{Binding Id}" />
                </DockPanel>
            </DataTemplate>

            <DataTemplate x:Key="CapitalText">
                <shared:CopyableTextBlock Text="{Binding ., StringFormat={}{0} 万元}" />
            </DataTemplate>

            <Style x:Key="RightAlignText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Right" />
            </Style>

            <SolidColorBrush x:Key="LabelBrush">Gray</SolidColorBrush>

            <Style BasedOn="{StaticResource {x:Type shared:ModifiableControl}}" TargetType="shared:ModifiableControl">
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock
                                Width="60"
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource LabelBrush}"
                                Text="{Binding .}"
                                TextAlignment="Right" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <shared:CopyableTextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="IsReadOnly" Value="{Binding RelativeSource={RelativeSource AncestorType=local:InstitutionWindow}, Path=DataContext.IsReadOnly}" />
            </Style>

            <DataTemplate x:Key="DT.Text.Cap">
                <TextBox
                    MinWidth="80"
                    BorderThickness="0"
                    Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Margin="8">
        <Grid MaxWidth="400">
            <StackPanel TextElement.FontSize="13">
                <StackPanel.Resources>
                    <Style TargetType="ContentControl">
                        <Setter Property="Margin" Value="0,3" />
                    </Style>
                </StackPanel.Resources>

                <shared:ModifiableControl
                    Margin="0,0,30,0"
                    HorizontalContentAlignment="Stretch"
                    Header="名称"
                    Modifier="{Binding Name}" />

                <StackPanel>
                    <shared:ModifiableControl
                        HorizontalContentAlignment="Stretch"
                        Header="证件"
                        Modifier="{Binding Identity}">
                        <shared:ModifiableControl.EditTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding NewValue}" />
                            </DataTemplate>
                        </shared:ModifiableControl.EditTemplate>
                    </shared:ModifiableControl>


                    <shared:ModifiableControl
                        HorizontalContentAlignment="Stretch"
                        Header="实控人"
                        Modifier="{Binding ArtificialPerson}" />

                    <shared:ModifiableControl
                        ContentTemplate="{StaticResource CapitalText}"
                        EditTemplate="{StaticResource DT.Text.Cap}"
                        Header="注册资本"
                        Modifier="{Binding RegisterCapital}" />
                    <shared:ModifiableControl
                        ContentTemplate="{StaticResource CapitalText}"
                        EditTemplate="{StaticResource DT.Text.Cap}"
                        Header="实缴"
                        Modifier="{Binding RealCapital}" />

                    <shared:ModifiableControl
                        HorizontalContentAlignment="Stretch"
                        Header="成立日期"
                        Modifier="{Binding SetupDate}">
                        <shared:ModifiableControl.EditTemplate>
                            <DataTemplate>
                                <DatePicker BorderThickness="0" SelectedDate="{Binding NewValue, Converter={StaticResource DataTimeDateOnlySwitchConverter}}" />
                            </DataTemplate>
                        </shared:ModifiableControl.EditTemplate>
                    </shared:ModifiableControl>

                    <shared:ModifiableControl Header="核销日期" Modifier="{Binding ExpireDate}">
                        <shared:ModifiableControl.EditTemplate>
                            <DataTemplate>
                                <DockPanel MinHeight="28">
                                    <DatePicker
                                        Width="110"
                                        BorderThickness="0"
                                        DisplayDate="{Binding NewValue.Today, Mode=OneWay}"
                                        SelectedDate="{Binding NewValue.Date}"
                                        Visibility="{Binding NewValue.IsLongTerm, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                                    <CheckBox
                                        Margin="8,0"
                                        Content="长期"
                                        IsChecked="{Binding NewValue.IsLongTerm}" />
                                </DockPanel>
                            </DataTemplate>
                        </shared:ModifiableControl.EditTemplate>
                    </shared:ModifiableControl>

                    <shared:ModifiableControl
                        EditTemplate="{StaticResource DT.Text.Cap}"
                        Header="电话"
                        Modifier="{Binding Telephone}" />
                    <shared:ModifiableControl
                        EditTemplate="{StaticResource DT.Text.Cap}"
                        Header="传真"
                        Modifier="{Binding Fax}" />
                </StackPanel>

                <shared:ModifiableControl
                    MinWidth="300"
                    HorizontalContentAlignment="Stretch"
                    Header="官网"
                    Modifier="{Binding WebSite}" />

                <shared:ModifiableControl
                    HorizontalContentAlignment="Stretch"
                    Header="注册地址"
                    Modifier="{Binding RegisterAddress}" />
                <shared:ModifiableControl
                    HorizontalContentAlignment="Stretch"
                    Header="办公地址"
                    Modifier="{Binding OfficeAddress}" />
                <shared:ModifiableControl
                    HorizontalContentAlignment="Stretch"
                    Header="经营范围"
                    Modifier="{Binding BusinessScope}">
                    <shared:ModifiableControl.EditTemplate>
                        <DataTemplate>
                            <TextBox
                                MinHeight="100"
                                AcceptsReturn="True"
                                BorderThickness="0"
                                Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </shared:ModifiableControl.EditTemplate>
                </shared:ModifiableControl>
            </StackPanel>

            <StackPanel
                Margin="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
                <ToggleButton
                    hc:IconElement.Geometry="{StaticResource f.pencil}"
                    local:HelpService.Help="点击这里修改"
                    local:HelpService.Placement="Right"
                    BorderThickness="0"
                    DockPanel.Dock="Right"
                    IsChecked="{Binding IsReadOnly}"
                    Style="{StaticResource EditSwitch.Small}" />
            </StackPanel>
        </Grid>

        <GroupBox
            local:HelpService.Help="可以设置多个文件，保存历史证件"
            local:HelpService.Placement="Bottom"
            Background="WhiteSmoke"
            DockPanel.Dock="Top"
            Header="证件"
            Style="{StaticResource GroupBoxTab}"
            Visibility="{Binding ShowFileList, Converter={StaticResource Boolean2VisibilityConverter}}">
            <StackPanel>
                <StackPanel.Resources>
                    <Style BasedOn="{StaticResource MultiDualFileStyle}" TargetType="shared:FileView">
                        <Setter Property="IsReadOnly" Value="{Binding IsReadOnly}" />
                        <Setter Property="ContentTemplate" Value="{StaticResource MultiDualFile.Flip}" />
                        <Setter Property="Margin" Value="0,1" />
                    </Style>
                </StackPanel.Resources>
                <shared:FileView Content="{Binding BusinessLicense}" Header="营业执照正本" />
                <shared:FileView Content="{Binding BusinessLicense2}" Header="营业执照副本" />
                <shared:FileView Content="{Binding AccountOpeningLicense}" Header="开户许可证" />
                <shared:FileView Content="{Binding CharterDocument}" Header="章程/合伙协议" />
                <shared:FileView Content="{Binding LegalPersonIdCard}" Header="法人身份证" />
            </StackPanel>
        </GroupBox>

        <!--  股权结构  -->
        <StackPanel>
            <Border>
                <DockPanel LastChildFill="False">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        Text="股东" />

                    <TextBlock
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Foreground="Red"
                        Text="股东认缴和注册资本不一致"
                        Visibility="{Binding ShareNotPair, Converter={StaticResource Boolean2VisibilityConverter}}" />

                    <Button
                        hc:IconElement.Geometry="{StaticResource f.circle-plus}"
                        Command="{Binding AddShareHolderCommand}"
                        Foreground="Green"
                        Style="{StaticResource ButtonIcon}" />
                </DockPanel>
            </Border>

            <DataGrid
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding ShareRelations}"
                Style="{StaticResource DataGrid.NoSelect}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="姓名">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <shared:CopyableTextBlock shared:MaskService.IsMask="True" Text="{Binding Holder.Name}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseDoubleClick">
                                            <i:InvokeCommandAction Command="{Binding OpenEntityCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </shared:CopyableTextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="认缴金额">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <shared:CopyableTextBlock HorizontalAlignment="Right" Text="{Binding Share}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Binding="{Binding Ratio, StringFormat=P2}"
                        ElementStyle="{StaticResource RightAlignText}"
                        Header="占比" />

                    <!--  编辑/删除  -->
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="False">
                                    <Button
                                        hc:IconElement.Geometry="{StaticResource f.circle-minus}"
                                        Command="{Binding DataContext.RemoveShareHolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding .}"
                                        Foreground="Red"
                                        Style="{StaticResource ButtonIcon.Small}" />

                                    <Button
                                        hc:IconElement.Geometry="{StaticResource f.pen}"
                                        Command="{Binding DataContext.EditShareHolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource ButtonIcon.Small}" />
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DockPanel>
</Window>