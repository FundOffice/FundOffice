<Window
    x:Class="FMO.AddTokenProviderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加 AI 模型"
    Width="520"
    d:DataContext="{d:DesignInstance Type=local:AddTokenProviderWindowViewModel}"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="60" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <hc:UniformSpacingPanel
        Margin="12"
        Orientation="Vertical"
        VerticalSpacing="8">

        <!--  名称  -->
        <DockPanel>
            <TextBlock Style="{StaticResource LabelText}" Text="名称" />
            <hc:TextBox
                HorizontalAlignment="Stretch"
                hc:InfoElement.Placeholder="自定义名称"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
        </DockPanel>

        <!--  Provider 类型  -->
        <DockPanel>
            <TextBlock Style="{StaticResource LabelText}" Text="类型" />
            <ListBox
                HorizontalAlignment="Stretch"
                BorderThickness="0"
                ItemContainerStyle="{StaticResource ListBoxItem.AllaysFocus}"
                ItemsPanel="{StaticResource StackHorizontalItemsPanelTemplate}"
                ItemsSource="{Binding ProviderTypes}"
                SelectedItem="{Binding ProviderType}" />
        </DockPanel>

        <!--  URL  -->
        <DockPanel>
            <TextBlock Style="{StaticResource LabelText}" Text="URL" />
            <hc:TextBox
                HorizontalAlignment="Stretch"
                hc:InfoElement.Placeholder="API 基础地址（不含路径后缀）"
                Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
        </DockPanel>

        <!--  密钥 + 验证按钮  -->
        <DockPanel>
            <TextBlock Style="{StaticResource LabelText}" Text="密钥" />
            <Button
                Margin="4,0,0,0"
                Command="{Binding FetchModelsCommand}"
                Content="验证"
                DockPanel.Dock="Right"
                Style="{StaticResource ButtonPrimary}"
                Visibility="{Binding HasKey, Converter={StaticResource Boolean2VisibilityConverter}}" />
            <hc:TextBox
                HorizontalAlignment="Stretch"
                hc:InfoElement.Placeholder="API Key"
                Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
        </DockPanel>

        <!--  模型选择  -->
        <DockPanel Visibility="{Binding HasModels, Converter={StaticResource Boolean2VisibilityConverter}}">
            <TextBlock Style="{StaticResource LabelText}" Text="模型" />
            <ListBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </DockPanel>

        <!--  提示  -->
        <TextBlock
            Foreground="Red"
            Text="{Binding Tip}"
            Visibility="{Binding HasTip, Converter={StaticResource Boolean2VisibilityConverter}}" />

        <!--  按钮  -->
        <DockPanel Margin="0,8,0,0" LastChildFill="False">
            <Button
                Width="80"
                Command="{Binding CancelCommand}"
                Content="取消"
                DockPanel.Dock="Left" />
            <Button
                Width="80"
                Command="{Binding ConfirmCommand}"
                Content="确认"
                DockPanel.Dock="Right"
                Style="{StaticResource ButtonPrimary}" />
        </DockPanel>
    </hc:UniformSpacingPanel>
</Window>