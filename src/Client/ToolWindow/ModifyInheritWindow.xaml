<Window
    x:Class="FMO.ModifyInheritWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="继承关系"
    Width="800"
    Height="450"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <local:InheritDisplayConverter x:Key="InheritDisplayConverter" />
        <local:InheritVisibilityConverter x:Key="InheritVisibilityConverter" />
    </Window.Resources>

    <Border
        Background="WhiteSmoke"
        BorderThickness="2"
        CornerRadius="10">
        <DockPanel Margin="10">
            <DockPanel Margin="0,5" DockPanel.Dock="Top">
                <UniformGrid DockPanel.Dock="Right" Rows="1">
                    <Button
                        hc:IconElement.Geometry="{StaticResource f.circle-check}"
                        hc:IconElement.Height="14"
                        Command="{Binding ConfirmCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource ButtonDefault.Small}"
                        ToolTip="确认" />
                    <Button
                        hc:IconElement.Geometry="{StaticResource f.xmark}"
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Foreground="Red"
                        Style="{StaticResource ButtonDefault.Small}"
                        ToolTip="取消" />
                </UniformGrid>
                <TextBlock
                    Margin="10,0"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="调整基金份额继承关系" />
            </DockPanel>

            <ScrollViewer
                x:Name="MainScroller"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid x:Name="HostGrid">
                    <Canvas
                        x:Name="LinesCanvas"
                        Panel.ZIndex="10"
                        IsHitTestVisible="False" />

                    <ItemsControl Panel.ZIndex="1" ItemsSource="{Binding Data}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,10" Padding="10">
                                    <DockPanel>
                                        <DockPanel Margin="20,0" VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                DockPanel.Dock="Bottom"
                                                Text="{Binding Date, Mode=OneWay, StringFormat=yyyy/M/d}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Foreground="#495057"
                                                Text="{Binding FlowName, Mode=OneWay}" />
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding Shares}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="25,15,25,10">
                                                        <!--  上边缘点 (拖拽手柄)  -->
                                                        <Ellipse
                                                            x:Name="TopPoint"
                                                            Width="14"
                                                            Height="14"
                                                            Margin="0,-7,0,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Top"
                                                            Panel.ZIndex="2"
                                                            Cursor="Hand"
                                                            Fill="White"
                                                            Loaded="TopPoint_Loaded"
                                                            PreviewMouseLeftButtonDown="TopPoint_PreviewMouseLeftButtonDown"
                                                            PreviewMouseLeftButtonUp="TopPoint_PreviewMouseLeftButtonUp"
                                                            PreviewMouseMove="Window_PreviewMouseMove"
                                                            Stroke="#888"
                                                            StrokeThickness="2"
                                                            ToolTip="拖拽到 FlowId 更小的份额上以设置继承"
                                                            Unloaded="Point_Unloaded" />

                                                        <!--  卡片主体 (注册 MouseEnter/Leave)  -->
                                                        <Border
                                                            x:Name="CardBorder"
                                                            Margin="0,7,0,7"
                                                            Padding="15,12"
                                                            Background="White"
                                                            BorderBrush="#DDD"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Loaded="CardBorder_Loaded"
                                                            Unloaded="CardBorder_Unloaded">
                                                            <Grid>
                                                                <DockPanel VerticalAlignment="Center">
                                                                    <TextBlock
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="14"
                                                                        FontWeight="SemiBold"
                                                                        Text="{Binding Name}" />
                                                                    <StackPanel
                                                                        Margin="20,0,0,0"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center">
                                                                        <TextBlock
                                                                            Margin="0,2,0,0"
                                                                            HorizontalAlignment="Center"
                                                                            FontSize="11"
                                                                            Foreground="Gray"
                                                                            Text="{Binding Id, StringFormat='ID: {0}'}" />
                                                                        <TextBlock
                                                                            x:Name="desp"
                                                                            MaxWidth="150"
                                                                            Margin="0,8,0,0"
                                                                            HorizontalAlignment="Center"
                                                                            FontSize="11"
                                                                            Foreground="#0066CC"
                                                                            Text="{Binding Requirement}"
                                                                            TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </DockPanel>
                                                                <Button
                                                                    Width="18"
                                                                    Height="18"
                                                                    Margin="0,-8,-8,0"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Click="ClearInherit_Click"
                                                                    Content="✕"
                                                                    FontSize="10"
                                                                    FontWeight="Bold"
                                                                    Foreground="#999"
                                                                    Visibility="{Binding Inherit, Converter={StaticResource InheritVisibilityConverter}}" />
                                                            </Grid>
                                                        </Border>

                                                        <!--  下边缘点 (被继承锚点)  -->
                                                        <Ellipse
                                                            x:Name="BottomPoint"
                                                            Width="14"
                                                            Height="14"
                                                            Margin="0,0,0,-7"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Bottom"
                                                            Panel.ZIndex="2"
                                                            Fill="#E0E0E0"
                                                            IsHitTestVisible="False"
                                                            Loaded="BottomPoint_Loaded"
                                                            Stroke="#888"
                                                            StrokeThickness="2"
                                                            Unloaded="Point_Unloaded" />
                                                    </Grid>

                                                    <DataTemplate.Triggers>
                                                        <!--  ⚠️ 核心修改：移除 IsEnabled=False，改为只降低透明度，确保 MouseEnter 能正常触发  -->
                                                        <DataTrigger Binding="{Binding IsInherited}" Value="True">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Name}" Value="单一份额">
                                                            <Setter TargetName="desp" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>