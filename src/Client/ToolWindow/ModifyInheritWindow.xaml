<Window
    x:Class="FMO.ModifyInheritWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="继承关系"
    Width="800"
    Height="450"
    AllowsTransparency="True"
    Background="Transparent"
    DataContextChanged="Window_DataContextChanged"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <local:InheritDisplayConverter x:Key="InheritDisplayConverter" />
        <local:InheritVisibilityConverter x:Key="InheritVisibilityConverter" />
    </Window.Resources>

    <Border
        Background="WhiteSmoke"
        BorderThickness="2"
        CornerRadius="10">
        <DockPanel Margin="10">
            <DockPanel Margin="0,5" DockPanel.Dock="Top">
                <UniformGrid DockPanel.Dock="Right" Rows="1">
                    <Button
                        hc:IconElement.Geometry="{StaticResource f.circle-check}"
                        hc:IconElement.Height="14"
                        Command="{Binding ConfirmCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource ButtonDefault.Small}"
                        ToolTip="确认" />
                    <Button
                        hc:IconElement.Geometry="{StaticResource f.xmark}"
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Foreground="Red"
                        Style="{StaticResource ButtonDefault.Small}"
                        ToolTip="取消" />
                </UniformGrid>
                <TextBlock
                    Margin="10,0"
                    FontSize="14"
                    FontWeight="Bold"
                    Text="调整基金份额继承关系" />
            </DockPanel>

            <ScrollViewer
                x:Name="MainScroller"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid x:Name="HostGrid">
                    <Canvas
                        x:Name="LinesCanvas"
                        Panel.ZIndex="10"
                        IsHitTestVisible="False" />

                    <ItemsControl Panel.ZIndex="1" ItemsSource="{Binding Data}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    x:Name="border"
                                    Margin="0,10"
                                    Padding="10"
                                    BorderBrush="RoyalBlue"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    IsEnabled="{Binding IsEnabled}">
                                    <DockPanel>
                                        <DockPanel Margin="20,0" VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                DockPanel.Dock="Bottom"
                                                Text="{Binding Date, Mode=OneWay, StringFormat=yyyy/M/d}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Foreground="#495057"
                                                Text="{Binding FlowName, Mode=OneWay}" />
                                        </DockPanel>

                                        <ItemsControl ItemsSource="{Binding Shares}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <hc:SimplePanel>
                                                        <hc:SimplePanel Name="card" Margin="25,15,25,10">
                                                            <!--  上边缘点 (拖拽手柄)  -->
                                                            <Ellipse
                                                                x:Name="TopPoint"
                                                                Width="14"
                                                                Height="14"
                                                                Margin="0,-7,0,0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Top"
                                                                Panel.ZIndex="2"
                                                                Cursor="Hand"
                                                                Fill="White"
                                                                Loaded="TopPoint_Loaded"
                                                                PreviewMouseLeftButtonDown="TopPoint_PreviewMouseLeftButtonDown"
                                                                PreviewMouseLeftButtonUp="TopPoint_PreviewMouseLeftButtonUp"
                                                                PreviewMouseMove="Window_PreviewMouseMove"
                                                                Stroke="#888"
                                                                StrokeThickness="2"
                                                                ToolTip="拖拽到 FlowId 更小的份额上以设置继承"
                                                                Unloaded="Point_Unloaded" />

                                                            <!--  卡片主体 (注册 MouseEnter/Leave)  -->
                                                            <Border
                                                                x:Name="CardBorder"
                                                                Margin="0,7,0,7"
                                                                Padding="15,12"
                                                                Background="White"
                                                                BorderBrush="#DDD"
                                                                BorderThickness="2"
                                                                CornerRadius="8"
                                                                Loaded="CardBorder_Loaded"
                                                                Unloaded="CardBorder_Unloaded">
                                                                <Grid>
                                                                    <DockPanel VerticalAlignment="Center">
                                                                        <TextBlock
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="14"
                                                                            FontWeight="SemiBold"
                                                                            Text="{Binding Name}" />
                                                                        <StackPanel
                                                                            Margin="20,0,0,0"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center">
                                                                            <TextBlock
                                                                                Margin="0,2,0,0"
                                                                                HorizontalAlignment="Center"
                                                                                FontSize="11"
                                                                                Foreground="Gray"
                                                                                Text="{Binding Id, StringFormat='ID: {0}'}" />
                                                                            <TextBlock
                                                                                x:Name="desp"
                                                                                MaxWidth="150"
                                                                                Margin="0,8,0,0"
                                                                                HorizontalAlignment="Center"
                                                                                FontSize="11"
                                                                                Foreground="#0066CC"
                                                                                Text="{Binding Requirement}"
                                                                                TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                    <Button
                                                                        Width="18"
                                                                        Height="18"
                                                                        Margin="0,-8,-8,0"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Click="ClearInherit_Click"
                                                                        Content="✕"
                                                                        FontSize="10"
                                                                        FontWeight="Bold"
                                                                        Foreground="#999"
                                                                        Visibility="{Binding Inherit, Converter={StaticResource InheritVisibilityConverter}}" />

                                                                </Grid>
                                                            </Border>

                                                            <!--  下边缘点 (被继承锚点)  -->
                                                            <Ellipse
                                                                x:Name="BottomPoint"
                                                                Width="14"
                                                                Height="14"
                                                                Margin="0,0,0,-7"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Bottom"
                                                                Panel.ZIndex="2"
                                                                Fill="#E0E0E0"
                                                                IsHitTestVisible="False"
                                                                Loaded="BottomPoint_Loaded"
                                                                Stroke="#888"
                                                                StrokeThickness="2"
                                                                Unloaded="Point_Unloaded" />
                                                        </hc:SimplePanel>

                                                        <DockPanel
                                                            Margin="0,15,25,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Visibility="{Binding DataContext.IsEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Boolean2VisibilityConverter}}">

                                                            <Button
                                                                Padding="2,0"
                                                                hc:IconElement.Geometry="{StaticResource f.knife}"
                                                                Command="{Binding DataContext.SplitCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding .}"
                                                                Style="{StaticResource ButtonIcon.Small}" />
                                                            <Button
                                                                Padding="2,0"
                                                                hc:IconElement.Geometry="{StaticResource f.xmark}"
                                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding .}"
                                                                Foreground="Red"
                                                                Style="{StaticResource ButtonIcon.Small}" />
                                                        </DockPanel>

                                                        <hc:SimplePanel
                                                            Margin="25,15"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Visibility="{Binding DataContext.IsEnabled, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                            <Button
                                                                Padding="2,0"
                                                                hc:IconElement.Geometry="{StaticResource f.copy}"
                                                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding .}"
                                                                Style="{StaticResource ButtonIcon.Small}"
                                                                Visibility="{Binding IsInherited, Converter={StaticResource Boolean2VisibilityConverter}}" />

                                                            <ToggleButton
                                                                x:Name="tog"
                                                                hc:IconElement.Geometry="{StaticResource f.pencil}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Style="{StaticResource ToggleButtonIcon.Small}"
                                                                Visibility="Collapsed" />
                                                        </hc:SimplePanel>

                                                        <Popup
                                                            AllowsTransparency="True"
                                                            HorizontalOffset="-100"
                                                            IsOpen="{Binding ElementName=tog, Path=IsChecked}"
                                                            PlacementTarget="{Binding ElementName=tog}"
                                                            StaysOpen="False">
                                                            <Border
                                                                Background="White"
                                                                BorderBrush="RoyalBlue"
                                                                BorderThickness="3"
                                                                CornerRadius="4">
                                                                <StackPanel Width="300" Margin="8">

                                                                    <DockPanel>
                                                                        <TextBlock
                                                                            Margin="5,0"
                                                                            VerticalAlignment="Center"
                                                                            Text="份额名称" />
                                                                        <TextBox
                                                                            x:Name="tb"
                                                                            MinWidth="70"
                                                                            HorizontalContentAlignment="Center"
                                                                            Style="{StaticResource TextBox.Small}"
                                                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=300}" />

                                                                        <TextBlock
                                                                            Margin="5,0"
                                                                            VerticalAlignment="Center"
                                                                            Text="托管产品编码" />
                                                                        <hc:TextBox
                                                                            Width="90"
                                                                            hc:InfoElement.Placeholder="托管产品编码"
                                                                            Text="{Binding Code, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                                            TextAlignment="Center" />
                                                                    </DockPanel>

                                                                    <hc:TextBox
                                                                        Margin="0,5"
                                                                        hc:InfoElement.Placeholder="子份额产品名称"
                                                                        Text="{Binding FundName, UpdateSourceTrigger=PropertyChanged, Delay=300}" />

                                                                    <DockPanel Margin="0,5">
                                                                        <TextBlock
                                                                            x:Name="t2"
                                                                            Margin="5,0"
                                                                            VerticalAlignment="Center"
                                                                            Text="要求" />
                                                                        <hc:TextBox
                                                                            x:Name="t3"
                                                                            Padding="4"
                                                                            HorizontalAlignment="Stretch"
                                                                            hc:InfoElement.Placeholder="份额对应的要求"
                                                                            Text="{Binding Requirement, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                                                            TextWrapping="Wrap" />
                                                                    </DockPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                    </hc:SimplePanel>

                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsInherited}" Value="True">
                                                            <Setter TargetName="card" Property="Opacity" Value="0.5" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Name}" Value="单一份额">
                                                            <Setter TargetName="desp" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsInherited}" Value="False" />
                                                                <Condition Binding="{Binding DataContext.HasMultipleShare, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="tog" Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter TargetName="border" Property="Opacity" Value="0.5" />
                                        <Setter TargetName="border" Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>