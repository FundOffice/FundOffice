<UserControl
    x:Class="FMO.ManagerMemberView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:FMO.Shared;assembly=SharedUI"
    d:DataContext="{d:DesignInstance Type=local:ManagerMemberView}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style BasedOn="{StaticResource {x:Type shared:ChangeableControl}}" TargetType="shared:ChangeableControl">
            <Setter Property="Entity" Value="{Binding .}" />
            <Setter Property="IsReadOnly" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock
                            Width="60"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Text="{Binding}"
                            TextAlignment="Right" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel>

        <shared:ModifiableControl
            Width="120"
            VerticalAlignment="Top"
            DockPanel.Dock="Right"
            Header="角色"
            Modifier="{Binding Role}"
            Style="{StaticResource Modifiable.Vertical}">
            <shared:ModifiableControl.EditTemplate>
                <DataTemplate>
                    <ListBox
                        FontSize="9"
                        ItemsSource="{Binding DataContext.Roles, RelativeSource={RelativeSource AncestorType=local:ManagerMemberView}}"
                        SelectionMode="Multiple"
                        Style="{StaticResource ListBox.Small}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Role}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListBoxItem.AllaysFocus}" TargetType="ListBoxItem">
                                <Setter Property="IsSelected" Value="{Binding IsSelected}" />
                                <Setter Property="FontSize" Value="10" />
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="MinHeight" Value="24" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DataTemplate>
            </shared:ModifiableControl.EditTemplate>
        </shared:ModifiableControl>


        <StackPanel>
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Width" Value="60" />
                </Style>
            </StackPanel.Resources>

            <shared:ModifiableControl Header="姓名" Modifier="{Binding Name}" />

            <shared:ModifiableControl Header="证件类型" Modifier="{Binding IdType}">
                <shared:ModifiableControl.EditTemplate>
                    <DataTemplate>
                        <ComboBox
                            MinWidth="100"
                            BorderThickness="0"
                            ItemsSource="{x:Static local:ManagerMemberViewModel.IDTypes}"
                            SelectedItem="{Binding NewValue}" />
                    </DataTemplate>
                </shared:ModifiableControl.EditTemplate>
            </shared:ModifiableControl>

            <shared:ModifiableControl Header="证件号码" Modifier="{Binding IdNumber}">
                <shared:ModifiableControl.ContentTemplate>
                    <DataTemplate>
                        <shared:CopyableTextBlock IsMasked="True" Text="{Binding OldValue}" />
                    </DataTemplate>
                </shared:ModifiableControl.ContentTemplate>
            </shared:ModifiableControl>

            <shared:ModifiableControl Header="有效期" Modifier="{Binding Efficient}">
                <shared:ModifiableControl.EditTemplate>
                    <DataTemplate>
                        <DockPanel DataContext="{Binding NewValue}">
                            <DatePicker
                                MinWidth="100"
                                BorderThickness="0"
                                SelectedDate="{Binding Begin, Converter={StaticResource DataTimeDateOnlySwitchConverter}}" />
                            <DockPanel Visibility="{Binding IsLongTerm, Converter={StaticResource Boolean2VisibilityReConverter}}">
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Text="-" />
                                <DatePicker
                                    MinWidth="100"
                                    BorderThickness="0"
                                    SelectedDate="{Binding End, Converter={StaticResource DataTimeDateOnlySwitchConverter}}" />
                            </DockPanel>
                            <CheckBox
                                Margin="5,0"
                                Content="长期"
                                IsChecked="{Binding IsLongTerm}" />
                        </DockPanel>
                    </DataTemplate>
                </shared:ModifiableControl.EditTemplate>
            </shared:ModifiableControl>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <shared:ModifiableControl Header="电话" Modifier="{Binding Phone}" />
                <shared:ModifiableControl
                    Grid.Column="1"
                    Header="Email"
                    Modifier="{Binding Email}" />
            </Grid>
            <shared:ModifiableControl Header="地址" Modifier="{Binding Address}" />
            <shared:ModifiableControl Header="简介" Modifier="{Binding Profile}">
                <shared:ModifiableControl.EditTemplate>
                    <DataTemplate>
                        <TextBox
                            MinHeight="60"
                            Padding="6"
                            AcceptsReturn="True"
                            BorderThickness="0"
                            Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </shared:ModifiableControl.EditTemplate>
            </shared:ModifiableControl>
        </StackPanel>
    </DockPanel>
</UserControl>
