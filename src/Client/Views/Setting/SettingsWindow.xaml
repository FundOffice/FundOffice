<Window
    x:Class="FMO.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="设置"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance Type=local:SettingsWindowViewModel}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <DataTemplate x:Key="chapter">
            <Border BorderBrush="RoyalBlue" BorderThickness="0,0,0,1">
                <Border HorizontalAlignment="Left" Background="RoyalBlue">
                    <TextBlock
                        Margin="8,4"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Text="{Binding}" />
                </Border>
            </Border>
        </DataTemplate>


        <DataTemplate DataType="{x:Type local:SettingMonitorGroup}">
            <Border
                Margin="0,2"
                BorderBrush="Orange"
                BorderThickness="1">
                <DockPanel>
                    <Border Background="Orange">
                        <TextBlock
                            Width="14"
                            Margin="6,2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="{Binding Name}"
                            TextWrapping="Wrap" />
                    </Border>
                    <ListBox
                        BorderThickness="0"
                        ItemsSource="{Binding Units}"
                        Style="{StaticResource ListBoxCustom}" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer>

        <StackPanel Margin="5">
            <ContentControl Content="基础设置" ContentTemplate="{StaticResource chapter}" />


            <ListBox
                BorderThickness="0"
                ItemsSource="{Binding BasicGroups}"
                Style="{StaticResource ListBoxCustom}" />



            <ContentControl Content="订单设置" ContentTemplate="{StaticResource chapter}" />
            <ListBox
                BorderThickness="0"
                ItemsSource="{Binding OrderSection}"
                Style="{StaticResource ListBoxCustom}" />


            <ContentControl
                Margin="0,20,0,0"
                Content="数据监控"
                ContentTemplate="{StaticResource chapter}" />



            <ListBox
                BorderThickness="0"
                ItemsSource="{Binding MonitorGroups}"
                Style="{StaticResource ListBoxCustom}" />


        </StackPanel>
    </ScrollViewer>
</Window>
