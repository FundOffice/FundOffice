<Window
    x:Class="FMO.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="设置"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance Type=local:SettingsWindowViewModel}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <DockPanel>
        <!--<GroupBox Header="消息通道">
            <TextBlock />
        </GroupBox>-->

        <StackPanel>
            <!--<CheckBox Content="新订单" />
            <CheckBox Content="巨额赎回" />-->


            <GroupBox Header="数据监控">
                <ListBox ItemsSource="{Binding VerifyRuleUnits}" Style="{StaticResource ListBoxCustom}" />
            </GroupBox>
        </StackPanel>
    </DockPanel>
</Window>
