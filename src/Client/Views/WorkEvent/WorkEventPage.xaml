<UserControl
    x:Class="FMO.WorkEventPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:FMO.Shared;assembly=SharedUI"
    d:DesignHeight="450"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <local:WorkEventPageViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <DataTemplate x:Key="WorkEventItemTemplate" DataType="local:WorkEventViewModel">
            <Border
                x:Name="RootBorder"
                Width="260"
                Margin="4"
                Background="White"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="5">
                <hc:SimplePanel>
                    <StackPanel Margin="10">
                        <DockPanel>
                            <TextBlock
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <DockPanel Margin="0,4,0,0">
                            <Border
                                x:Name="StatusBorder"
                                Padding="4,1"
                                CornerRadius="3"
                                DockPanel.Dock="Left">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="White"
                                    Text="{Binding StatusDisplay}" />
                            </Border>
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="Gray"
                                Text="{Binding TypeDisplay}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="Gray"
                                Text="{Binding CreateTime, StringFormat=yyyy/MM/dd HH:mm}" />
                        </DockPanel>

                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="DimGray"
                            Text="{Binding Description}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding Description, Converter={StaticResource ValueIsEffectToVisibilityConverter}}" />

                        <ItemsControl
                            Margin="0,6,0,0"
                            ItemsSource="{Binding Tags}"
                            Visibility="{Binding Tags, Converter={StaticResource ValueIsEffectToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <hc:Tag
                                        Margin="2,0,4,2"
                                        Content="{Binding}"
                                        ShowCloseButton="False" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,2,0,0" Visibility="{Binding LinkName, Converter={StaticResource ValueIsEffectToVisibilityConverter}}">
                            <TextBlock
                                FontSize="11"
                                Foreground="Gray"
                                Text="关联：" />
                            <TextBlock FontSize="11" Text="{Binding LinkName}" />
                        </DockPanel>

                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="OrangeRed"
                            Text="{Binding DueTime, StringFormat=截止：{0:yyyy/MM/dd HH:mm}}"
                            Visibility="{Binding DueTime, Converter={StaticResource ValueIsEffectToVisibilityConverter}}" />
                    </StackPanel>

                    <DockPanel
                        x:Name="DeletePanel"
                        Margin="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        LastChildFill="False"
                        Visibility="Collapsed">
                        <ToggleButton
                            x:Name="ConfirmToggle"
                            Content="删除"
                            Style="{StaticResource ToggleButtonDanger.Small}"
                            Visibility="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                        <DockPanel Visibility="{Binding ElementName=ConfirmToggle, Path=IsChecked, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <Button
                                Width="18"
                                Margin="0"
                                Padding="0"
                                hc:IconElement.Geometry="{StaticResource f.check}"
                                Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=local:WorkEventPage}}"
                                CommandParameter="{Binding .}"
                                Foreground="Red"
                                Style="{StaticResource ButtonIcon.Small}" />
                            <ToggleButton
                                x:Name="CancelToggle"
                                hc:IconElement.Geometry="{StaticResource f.x}"
                                Background="Transparent"
                                BorderThickness="0"
                                Style="{StaticResource ToggleButtonIcon.Small}" />
                        </DockPanel>
                    </DockPanel>
                </hc:SimplePanel>

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Gray" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="RoyalBlue" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="6"
                                            Opacity="0.3"
                                            ShadowDepth="2" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="DeletePanel" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger SourceName="CancelToggle" Property="IsChecked" Value="True">
                    <Setter TargetName="ConfirmToggle" Property="IsChecked" Value="False" />
                    <Setter TargetName="CancelToggle" Property="IsChecked" Value="False" />
                </Trigger>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter TargetName="StatusBorder" Property="Background" Value="Gray" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                    <Setter TargetName="StatusBorder" Property="Background" Value="RoyalBlue" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter TargetName="StatusBorder" Property="Background" Value="Green" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter TargetName="StatusBorder" Property="Background" Value="DarkGray" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="RootBorder" Property="BorderBrush" Value="RoyalBlue" />
                    <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                    <Setter TargetName="RootBorder" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect
                                BlurRadius="8"
                                Opacity="0.4"
                                ShadowDepth="2" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:AccountOpeningWorkEventViewModel}">
            <StackPanel>
                <hc:Divider Content="开户信息" />
                <hc:ComboBox
                    hc:InfoElement.Title="账户类型"
                    hc:InfoElement.TitlePlacement="Top"
                    DisplayMemberPath="Value"
                    ItemsSource="{Binding AccountType, Converter={StaticResource EnumToComboBoxItemsConverter}}"
                    SelectedValue="{Binding AccountType}"
                    SelectedValuePath="Key" />
                <DatePicker
                    hc:InfoElement.Title="开户日期"
                    hc:InfoElement.TitlePlacement="Top"
                    SelectedDate="{Binding OpenDate}" />
                <TextBox
                    hc:InfoElement.Title="开户机构"
                    hc:InfoElement.TitlePlacement="Top"
                    Text="{Binding Institution}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:DueDiligenceWorkEventViewModel}">
            <StackPanel>
                <hc:Divider Content="尽调信息" />
                <hc:ComboBox
                    hc:InfoElement.Title="尽调类型"
                    hc:InfoElement.TitlePlacement="Top"
                    DisplayMemberPath="Value"
                    ItemsSource="{Binding DueDiligenceType, Converter={StaticResource EnumToComboBoxItemsConverter}}"
                    SelectedValue="{Binding DueDiligenceType}"
                    SelectedValuePath="Key" />
                <TextBox
                    hc:InfoElement.Title="尽调对象"
                    hc:InfoElement.TitlePlacement="Top"
                    Text="{Binding Target}" />
                <TextBox
                    MinHeight="80"
                    hc:InfoElement.Title="尽调结果"
                    hc:InfoElement.TitlePlacement="Top"
                    Text="{Binding Result}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ManagerAffairsWorkEventViewModel}">
            <StackPanel>
                <hc:Divider Content="管理人事务" />
                <hc:ComboBox
                    hc:InfoElement.Title="事务类型"
                    hc:InfoElement.TitlePlacement="Top"
                    DisplayMemberPath="Value"
                    ItemsSource="{Binding AffairsType, Converter={StaticResource EnumToComboBoxItemsConverter}}"
                    SelectedValue="{Binding AffairsType}"
                    SelectedValuePath="Key" />
                <TextBox
                    hc:InfoElement.Title="处理人"
                    hc:InfoElement.TitlePlacement="Top"
                    Text="{Binding Handler}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:AccountInfoChangeWorkEventViewModel}">
            <StackPanel>
                <hc:Divider Content="变更信息" />
                <hc:ComboBox
                    hc:InfoElement.Title="变更类型"
                    hc:InfoElement.TitlePlacement="Top"
                    DisplayMemberPath="Value"
                    ItemsSource="{Binding ChangeType, Converter={StaticResource EnumToComboBoxItemsConverter}}"
                    SelectedValue="{Binding ChangeType}"
                    SelectedValuePath="Key" />
                <TextBox
                    hc:InfoElement.Title="原始值"
                    hc:InfoElement.TitlePlacement="Top"
                    Text="{Binding OriginalValue}" />
                <TextBox
                    hc:InfoElement.Title="新值"
                    hc:InfoElement.TitlePlacement="Top"
                    Text="{Binding NewValue}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:CustomWorkEventViewModel}">
            <StackPanel>
                <hc:Divider Content="自定义" />
                <TextBox
                    hc:InfoElement.Title="分类"
                    hc:InfoElement.TitlePlacement="Top"
                    Text="{Binding Category}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,8"
            Padding="8"
            Background="WhiteSmoke"
            CornerRadius="5">
            <hc:UniformSpacingPanel
                VerticalAlignment="Center"
                HorizontalSpacing="8"
                Orientation="Horizontal">
                <DatePicker
                    Width="120"
                    hc:InfoElement.Placeholder="开始时间"
                    hc:InfoElement.Title="开始"
                    hc:InfoElement.TitlePlacement="Left"
                    SelectedDate="{Binding StartTime}" />

                <DatePicker
                    Width="120"
                    hc:InfoElement.Placeholder="结束时间"
                    hc:InfoElement.Title="结束"
                    hc:InfoElement.TitlePlacement="Left"
                    SelectedDate="{Binding EndTime}" />

                <hc:ComboBox
                    Width="100"
                    hc:InfoElement.Placeholder="全部标签"
                    hc:InfoElement.Title="标签"
                    hc:InfoElement.TitlePlacement="Left"
                    DisplayMemberPath="."
                    ItemsSource="{Binding AllTags}"
                    SelectedItem="{Binding SelectedTag}" />

                <hc:ComboBox
                    Width="140"
                    hc:InfoElement.Placeholder="全部关联"
                    hc:InfoElement.Title="关联"
                    hc:InfoElement.TitlePlacement="Left"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding AllLinks}"
                    SelectedItem="{Binding SelectedLink}" />

                <hc:ComboBox
                    hc:InfoElement.Placeholder="全部状态"
                    hc:InfoElement.Title="状态"
                    hc:InfoElement.TitlePlacement="Left"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding StatusOptions}"
                    SelectedItem="{Binding SelectedStatus}" />

                <hc:TextBox
                    Width="220"
                    hc:InfoElement.Placeholder="搜索标题、描述、关联"
                    hc:InfoElement.Title="关键词"
                    hc:InfoElement.TitlePlacement="Left"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Command="{Binding ClearFilterCommand}"
                    Content="清空"
                    Style="{StaticResource ButtonDefault}" />

                <Button
                    Command="{Binding RefreshCommand}"
                    Content="刷新"
                    Style="{StaticResource ButtonDefault}" />

                <Border
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="5">
                    <hc:UniformSpacingPanel Spacing="5">
                        <Button Command="{Binding AddAccountOpeningEventCommand}" Content="开户" />
                        <Button Command="{Binding AddAccountInfoChangeEventCommand}" Content="变更" />
                        <Button Command="{Binding AddAccountCancellationEventCommand}" Content="销户" />
                    </hc:UniformSpacingPanel>
                </Border>


                <Button Command="{Binding AddDueDiligenceEventCommand}" Content="尽调" />


                <Button Command="{Binding AddSelfInspectionEventCommand}" Content="自查" />


                <Button Command="{Binding AddManagerAffairsEventCommand}" Content="管理人变更" />




                <Button Command="{Binding AddEventCommand}" Content="其它" />
            </hc:UniformSpacingPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="0">
            <hc:UniformSpacingPanel
                Margin="8"
                ChildWrapping="Wrap"
                HorizontalSpacing="8"
                Orientation="Horizontal"
                VerticalSpacing="8">
                <ListBox
                    BorderThickness="0"
                    ItemTemplate="{StaticResource WorkEventItemTemplate}"
                    ItemsSource="{Binding EventSource.View}"
                    SelectedItem="{Binding SelectedEvent}"
                    Style="{StaticResource ListBoxCustom}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <hc:UniformSpacingPanel
                                ChildWrapping="Wrap"
                                HorizontalSpacing="8"
                                IsItemsHost="True"
                                VerticalSpacing="8" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </hc:UniformSpacingPanel>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="8"
            Padding="12"
            Background="WhiteSmoke"
            BorderBrush="LightGray"
            BorderThickness="1,0,0,1"
            CornerRadius="5"
            Visibility="{Binding SelectedEvent, Converter={StaticResource Object2VisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <hc:Divider Margin="0" Content="基本信息" />
                    <hc:SimplePanel Margin="0,4" />

                    <StackPanel IsEnabled="{Binding IsDetailEnabled}">
                        <DockPanel>

                            <Button
                                Margin="5,0,0,0"
                                VerticalAlignment="Stretch"
                                Command="{Binding SelectedEvent.SaveCommand}"
                                Content="保存"
                                DockPanel.Dock="Right"
                                Style="{StaticResource ButtonPrimary}" />

                            <hc:TextBox
                                Margin="0,4"
                                hc:InfoElement.Placeholder="输入工作事项标题"
                                hc:InfoElement.Title="标题"
                                hc:InfoElement.TitlePlacement="Left"
                                Text="{Binding SelectedEvent.Title}" />
                        </DockPanel>

                        <hc:ComboBox
                            Margin="0,4"
                            hc:InfoElement.Placeholder="请选择当前处理状态"
                            hc:InfoElement.Title="状态"
                            hc:InfoElement.TitlePlacement="Left"
                            DisplayMemberPath="Value"
                            ItemsSource="{Binding SelectedEvent.Status, Converter={StaticResource EnumToComboBoxItemsConverter}}"
                            SelectedValue="{Binding SelectedEvent.Status}"
                            SelectedValuePath="Key" />

                        <hc:TextBox
                            x:Name="TagInput"
                            Margin="0,4"
                            hc:InfoElement.Placeholder="输入标签后回车添加"
                            hc:InfoElement.Title="标签"
                            hc:InfoElement.TitlePlacement="Left"
                            PreviewKeyDown="TagInput_PreviewKeyDown"
                            Text="{Binding SelectedEvent.NewTagInput, UpdateSourceTrigger=PropertyChanged}" />

                        <ItemsControl Margin="0,4" ItemsSource="{Binding SelectedEvent.Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <hc:Tag
                                        Margin="2"
                                        Content="{Binding}"
                                        ShowCloseButton="True">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="Closed">
                                                <i:InvokeCommandAction Command="{Binding DataContext.SelectedEvent.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </hc:Tag>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>


                        <hc:DatePicker
                            Margin="0,4"
                            hc:InfoElement.Placeholder="请选择截止时间（可选）"
                            hc:InfoElement.Title="截止时间"
                            hc:InfoElement.TitlePlacement="Left"
                            SelectedDate="{Binding SelectedEvent.DueTime}" />


                        <hc:TextBox
                            MinHeight="80"
                            Margin="0,4"
                            hc:InfoElement.Placeholder="填写事项详细描述"
                            hc:InfoElement.Title="详细描述"
                            hc:InfoElement.TitlePlacement="Top"
                            AcceptsReturn="True"
                            Text="{Binding SelectedEvent.Description}"
                            TextWrapping="Wrap" />




                        <hc:Divider Margin="0,10" Content="关联对象" />

                        <hc:UniformSpacingPanel
                            Margin="0,4"
                            VerticalAlignment="Center"
                            HorizontalSpacing="8"
                            Orientation="Horizontal">
                            <CheckBox Content="管理人" IsChecked="{Binding SelectedEvent.IsManagerLinked}" />

                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <CheckBox Content="基金" IsChecked="{Binding SelectedEvent.IsFundLinked}" />
                                <Button
                                    x:Name="FundSelectorBtn"
                                    Margin="4,0,0,0"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenFundPopupCommand}"
                                    Content="{Binding FundButtonText}"
                                    Style="{StaticResource ButtonDefault.Small}"
                                    ToolTip="{Binding FundButtonTooltip}"
                                    Visibility="{Binding SelectedEvent.IsFundLinked, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                <Popup
                                    AllowsTransparency="True"
                                    IsOpen="{Binding IsFundPopupOpen, Mode=TwoWay}"
                                    Placement="Left"
                                    PlacementTarget="{Binding ElementName=FundSelectorBtn}"
                                    StaysOpen="False">
                                    <Border
                                        MinWidth="360"
                                        Padding="8"
                                        Background="White"
                                        BorderBrush="LightGray"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <StackPanel>
                                            <TextBox
                                                Margin="0,0,0,4"
                                                hc:InfoElement.Placeholder="输入基金代码或名称快速筛选"
                                                hc:InfoElement.ShowClearButton="True"
                                                Text="{Binding FundFilterText, UpdateSourceTrigger=PropertyChanged}" />
                                            <ListBox
                                                MaxHeight="240"
                                                BorderThickness="0"
                                                ItemsSource="{Binding FundSource.View}"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="local:SelectableFund">
                                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>

                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding SelectedEvent.IsFundLinked, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <CheckBox Content="账户" IsChecked="{Binding SelectedEvent.IsAccountLinked}" />
                                <Button
                                    x:Name="AccountSelectorBtn"
                                    Margin="4,0,0,0"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenAccountPopupCommand}"
                                    Content="{Binding AccountButtonText}"
                                    Style="{StaticResource ButtonDefault.Small}"
                                    ToolTip="{Binding AccountButtonTooltip}"
                                    Visibility="{Binding SelectedEvent.IsAccountLinked, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                <Popup
                                    AllowsTransparency="True"
                                    IsOpen="{Binding IsAccountPopupOpen, Mode=TwoWay}"
                                    Placement="Left"
                                    PlacementTarget="{Binding ElementName=AccountSelectorBtn}"
                                    StaysOpen="False">
                                    <Border
                                        MinWidth="360"
                                        Padding="8"
                                        Background="White"
                                        BorderBrush="LightGray"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,4"
                                                FontSize="12"
                                                Foreground="Gray"
                                                Text="选择已选基金的交易账户（可多选）：" />
                                            <ListBox
                                                MaxHeight="240"
                                                BorderThickness="0"
                                                ItemsSource="{Binding FilteredAccounts}"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="local:SelectableAccount">
                                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </hc:UniformSpacingPanel>

                        <hc:Divider Margin="0,10" Content="附件" />

                        <UniformGrid
                            Margin="4"
                            VerticalAlignment="Center"
                            Rows="1">
                            <Border
                                x:Name="OriginalDropZone"
                                MinWidth="130"
                                Margin="5,0"
                                Padding="12,6"
                                AllowDrop="True"
                                Background="#F0F8FF"
                                BorderBrush="LightBlue"
                                BorderThickness="1"
                                CornerRadius="3"
                                Drop="OriginalDrop">
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding OpenOriginalFolderCommand}"
                                    Content="📁 原始文件"
                                    Cursor="Hand" />
                            </Border>

                            <Border
                                x:Name="SealDropZone"
                                MinWidth="130"
                                Margin="5,0"
                                Padding="12,6"
                                AllowDrop="True"
                                Background="#FFF8F0"
                                BorderBrush="Orange"
                                BorderThickness="1"
                                CornerRadius="3"
                                Drop="SealDrop">
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding OpenSealFolderCommand}"
                                    Content="📁 用印文件"
                                    Cursor="Hand" />
                            </Border>
                        </UniformGrid>

                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="Gray"
                            Text="提示：点击按钮打开文件夹；或将文件拖拽到对应区域保存，同名文件自动重命名。" />

                        <ContentControl Margin="0,10" Content="{Binding SelectedEvent}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
