<UserControl
    x:Class="FMO.WorkEventPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:FMO.Shared;assembly=SharedUI"
    d:DesignHeight="450"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <local:WorkEventPageViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <DataTemplate x:Key="WorkEventItemTemplate" DataType="local:WorkEventViewModel">
            <Border
                x:Name="RootBorder"
                Width="260"
                Margin="4"
                Background="White"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="5">
                <hc:SimplePanel>
                    <StackPanel Margin="10">
                        <DockPanel>
                            <TextBlock
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis" />
                        </DockPanel>

                        <DockPanel Margin="0,4,0,0">
                            <Border
                                x:Name="StatusBorder"
                                Padding="4,1"
                                CornerRadius="3"
                                DockPanel.Dock="Left">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="White"
                                    Text="{Binding StatusDisplay}" />
                            </Border>
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="Gray"
                                Text="{Binding TypeDisplay}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="Gray"
                                Text="{Binding CreateTime, StringFormat=yyyy/MM/dd HH:mm}" />
                        </DockPanel>

                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="DimGray"
                            Text="{Binding Description}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding Description, Converter={StaticResource ValueIsEffectToVisibilityConverter}}" />

                        <DockPanel Margin="0,6,0,0" Visibility="{Binding TagDisplay, Converter={StaticResource ValueIsEffectToVisibilityConverter}}">
                            <TextBlock
                                FontSize="11"
                                Foreground="Gray"
                                Text="标签：" />
                            <TextBlock
                                FontSize="11"
                                Foreground="RoyalBlue"
                                Text="{Binding TagDisplay}" />
                        </DockPanel>

                        <DockPanel Margin="0,2,0,0" Visibility="{Binding LinkName, Converter={StaticResource ValueIsEffectToVisibilityConverter}}">
                            <TextBlock
                                FontSize="11"
                                Foreground="Gray"
                                Text="关联：" />
                            <TextBlock FontSize="11" Text="{Binding LinkName}" />
                        </DockPanel>

                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="OrangeRed"
                            Text="{Binding DueTime, StringFormat=截止：{0:yyyy/MM/dd HH:mm}}"
                            Visibility="{Binding DueTime, Converter={StaticResource ValueIsEffectToVisibilityConverter}}" />
                    </StackPanel>

                    <DockPanel
                        x:Name="DeletePanel"
                        Margin="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        LastChildFill="False"
                        Visibility="Collapsed">
                        <ToggleButton
                            x:Name="ConfirmToggle"
                            Content="删除"
                            Style="{StaticResource ToggleButtonDanger.Small}"
                            Visibility="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                        <DockPanel Visibility="{Binding ElementName=ConfirmToggle, Path=IsChecked, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <Button
                                Width="18"
                                Margin="0"
                                Padding="0"
                                hc:IconElement.Geometry="{StaticResource f.check}"
                                Command="{Binding DataContext.DeleteEventCommand, RelativeSource={RelativeSource AncestorType=local:WorkEventPage}}"
                                CommandParameter="{Binding .}"
                                Foreground="Red"
                                Style="{StaticResource ButtonIcon.Small}" />
                            <ToggleButton
                                x:Name="CancelToggle"
                                hc:IconElement.Geometry="{StaticResource f.x}"
                                Background="Transparent"
                                BorderThickness="0"
                                Style="{StaticResource ToggleButtonIcon.Small}" />
                        </DockPanel>
                    </DockPanel>
                </hc:SimplePanel>

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="Gray" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="RoyalBlue" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="6"
                                            Opacity="0.3"
                                            ShadowDepth="2" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="DeletePanel" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger SourceName="CancelToggle" Property="IsChecked" Value="True">
                    <Setter TargetName="ConfirmToggle" Property="IsChecked" Value="False" />
                    <Setter TargetName="CancelToggle" Property="IsChecked" Value="False" />
                </Trigger>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter TargetName="StatusBorder" Property="Background" Value="Gray" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                    <Setter TargetName="StatusBorder" Property="Background" Value="RoyalBlue" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter TargetName="StatusBorder" Property="Background" Value="Green" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter TargetName="StatusBorder" Property="Background" Value="DarkGray" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="RootBorder" Property="BorderBrush" Value="RoyalBlue" />
                    <Setter TargetName="RootBorder" Property="BorderThickness" Value="2" />
                    <Setter TargetName="RootBorder" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect
                                BlurRadius="8"
                                Opacity="0.4"
                                ShadowDepth="2" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:AccountOpeningWorkEventViewModel}">
            <StackPanel>
                <hc:Divider Content="开户信息" />
                <hc:ComboBox
                    hc:InfoElement.Title="账户类型"
                    hc:InfoElement.TitlePlacement="Top"
                    DisplayMemberPath="Value"
                    ItemsSource="{Binding AccountType, Converter={StaticResource EnumToComboBoxItemsConverter}}"
                    SelectedValue="{Binding AccountType}"
                    SelectedValuePath="Key" />
                <DatePicker
                    hc:InfoElement.Title="开户日期"
                    hc:InfoElement.TitlePlacement="Top"
                    SelectedDate="{Binding OpenDate}" />
                <TextBox
                    hc:InfoElement.Title="开户机构"
                    hc:InfoElement.TitlePlacement="Top"
                    Text="{Binding Institution}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:DueDiligenceWorkEventViewModel}">
            <StackPanel>
                <hc:Divider Content="尽调信息" />
                <hc:ComboBox
                    hc:InfoElement.Title="尽调类型"
                    hc:InfoElement.TitlePlacement="Top"
                    DisplayMemberPath="Value"
                    ItemsSource="{Binding DueDiligenceType, Converter={StaticResource EnumToComboBoxItemsConverter}}"
                    SelectedValue="{Binding DueDiligenceType}"
                    SelectedValuePath="Key" />
                <TextBox
                    hc:InfoElement.Title="尽调对象"
                    hc:InfoElement.TitlePlacement="Top"
                    Text="{Binding Target}" />
                <TextBox
                    MinHeight="80"
                    hc:InfoElement.Title="尽调结果"
                    hc:InfoElement.TitlePlacement="Top"
                    Text="{Binding Result}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ManagerAffairsWorkEventViewModel}">
            <StackPanel>
                <hc:Divider Content="管理人事务" />
                <hc:ComboBox
                    hc:InfoElement.Title="事务类型"
                    hc:InfoElement.TitlePlacement="Top"
                    DisplayMemberPath="Value"
                    ItemsSource="{Binding AffairsType, Converter={StaticResource EnumToComboBoxItemsConverter}}"
                    SelectedValue="{Binding AffairsType}"
                    SelectedValuePath="Key" />
                <TextBox
                    hc:InfoElement.Title="处理人"
                    hc:InfoElement.TitlePlacement="Top"
                    Text="{Binding Handler}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:AccountInfoChangeWorkEventViewModel}">
            <StackPanel>
                <hc:Divider Content="变更信息" />
                <hc:ComboBox
                    hc:InfoElement.Title="变更类型"
                    hc:InfoElement.TitlePlacement="Top"
                    DisplayMemberPath="Value"
                    ItemsSource="{Binding ChangeType, Converter={StaticResource EnumToComboBoxItemsConverter}}"
                    SelectedValue="{Binding ChangeType}"
                    SelectedValuePath="Key" />
                <TextBox
                    hc:InfoElement.Title="原始值"
                    hc:InfoElement.TitlePlacement="Top"
                    Text="{Binding OriginalValue}" />
                <TextBox
                    hc:InfoElement.Title="新值"
                    hc:InfoElement.TitlePlacement="Top"
                    Text="{Binding NewValue}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:CustomWorkEventViewModel}">
            <StackPanel>
                <hc:Divider Content="自定义" />
                <TextBox
                    hc:InfoElement.Title="分类"
                    hc:InfoElement.TitlePlacement="Top"
                    Text="{Binding Category}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,8"
            Padding="8"
            Background="WhiteSmoke"
            CornerRadius="5">
            <hc:UniformSpacingPanel
                VerticalAlignment="Center"
                HorizontalSpacing="8"
                Orientation="Horizontal">
                <DatePicker
                    Width="120"
                    hc:InfoElement.Placeholder="开始时间"
                    hc:InfoElement.Title="开始"
                    hc:InfoElement.TitlePlacement="Left"
                    SelectedDate="{Binding StartTime}" />

                <DatePicker
                    Width="120"
                    hc:InfoElement.Placeholder="结束时间"
                    hc:InfoElement.Title="结束"
                    hc:InfoElement.TitlePlacement="Left"
                    SelectedDate="{Binding EndTime}" />

                <ComboBox
                    Width="100"
                    hc:InfoElement.Placeholder="全部标签"
                    hc:InfoElement.Title="标签"
                    hc:InfoElement.TitlePlacement="Left"
                    DisplayMemberPath="."
                    ItemsSource="{Binding AllTags}"
                    SelectedItem="{Binding SelectedTag}" />

                <ComboBox
                    Width="140"
                    hc:InfoElement.Placeholder="全部关联"
                    hc:InfoElement.Title="关联"
                    hc:InfoElement.TitlePlacement="Left"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding AllLinks}"
                    SelectedItem="{Binding SelectedLink}" />

                <ComboBox
                    Width="90"
                    hc:InfoElement.Placeholder="全部状态"
                    hc:InfoElement.Title="状态"
                    hc:InfoElement.TitlePlacement="Left"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding StatusOptions}"
                    SelectedItem="{Binding SelectedStatus}" />

                <TextBox
                    Width="140"
                    hc:InfoElement.Placeholder="搜索标题、描述、关联"
                    hc:InfoElement.Title="关键词"
                    hc:InfoElement.TitlePlacement="Left"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Command="{Binding ClearFilterCommand}"
                    Content="清空"
                    Style="{StaticResource ButtonDefault.Small}" />

                <Button
                    Command="{Binding RefreshCommand}"
                    Content="刷新"
                    Style="{StaticResource ButtonDefault.Small}" />

                <Button
                    Command="{Binding AddEventCommand}"
                    Content="新增"
                    Style="{StaticResource ButtonPrimary.Small}" />
            </hc:UniformSpacingPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="0">
            <hc:UniformSpacingPanel
                Margin="8"
                ChildWrapping="Wrap"
                HorizontalSpacing="8"
                Orientation="Horizontal"
                VerticalSpacing="8">
                <ListBox
                    BorderThickness="0"
                    ItemTemplate="{StaticResource WorkEventItemTemplate}"
                    ItemsSource="{Binding EventSource.View}"
                    SelectedItem="{Binding SelectedEvent}"
                    Style="{StaticResource ListBoxCustom}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <hc:UniformSpacingPanel
                                ChildWrapping="Wrap"
                                HorizontalSpacing="8"
                                IsItemsHost="True"
                                VerticalSpacing="8" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </hc:UniformSpacingPanel>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="8"
            Padding="12"
            Background="WhiteSmoke"
            BorderBrush="LightGray"
            BorderThickness="1,0,0,1"
            CornerRadius="5"
            Visibility="{Binding SelectedEvent, Converter={StaticResource Object2VisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="详情" />
                        <Button
                            Command="{Binding SelectedEvent.SaveCommand}"
                            Content="保存"
                            DockPanel.Dock="Right"
                            Style="{StaticResource ButtonPrimary.Small}" />
                    </DockPanel>

                    <hc:Divider Content="基本信息" />

                    <DockPanel Margin="0,4" LastChildFill="True">
                        <Button
                            Width="60"
                            Margin="2.0"
                            VerticalAlignment="Bottom"
                            Command="{Binding SwitchTypeCommand}"
                            Content="切换"
                            DockPanel.Dock="Right"
                            Style="{StaticResource ButtonDefault}"
                            Visibility="{Binding IsDetailEnabled, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                        <hc:ComboBox
                            hc:InfoElement.Placeholder="请选择事项类型"
                            hc:InfoElement.Title="事项类型"
                            hc:InfoElement.TitlePlacement="Top"
                            DisplayMemberPath="Value"
                            ItemsSource="{Binding SelectedEvent.Type, Converter={StaticResource EnumToComboBoxItemsConverter}}"
                            SelectedValue="{Binding SelectedEventType}"
                            SelectedValuePath="Key" />
                    </DockPanel>

                    <StackPanel IsEnabled="{Binding IsDetailEnabled}">
                        <TextBox
                            Margin="0,4"
                            hc:InfoElement.Placeholder="输入工作事项标题"
                            hc:InfoElement.Title="标题"
                            hc:InfoElement.TitlePlacement="Top"
                            Text="{Binding SelectedEvent.Title}" />

                        <hc:ComboBox
                            Margin="0,4"
                            hc:InfoElement.Placeholder="请选择当前处理状态"
                            hc:InfoElement.Title="处理状态"
                            hc:InfoElement.TitlePlacement="Top"
                            DisplayMemberPath="Value"
                            ItemsSource="{Binding SelectedEvent.Status, Converter={StaticResource EnumToComboBoxItemsConverter}}"
                            SelectedValue="{Binding SelectedEvent.Status}"
                            SelectedValuePath="Key" />

                        <DatePicker
                            Margin="0,4"
                            hc:InfoElement.Placeholder="请选择截止时间（可选）"
                            hc:InfoElement.Title="截止时间"
                            hc:InfoElement.TitlePlacement="Top"
                            SelectedDate="{Binding SelectedEvent.DueTime}" />

                        <TextBox
                            MinHeight="80"
                            Margin="0,4"
                            hc:InfoElement.Placeholder="填写事项详细描述"
                            hc:InfoElement.Title="详细描述"
                            hc:InfoElement.TitlePlacement="Top"
                            Text="{Binding SelectedEvent.Description}"
                            TextWrapping="Wrap" />

                        <TextBox
                            Margin="0,4"
                            hc:InfoElement.Placeholder="多个标签可用逗号、分号分隔"
                            hc:InfoElement.Title="标签"
                            hc:InfoElement.TitlePlacement="Top"
                            Text="{Binding SelectedEvent.TagsText, UpdateSourceTrigger=PropertyChanged}" />

                        <hc:Divider Margin="0,10" Content="关联对象" />

                    <CheckBox
                        Margin="0,4"
                        Content="关联管理人"
                        IsChecked="{Binding SelectedEvent.IsManagerLinked}" />

                    <CheckBox
                        Margin="0,4"
                        Content="关联基金"
                        IsChecked="{Binding SelectedEvent.IsFundLinked}" />

                    <Border
                        Margin="0,4"
                        Padding="4"
                        Background="White"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="{Binding SelectedEvent.IsFundLinked, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                Foreground="Gray"
                                Text="选择关联基金（可多选）：" />
                            <ListBox
                                MaxHeight="160"
                                BorderThickness="0"
                                ItemsSource="{Binding AllFunds}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="local:SelectableFund">
                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <CheckBox
                        Margin="0,8,0,4"
                        Content="关联交易账户"
                        IsChecked="{Binding SelectedEvent.IsAccountLinked}"
                        Visibility="{Binding SelectedEvent.IsFundLinked, Converter={StaticResource Boolean2VisibilityConverter}}" />

                    <Border
                        Margin="0,4"
                        Padding="4"
                        Background="White"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="{Binding SelectedEvent.IsAccountLinked, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                FontSize="12"
                                Foreground="Gray"
                                Text="选择已选基金的交易账户（可多选）：" />
                            <ListBox
                                MaxHeight="160"
                                BorderThickness="0"
                                ItemsSource="{Binding FilteredAccounts}"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="local:SelectableAccount">
                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                        <ContentControl Margin="0,10" Content="{Binding SelectedEvent}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
