<Window
    x:Class="FMO.AddFundSacleWarningNoticeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加基金规模预警公告"
    Width="435"
    Height="150"
    d:DataContext="{d:DesignInstance Type=local:AddFundSacleWarningNoticeWindowViewModel}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <DockPanel Margin="8">

        <StackPanel>
            <DockPanel>
                <TextBlock
                    Width="60"
                    VerticalAlignment="Center"
                    Text="选择基金" />
                <ComboBox
                    IsDropDownOpen="{Binding ShowList}"
                    IsEditable="True"
                    ItemsSource="{Binding FundSource.View}"
                    SelectedItem="{Binding SelectedFund}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                    TextSearch.TextPath="Name">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Width="60" Text="{Binding Code}" />
                                <TextBlock Margin="5,0,0,0" Text="{Binding Name}" />
                            </DockPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>


            <DockPanel>
                <Button
                    Height="auto"
                    Margin="5"
                    VerticalAlignment="Stretch"
                    Command="{Binding ConfirmCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="确认"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ButtonPrimary}" />

                <DockPanel
                    Margin="0,5"
                    DockPanel.Dock="Top"
                    LastChildFill="False">

                    <TextBlock
                        Width="60"
                        VerticalAlignment="Center"
                        Text="预警类型" />

                    <ComboBox
                        ItemsSource="{Binding WarningTypes}"
                        SelectedItem="{Binding WarningType}" />

                </DockPanel>

                <DockPanel LastChildFill="False">

                    <hc:DateTimePicker
                        Width="140"
                        DockPanel.Dock="Right"
                        SelectedDateTime="{Binding PublishTime}" />

                    <TextBlock
                        Width="60"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Text="发布时间"
                        TextAlignment="Center" />


                    <TextBlock VerticalAlignment="Center" Text="触发日期" />

                    <DatePicker Width="90" SelectedDate="{Binding TouchDate}" />


                </DockPanel>
            </DockPanel>
        </StackPanel>
    </DockPanel>
</Window>
