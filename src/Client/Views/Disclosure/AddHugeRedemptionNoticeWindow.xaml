<Window
    x:Class="FMO.AddHugeRedemptionNoticeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="巨额赎回通知"
    Width="420"
    Height="150"
    d:DataContext="{d:DesignInstance Type=local:AddHugeRedemptionNoticeWindowViewModel}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <DockPanel Margin="8">

        <StackPanel>
            <DockPanel>
                <TextBlock
                    Width="60"
                    VerticalAlignment="Center"
                    Text="选择基金" />
                <ComboBox
                    IsDropDownOpen="{Binding ShowList}"
                    IsEditable="True"
                    ItemsSource="{Binding FundSource.View}"
                    SelectedItem="{Binding SelectedFund}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                    TextSearch.TextPath="Name">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Width="60" Text="{Binding Code}" />
                                <TextBlock Margin="5,0,0,0" Text="{Binding Name}" />
                            </DockPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>


            <DockPanel>
                <Button
                    Height="auto"
                    Margin="5"
                    VerticalAlignment="Stretch"
                    Command="{Binding ConfirmCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="确认"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ButtonPrimary}" />

                <DockPanel
                    Margin="0,5"
                    DockPanel.Dock="Top"
                    LastChildFill="False">


                    <TextBlock
                        Width="60"
                        VerticalAlignment="Center"
                        Text="赎回比例" />

                    <hc:TextBox
                        Width="90"
                        Margin="4,0"
                        HorizontalContentAlignment="Center"
                        hc:InfoElement.Placeholder="实际赎回比例"
                        Text="{Binding RealRatio, UpdateSourceTrigger=PropertyChanged, StringFormat=N2, Delay=500}" />
                    <TextBlock VerticalAlignment="Center" Text="%" />

                    <TextBlock VerticalAlignment="Center" Text="/" />
                    <hc:TextBox
                        Width="120"
                        Margin="4,0"
                        HorizontalContentAlignment="Center"
                        hc:InfoElement.Placeholder="约定巨额赎回比例"
                        Text="{Binding DefinedRatio, UpdateSourceTrigger=PropertyChanged, Delay=500}" />
                    <TextBlock VerticalAlignment="Center" Text="%" />
                </DockPanel>

                <DockPanel LastChildFill="False">

                    <TextBlock VerticalAlignment="Center" Text="开放日" />
                    <DatePicker SelectedDate="{Binding OpenDate}" />


                    <TextBlock
                        Width="60"
                        VerticalAlignment="Center"
                        Text="发布时间"
                        TextAlignment="Center" />
                    <hc:DateTimePicker SelectedDateTime="{Binding PublishTime}" />
                </DockPanel>
            </DockPanel>
        </StackPanel>
    </DockPanel>
</Window>
