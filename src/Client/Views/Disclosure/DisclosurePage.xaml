<UserControl
    x:Class="FMO.DisclosurePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:FMO.Shared;assembly=SharedUI"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <local:DisclosurePageViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <!--  定义 ListBoxItem 样式  -->
        <Style x:Key="ZoomOnSelectListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                            </Border.RenderTransform>
                            <ContentPresenter
                                Margin="0,4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.FontSize="16" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="RoyalBlue" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="LayoutTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="NoArrowExpander" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="LightGray" BorderThickness="1">
                            <DockPanel LastChildFill="True">
                                <!--  标题区域（无箭头）  -->
                                <ToggleButton
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Background="#eeeeee"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    DockPanel.Dock="Top"
                                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="OverridesDefaultStyle" Value="True" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}">
                                                            <ContentPresenter
                                                                Margin="3,2"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>

                                <!--  展开内容区域  -->
                                <ContentPresenter
                                    x:Name="ExpandSite"
                                    DockPanel.Dock="Bottom"
                                    Visibility="Collapsed" />
                            </DockPanel>
                        </Border>

                        <!--  触发展开/折叠动画  -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RunDataTemplate" DataType="local:DisclosureRunViewModel">
            <Expander Header="{Binding}" Style="{StaticResource NoArrowExpander}">
                <Expander.HeaderTemplate>
                    <DataTemplate>
                        <DockPanel MinHeight="22" LastChildFill="False">
                            <DockPanel.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DockPanel.Resources>






                            <hc:SimplePanel DockPanel.Dock="Right">
                                <DockPanel Visibility="{Binding HasInstance, Converter={StaticResource Boolean2VisibilityReConverter}}">
                                    <TextBlock
                                        Margin="3,0"
                                        Foreground="Red"
                                        Text="未创建信批任务" />
                                    <Button
                                        Command="{Binding CreateInstanceCommand}"
                                        Content="创建"
                                        Style="{StaticResource ButtonPrimary.Small}" />
                                </DockPanel>

                                <DockPanel Visibility="{Binding HasInstance, Converter={StaticResource Boolean2VisibilityConverter}}">
                                    <Button
                                        x:Name="btn"
                                        hc:IconElement.Geometry="{StaticResource f.play}"
                                        Command="{Binding StartRunCommand}"
                                        DockPanel.Dock="Right"
                                        Foreground="Green"
                                        Style="{StaticResource ButtonIcon.Small}"
                                        Visibility="Collapsed" />
                                    <Button
                                        x:Name="stop"
                                        hc:IconElement.Geometry="{StaticResource f.stop}"
                                        Command="{Binding StopRunCommand}"
                                        DockPanel.Dock="Right"
                                        Foreground="Red"
                                        Style="{StaticResource ButtonIcon.Small}"
                                        Visibility="Collapsed" />
                                    <TextBlock Text="{Binding Status, Converter={StaticResource EnumDescriptionConverter}}" />
                                </DockPanel>
                            </hc:SimplePanel>
                            <TextBlock Foreground="DodgerBlue" Text="{Binding ChannelName}" />
                            <hc:AnimationPath
                                Height="12"
                                Margin="5,0"
                                Data="{StaticResource f.robot}"
                                IsPlaying="{Binding AutoRun}"
                                Stroke="Orange"
                                Visibility="{Binding AutoRun, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                <Setter TargetName="btn" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                <Setter TargetName="btn" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Stopped">
                                <Setter TargetName="btn" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Waiting">
                                <Setter TargetName="stop" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!--<DataTrigger Binding="{Binding Status}" Value="Processing">
                                <Setter TargetName="stop" Property="Visibility" Value="Visible" />
                            </DataTrigger>-->
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Expander.HeaderTemplate>

                <hc:SimplePanel Visibility="{Binding HasInstance, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <hc:UniformSpacingPanel
                        x:Name="detail"
                        Margin="4,0"
                        Orientation="Vertical">
                        <DockPanel>

                            <TextBlock DockPanel.Dock="Right" Text="{Binding StartedTime, StringFormat=yyyy/MM/dd HH:mm:ss}" />
                            <TextBlock Text="首次执行" />
                        </DockPanel>

                        <DockPanel>

                            <TextBlock DockPanel.Dock="Right" Text="{Binding CompletedTime, StringFormat=yyyy/MM/dd HH:mm:ss}" />
                            <TextBlock Text="最近执行" />
                        </DockPanel>

                        <DockPanel>

                            <TextBlock DockPanel.Dock="Right" Text="{Binding FailedTimes}" />
                            <TextBlock Text="失败次数" />
                        </DockPanel>

                        <DockPanel>

                            <Separator DockPanel.Dock="Top" />

                            <TextBlock
                                DockPanel.Dock="Right"
                                Text="{Binding Error}"
                                TextWrapping="Wrap" />
                        </DockPanel>
                    </hc:UniformSpacingPanel>
                </hc:SimplePanel>
            </Expander>
        </DataTemplate>


        <DataTemplate DataType="{x:Type local:TemporaryFundNoticeViewModel}">
            <Border MinWidth="240">
                <StackPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top">
                        <Button
                            x:Name="del"
                            hc:IconElement.Geometry="{StaticResource f.trash}"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=local:DisclosurePage}}"
                            CommandParameter="{Binding .}"
                            DockPanel.Dock="Right"
                            Foreground="Red"
                            Style="{StaticResource ButtonIcon.Small}"
                            Visibility="Collapsed" />

                        <TextBlock
                            shared:MaskService.IsMask="True"
                            FontSize="15"
                            Text="{Binding DisplayName}" />

                    </DockPanel>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding OpenDay, StringFormat=yyyy/MM/dd}" />
                        <TextBlock Text="{Binding Type}" />
                        <TextBlock
                            Margin="4,0"
                            FontWeight="Bold"
                            Text="申购"
                            Visibility="{Binding AllowPurchase, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        <TextBlock
                            Margin="4,0"
                            FontWeight="Bold"
                            Text="赎回"
                            Visibility="{Binding AllowRedemption, Converter={StaticResource Boolean2VisibilityConverter}}" />

                    </DockPanel>

                    <shared:FileView
                        Content="{Binding File}"
                        Header="报告"
                        Style="{StaticResource SimpleFileStyle}" />


                    <ListBox
                        Margin="-4,0"
                        BorderThickness="0"
                        ItemTemplate="{StaticResource RunDataTemplate}"
                        ItemsSource="{Binding Runs}"
                        Style="{StaticResource ListBoxCustom}" />

                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="del" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <DataTemplate x:Key="ReportItem">
            <Border Width="260">
                <StackPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock
                            shared:MaskService.IsMask="True"
                            FontSize="15"
                            Text="{Binding DisplayName}" />

                    </DockPanel>

                    <UniformGrid Columns="2">

                        <shared:FileView
                            Content="{Binding Word}"
                            IsReadOnly="False"
                            Style="{StaticResource IconViewFileStyle}">
                            <shared:FileView.Header>
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource f.file-word}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
                                </Viewbox>
                            </shared:FileView.Header>
                        </shared:FileView>


                        <shared:FileView
                            Content="{Binding Excel}"
                            HeaderTemplate="{x:Null}"
                            Style="{StaticResource IconViewFileStyle}">
                            <shared:FileView.Header>
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource f.file-excel}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
                                </Viewbox>
                            </shared:FileView.Header>
                        </shared:FileView>


                        <shared:FileView Content="{Binding Pdf}" Style="{StaticResource IconViewFileStyle}">
                            <shared:FileView.Header>
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource f.file-pdf}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
                                </Viewbox>
                            </shared:FileView.Header>
                        </shared:FileView>

                        <shared:FileView Content="{Binding Xbrl}" Style="{StaticResource IconViewFileStyle}">
                            <shared:FileView.Header>
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource f.file-code}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
                                </Viewbox>
                            </shared:FileView.Header>
                        </shared:FileView>


                    </UniformGrid>

                    <ListBox
                        Margin="-4,0"
                        BorderThickness="0"
                        ItemTemplate="{StaticResource RunDataTemplate}"
                        ItemsSource="{Binding Runs}"
                        Style="{StaticResource ListBoxCustom}" />

                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReportItem2">
            <Border MinWidth="240">
                <StackPanel Margin="4">

                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock
                            shared:MaskService.IsMask="True"
                            FontSize="15"
                            Text="{Binding DisplayName}" />

                    </DockPanel>


                    <UniformGrid Columns="2">

                        <shared:FileView
                            Content="{Binding Word}"
                            IsReadOnly="False"
                            Style="{StaticResource IconViewFileStyle}">
                            <shared:FileView.Header>
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource f.file-word}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
                                </Viewbox>
                            </shared:FileView.Header>
                        </shared:FileView>

                        <shared:FileView
                            Content="{Binding Excel}"
                            HeaderTemplate="{x:Null}"
                            Style="{StaticResource IconViewFileStyle}">
                            <shared:FileView.Header>
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource f.file-excel}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
                                </Viewbox>
                            </shared:FileView.Header>
                        </shared:FileView>

                        <shared:FileView Content="{Binding Pdf}" Style="{StaticResource IconViewFileStyle}">
                            <shared:FileView.Header>
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource f.file-pdf}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
                                </Viewbox>
                            </shared:FileView.Header>
                        </shared:FileView>

                        <shared:FileView Content="{Binding Xbrl}" Style="{StaticResource IconViewFileStyle}">
                            <shared:FileView.Header>
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource f.file-code}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
                                </Viewbox>
                            </shared:FileView.Header>
                        </shared:FileView>

                        <shared:FileView Content="{Binding Sealed}" Style="{StaticResource IconViewFileStyle}">
                            <shared:FileView.Header>
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource f.file-shield}" Fill="Red" />
                                </Viewbox>
                            </shared:FileView.Header>
                        </shared:FileView>
                    </UniformGrid>


                    <ListBox
                        BorderThickness="0"
                        ItemTemplate="{StaticResource RunDataTemplate}"
                        ItemsSource="{Binding Runs}"
                        Style="{StaticResource ListBoxCustom}" />
                </StackPanel>
            </Border>
        </DataTemplate>


        <DataTemplate x:Key="QuarterlyUpdateItem">
            <Border MinWidth="240">
                <DockPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock
                            shared:MaskService.IsMask="True"
                            FontSize="15"
                            Text="{Binding DisplayName}" />

                    </DockPanel>

                    <StackPanel>
                        <DockPanel>

                            <shared:FileView Content="{Binding Operation}" Style="{StaticResource IconViewFileStyle}">
                                <shared:FileView.Header>
                                    <TextBlock VerticalAlignment="Center" Text="运行信息表" />
                                </shared:FileView.Header>
                            </shared:FileView>


                        </DockPanel>

                        <DockPanel>

                            <Button
                                Command="{Binding GenerateInvestorSheetCommand}"
                                Content="生成"
                                DockPanel.Dock="Right"
                                Style="{StaticResource ButtonPrimary.Small}"
                                Visibility="{Binding Investor.Exists, Converter={StaticResource Boolean2VisibilityReConverter}}" />

                            <shared:FileView Content="{Binding Investor}" Style="{StaticResource IconViewFileStyle}">
                                <shared:FileView.Header>
                                    <TextBlock VerticalAlignment="Center" Text="投资人信息表" />
                                </shared:FileView.Header>
                            </shared:FileView>

                        </DockPanel>

                        <ListBox
                            Margin="-4,0"
                            BorderThickness="0"
                            ItemTemplate="{StaticResource RunDataTemplate}"
                            ItemsSource="{Binding Runs}"
                            Style="{StaticResource ListBoxCustom}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>



        <DataTemplate DataType="{x:Type local:TemporaryOpenNoticeViewModel}">
            <Border Width="260">
                <StackPanel Margin="4">
                    <DockPanel>
                        <TextBlock
                            Width="32"
                            Margin="0,0,20,0"
                            FontSize="14"
                            FontWeight="Black"
                            Foreground="RoyalBlue"
                            Text="临时开放"
                            TextWrapping="Wrap" />

                        <DockPanel DockPanel.Dock="Top">

                            <TextBlock
                                shared:MaskService.IsMask="True"
                                FontSize="15"
                                Text="{Binding DisplayName}" />

                        </DockPanel>

                        <DockPanel Margin="0,4">

                            <TextBlock FontSize="14" Text="{Binding OpenDay, StringFormat={}yy/MM/dd}" />
                            <TextBlock
                                Margin="10,0"
                                FontSize="14"
                                Text="{Binding Allow}" />
                        </DockPanel>
                    </DockPanel>


                    <UniformGrid Rows="1">

                        <shared:FileView
                            Content="{Binding Word}"
                            IsReadOnly="False"
                            Style="{StaticResource IconViewFileStyle}">
                            <shared:FileView.Header>
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource f.file-word}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
                                </Viewbox>
                            </shared:FileView.Header>
                        </shared:FileView>


                        <shared:FileView Content="{Binding Pdf}" Style="{StaticResource IconViewFileStyle}">
                            <shared:FileView.Header>
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource f.file-pdf}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
                                </Viewbox>
                            </shared:FileView.Header>
                        </shared:FileView>


                    </UniformGrid>

                    <ListBox
                        Margin="-4,0"
                        BorderThickness="0"
                        ItemTemplate="{StaticResource RunDataTemplate}"
                        ItemsSource="{Binding Runs}"
                        Style="{StaticResource ListBoxCustom}" />

                </StackPanel>
            </Border>
        </DataTemplate>


        <DataTemplate DataType="{x:Type local:HugeRedemptionNoticeViewModel}">
            <Border Width="260">
                <StackPanel Margin="4">
                    <DockPanel>
                        <TextBlock
                            Width="32"
                            Margin="0,0,20,0"
                            FontSize="14"
                            FontWeight="Black"
                            Foreground="RoyalBlue"
                            Text="巨额赎回"
                            TextWrapping="Wrap" />

                        <DockPanel DockPanel.Dock="Top">

                            <TextBlock
                                shared:MaskService.IsMask="True"
                                FontSize="15"
                                Text="{Binding DisplayName}" />

                        </DockPanel>

                        <DockPanel Margin="0,4">

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{Binding OpenDay, StringFormat={}yy/MM/dd}" />

                            <TextBlock
                                Margin="8,0"
                                VerticalAlignment="Center"
                                Text="赎回比例" />
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="{Binding RealRatio, StringFormat=P2}" />
                                <Run Text="/" />
                                <Run Text="{Binding DefinedRatio, StringFormat=P0}" />
                            </TextBlock>
                        </DockPanel>
                    </DockPanel>


                    <UniformGrid Rows="1">

                        <shared:FileView
                            Content="{Binding Word}"
                            IsReadOnly="False"
                            Style="{StaticResource IconViewFileStyle}">
                            <shared:FileView.Header>
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource f.file-word}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
                                </Viewbox>
                            </shared:FileView.Header>
                        </shared:FileView>


                        <shared:FileView Content="{Binding Pdf}" Style="{StaticResource IconViewFileStyle}">
                            <shared:FileView.Header>
                                <Viewbox Width="14" Height="14">
                                    <Path Data="{StaticResource f.file-pdf}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" />
                                </Viewbox>
                            </shared:FileView.Header>
                        </shared:FileView>


                    </UniformGrid>

                    <ListBox
                        Margin="-4,0"
                        BorderThickness="0"
                        ItemTemplate="{StaticResource RunDataTemplate}"
                        ItemsSource="{Binding Runs}"
                        Style="{StaticResource ListBoxCustom}" />

                </StackPanel>
            </Border>
        </DataTemplate>


    </UserControl.Resources>
    <DockPanel>


        <DockPanel
            Margin="0,8"
            DockPanel.Dock="Top"
            LastChildFill="False">

            <Button
                Command="{Binding ConfigureCommand}"
                Content="配置信批通道"
                DockPanel.Dock="Right"
                Style="{StaticResource ButtonPrimary}" />


            <ComboBox
                BorderThickness="0"
                ItemsSource="{Binding Years}"
                SelectedIndex="0"
                SelectedItem="{Binding SelectedYear}" />

            <ListBox
                BorderThickness="0"
                ItemContainerStyle="{StaticResource ListBoxItem.AllaysFocus}"
                ItemsPanel="{StaticResource StackHorizontalItemsPanelTemplate}"
                ItemsSource="{Binding Months}"
                SelectedIndex="0"
                SelectedItem="{Binding SelectedMonth}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ., StringFormat={}{0}月}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <CheckBox Content="排除已清盘产品" IsChecked="{Binding FilterClearedFund}" />

            <TextBlock />


        </DockPanel>

        <ScrollViewer>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="8">
                <hc:UniformSpacingPanel.Resources>
                    <Style BasedOn="{StaticResource GroupBoxTab}" TargetType="GroupBox" />

                </hc:UniformSpacingPanel.Resources>


                <Expander IsExpanded="True" Visibility="{Binding QuarterlyUpdateSource.View.IsEmpty, Converter={StaticResource Boolean2VisibilityReConverter}}">
                    <Expander.Header>
                        <DockPanel>
                            <TextBlock
                                Margin="10,0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="季度更新" />

                        </DockPanel>
                    </Expander.Header>

                    <ListBox
                        ItemTemplate="{StaticResource QuarterlyUpdateItem}"
                        ItemsSource="{Binding QuarterlyUpdateSource.View}"
                        Style="{StaticResource ListBoxCustom}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <hc:UniformSpacingPanel
                                    ChildWrapping="Wrap"
                                    HorizontalSpacing="20"
                                    IsItemsHost="True"
                                    VerticalSpacing="5" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Expander>






                <Expander IsExpanded="True" Visibility="{Binding MonthlySource.View.IsEmpty, Converter={StaticResource Boolean2VisibilityReConverter}}">
                    <Expander.Header>
                        <DockPanel>
                            <TextBlock
                                Margin="10,0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="月报" />

                        </DockPanel>
                    </Expander.Header>

                    <ListBox
                        ItemTemplate="{StaticResource ReportItem}"
                        ItemsSource="{Binding MonthlySource.View}"
                        Style="{StaticResource ListBoxCustom}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <hc:UniformSpacingPanel
                                    ChildWrapping="Wrap"
                                    HorizontalSpacing="10"
                                    IsItemsHost="True"
                                    VerticalSpacing="5" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Expander>

                <Expander IsExpanded="True" Visibility="{Binding QuarterlySource.View.IsEmpty, Converter={StaticResource Boolean2VisibilityReConverter}}">
                    <Expander.Header>
                        <DockPanel>
                            <TextBlock
                                Margin="10,0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="季报" />
                        </DockPanel>
                    </Expander.Header>
                    <ListBox
                        ItemTemplate="{StaticResource ReportItem}"
                        ItemsSource="{Binding QuarterlySource.View}"
                        Style="{StaticResource ListBoxCustom}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <hc:UniformSpacingPanel
                                    ChildWrapping="Wrap"
                                    HorizontalSpacing="20"
                                    IsItemsHost="True"
                                    VerticalSpacing="5" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Expander>

                <Expander
                    Header="半年报"
                    IsExpanded="True"
                    Visibility="{Binding SemiAnnualSource.View.IsEmpty, Converter={StaticResource Boolean2VisibilityReConverter}}">

                    <ListBox
                        ItemTemplate="{StaticResource ReportItem}"
                        ItemsSource="{Binding SemiAnnualSource.View}"
                        Style="{StaticResource ListBoxCustom}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <hc:UniformSpacingPanel
                                    ChildWrapping="Wrap"
                                    HorizontalSpacing="20"
                                    IsItemsHost="True"
                                    VerticalSpacing="5" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Expander>

                <Expander IsExpanded="True" Visibility="{Binding AnnualSource.View.IsEmpty, Converter={StaticResource Boolean2VisibilityReConverter}}">
                    <Expander.Header>
                        <DockPanel>
                            <TextBlock
                                Margin="10,0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="年报" />
                        </DockPanel>
                    </Expander.Header>
                    <ListBox
                        ItemTemplate="{StaticResource ReportItem2}"
                        ItemsSource="{Binding AnnualSource.View}"
                        Style="{StaticResource ListBoxCustom}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <hc:UniformSpacingPanel
                                    ChildWrapping="Wrap"
                                    HorizontalSpacing="20"
                                    IsItemsHost="True"
                                    VerticalSpacing="5" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Expander>

                <Expander IsExpanded="True">
                    <Expander.Header>
                        <DockPanel>
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="临时公告" />

                            <hc:UniformSpacingPanel
                                Margin="10,0,0,0"
                                VerticalAlignment="Stretch"
                                HorizontalSpacing="8">
                                <Button
                                    hc:IconElement.Geometry="{StaticResource f.plus}"
                                    Command="{Binding GenerateTemporaryOpenCommand}"
                                    Content="临时开放"
                                    Style="{StaticResource ButtonDefault.Small}" />


                                <Button
                                    hc:IconElement.Geometry="{StaticResource f.plus}"
                                    Command="{Binding GenerateHugeRedemptionNoticeCommand}"
                                    Content="巨额赎回"
                                    Style="{StaticResource ButtonDefault.Small}" />
                            </hc:UniformSpacingPanel>
                        </DockPanel>
                    </Expander.Header>

                    <ListBox
                        BorderThickness="0"
                        ItemsSource="{Binding TemporaryNoticeSource.View}"
                        Style="{StaticResource ListBoxCustom}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <hc:UniformSpacingPanel
                                    ChildWrapping="Wrap"
                                    HorizontalSpacing="10"
                                    IsItemsHost="True"
                                    VerticalSpacing="5" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                Background="Transparent"
                                                BorderBrush="Gray"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                                <hc:SimplePanel>
                                                    <ContentPresenter Content="{Binding}" />

                                                    <DockPanel
                                                        x:Name="del"
                                                        Margin="4"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        hc:IconElement.Geometry="{StaticResource f.trash}"
                                                        LastChildFill="False"
                                                        Visibility="Collapsed">
                                                        <ToggleButton
                                                            x:Name="a"
                                                            Content="删除"
                                                            Style="{StaticResource ToggleButtonDanger.Small}"
                                                            Visibility="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource Boolean2VisibilityReConverter}}" />

                                                        <DockPanel x:Name="b" Visibility="{Binding ElementName=a, Path=IsChecked, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                            <Button
                                                                Width="18"
                                                                Margin="0"
                                                                Padding="0"
                                                                hc:IconElement.Geometry="{StaticResource f.check}"
                                                                Command="{Binding DataContext.DeleteTemporyNoticeCommand, RelativeSource={RelativeSource AncestorType=local:DisclosurePage}}"
                                                                CommandParameter="{Binding .}"
                                                                Foreground="Red"
                                                                Style="{StaticResource ButtonIcon.Small}" />
                                                            <ToggleButton
                                                                x:Name="c"
                                                                hc:IconElement.Geometry="{StaticResource f.x}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Style="{StaticResource ToggleButtonIcon.Small}" />
                                                        </DockPanel>
                                                    </DockPanel>
                                                </hc:SimplePanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="del" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger SourceName="c" Property="IsChecked" Value="True">
                                                    <Setter TargetName="a" Property="IsChecked" Value="False" />
                                                    <Setter TargetName="c" Property="IsChecked" Value="False" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Expander>
            </hc:UniformSpacingPanel>

        </ScrollViewer>

    </DockPanel>
</UserControl>

