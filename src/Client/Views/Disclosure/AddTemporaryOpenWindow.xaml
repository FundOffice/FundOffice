<Window
    x:Class="FMO.AddTemporaryOpenWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="添加临时开放公告"
    Width="420"
    Height="150"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <DockPanel Margin="8">

        <StackPanel>
            <DockPanel>
                <TextBlock
                    Width="60"
                    VerticalAlignment="Center"
                    Text="选择基金" />
                <ComboBox
                    IsDropDownOpen="{Binding ShowList}"
                    IsEditable="True"
                    ItemsSource="{Binding FundSource.View}"
                    SelectedItem="{Binding SelectedFund}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                    TextSearch.TextPath="Name">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock Width="60" Text="{Binding Code}" />
                                <TextBlock Margin="5,0,0,0" Text="{Binding Name}" />
                            </DockPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>


            <DockPanel>
                <Button
                    Height="auto"
                    Margin="5"
                    VerticalAlignment="Stretch"
                    Command="{Binding ConfirmCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="确认"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ButtonPrimary}" />

                <DockPanel
                    Margin="0,5"
                    DockPanel.Dock="Top"
                    LastChildFill="False">

                    <TextBlock
                        Width="60"
                        VerticalAlignment="Center"
                        Text="开放日" />
                    <DatePicker SelectedDate="{Binding OpenDate}" />
                    <CheckBox
                        Margin="4,0"
                        HorizontalAlignment="Center"
                        Content="申购"
                        IsChecked="{Binding AllowBuy}" />
                    <CheckBox
                        HorizontalAlignment="Center"
                        Content="赎回"
                        IsChecked="{Binding AllowSell}" />
                </DockPanel>

                <DockPanel LastChildFill="False">
                    <TextBlock
                        Width="60"
                        VerticalAlignment="Center"
                        Text="发布时间" />
                    <hc:DateTimePicker SelectedDateTime="{Binding PublishTime}" />
                </DockPanel>
            </DockPanel>
        </StackPanel>
    </DockPanel>
</Window>
