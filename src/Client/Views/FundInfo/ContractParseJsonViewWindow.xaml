<Window
    x:Class="FMO.ContractParseJsonViewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:FMO.Shared;assembly=SharedUI"
    Title="解析 JSON 查看"
    Width="1400"
    Height="800"
    d:DataContext="{d:DesignInstance Type=local:ContractParseJsonViewViewModel}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="CategoryTab" TargetType="TextBlock">
            <Setter Property="MaxWidth" Value="20" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="10"
            Background="WhiteSmoke"
            BorderBrush="LightGray"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="Provider:" />
                <TextBlock
                    Grid.Column="1"
                    Margin="5,0,20,0"
                    VerticalAlignment="Center"
                    Text="{Binding Provider}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="Time:" />
                <TextBlock
                    Grid.Column="3"
                    Margin="5,0,20,0"
                    VerticalAlignment="Center"
                    Text="{Binding ParsedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="FileHash:" />
                <TextBlock
                    Grid.Column="5"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding FileHash}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl Margin="10" ItemsSource="{Binding Properties}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <shared:TwoColumnPanel ColumnSpacing="20" ItemSpacing="15" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ContractParseProperty}">
                        <Border Padding="10" CornerRadius="4">
                            <DockPanel>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Title}" />

                                        <Border
                                            Margin="10,0,0,5"
                                            Padding="4,1"
                                            HorizontalAlignment="Left"
                                            Background="{Binding Confidence, Converter={StaticResource ConfidenceToBrushConverter}}"
                                            CornerRadius="4"
                                            Visibility="{Binding Confidence, Converter={StaticResource ValueIsEffectToVisibilityConverter}}">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="White"
                                                Text="{Binding Confidence, StringFormat={}{0:P0}}" />
                                        </Border>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:ContractParseProperty+PropertyWithValue}">
                                                <Border
                                                    Margin="0,2"
                                                    BorderBrush="Gray"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
                                                    <ItemsControl ItemsSource="{Binding}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type local:ContractParseProperty+PropertyWithValue}">
                                                                <Grid Margin="12,0,12,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        Grid.Column="0"
                                                                        Margin="0,0,4,0"
                                                                        VerticalAlignment="Center"
                                                                        FontWeight="Bold"
                                                                        Text="{Binding Property}" />
                                                                    <shared:CopyableTextBlock
                                                                        Grid.Column="1"
                                                                        VerticalAlignment="Center"
                                                                        Text="{Binding Value}"
                                                                        TextWrapping="Wrap" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
