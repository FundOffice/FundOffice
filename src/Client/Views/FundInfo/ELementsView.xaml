<UserControl
    x:Class="FMO.ElementsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:FMO.Models;assembly=Models"
    xmlns:shared="clr-namespace:FMO.Shared;assembly=SharedUI"
    d:DataContext="{d:DesignInstance Type=local:ElementsViewModel}"
    d:DesignHeight="950"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>

        <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/FactorDataTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="DefaultCopyable">
                <shared:CopyableTextBlock Text="{Binding ., Converter={StaticResource ObjectDisplayConverter}}" TextWrapping="Wrap" />
            </DataTemplate>

            <!--<DataTemplate x:Key="FactorEditTemplate">
                <ContentPresenter VerticalAlignment="Center" Content="{Binding}" />
            </DataTemplate>-->

            <Style BasedOn="{StaticResource {x:Type shared:FactorModifiableControl}}" TargetType="shared:FactorModifiableControl">
                <Setter Property="IsReadOnly" Value="{Binding IsReadOnly}" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="ContentTemplate" Value="{StaticResource DefaultCopyable}" />
            </Style>


            <Style BasedOn="{StaticResource Modifiable.Inherit}" TargetType="shared:ModifiableControl">
                <Setter Property="IsReadOnly" Value="{Binding IsReadOnly}" />
                <Setter Property="MinHeight" Value="24" />

                <Setter Property="ContentTemplate" Value="{StaticResource DefaultCopyable}" />
            </Style>




            <Style x:Key="CategoryTab" TargetType="TextBlock">
                <Setter Property="MaxWidth" Value="20" />
                <Setter Property="Margin" Value="8" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>


            <Style
                x:Key="Modifiable.Bank"
                BasedOn="{StaticResource {x:Type shared:ModifiableControl}}"
                TargetType="{x:Type shared:ModifiableControl}">
                <Setter Property="IsReadOnly" Value="{Binding IsReadOnly}" />
                <Setter Property="ContentTemplate" Value="{StaticResource DT.Bank.Display}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type shared:ModifiableControl}">
                            <Border
                                x:Name="RootBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!--  Header 区域（可定制）  -->
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <!--  内容区域（只读/编辑自动切换）  -->
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  🔹 Header：支持 Header + HeaderTemplate  -->

                                    <Border Margin="0,0,10,0" Background="SaddleBrown">
                                        <hc:SimplePanel x:Name="headerPanel" VerticalAlignment="Center">
                                            <TextBlock
                                                Width="14"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CategoryTab}"
                                                Text="{TemplateBinding Header}"
                                                TextElement.FontWeight="Medium"
                                                TextWrapping="Wrap" />

                                            <Viewbox
                                                Height="9"
                                                Margin="0,0,3,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding Modifier.IsInherited, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                <Path Data="{StaticResource f.arrow-turn-down}" Fill="White" />
                                            </Viewbox>
                                        </hc:SimplePanel>
                                    </Border>

                                    <!--  🔹 内容区域：根据 IsReadOnly 切换模板  -->

                                    <ContentPresenter
                                        Grid.Column="1"
                                        Margin="5,0,0,0"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{Binding Modifier.NewValue, RelativeSource={RelativeSource TemplatedParent}}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Visibility="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Boolean2VisibilityConverter}}" />

                                    <ContentPresenter
                                        Grid.Column="1"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Content="{Binding Modifier.NewValue, RelativeSource={RelativeSource TemplatedParent}}"
                                        ContentTemplate="{TemplateBinding EditTemplate}"
                                        Visibility="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Boolean2VisibilityReConverter}}" />

                                    <Border
                                        Grid.Column="2"
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        BorderBrush="Gray"
                                        CornerRadius="5"
                                        Visibility="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Boolean2VisibilityReConverter}}">
                                        <StackPanel Margin="2,0">

                                            <hc:SimplePanel
                                                x:Name="clpanel"
                                                DockPanel.Dock="Right"
                                                Visibility="Collapsed">
                                                <Button
                                                    x:Name="clear"
                                                    Padding="2,1"
                                                    hc:IconElement.Geometry="{StaticResource f.circle-xmark}"
                                                    hc:IconElement.Height="14"
                                                    Command="{Binding Modifier.ClearCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Foreground="Red"
                                                    Style="{StaticResource ButtonIcon.Small}"
                                                    ToolTip="清空"
                                                    Visibility="{Binding Modifier.CanClear, Converter={StaticResource Boolean2VisibilityConverter}, RelativeSource={RelativeSource TemplatedParent}}" />
                                            </hc:SimplePanel>

                                            <Button
                                                Command="{Binding Modifier.ApplyCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource SaveButton}"
                                                ToolTip="确认修改"
                                                Visibility="{Binding Modifier.CanConfirm, Converter={StaticResource Boolean2VisibilityConverter}, RelativeSource={RelativeSource TemplatedParent}}" />

                                            <Button
                                                Command="{Binding Modifier.ResetCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource ResetButton}"
                                                ToolTip="还原"
                                                Visibility="{Binding Modifier.CanReset, Converter={StaticResource Boolean2VisibilityConverter}, RelativeSource={RelativeSource TemplatedParent}}" />

                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!--  🔑 状态驱动触发器  -->
                            <ControlTemplate.Triggers>

                                <Trigger Property="Header" Value="{x:Null}">
                                    <Setter TargetName="headerPanel" Property="Visibility" Value="Collapsed" />
                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="clpanel" Property="Visibility" Value="Visible" />
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style TargetType="TextBox">
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="1" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style BasedOn="{StaticResource ComboBox.Small}" TargetType="ComboBox">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <Style BasedOn="{StaticResource DatePicker.Small}" TargetType="DatePicker">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <SolidColorBrush x:Key="LabelBrush">Gray</SolidColorBrush>

            <Thickness
                x:Key="LineSpacing"
                Bottom="2"
                Left="0"
                Right="0"
                Top="2" />





        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,10">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">

            <shared:TwoColumnPanel ColumnSpacing="20" ItemSpacing="15">

                <!--#region 基本要素-->
                <DockPanel>
                    <Border Margin="0,0,10,0" Background="Green">
                        <TextBlock Style="{StaticResource CategoryTab}" Text="基本要素" />
                    </Border>

                    <StackPanel>
                        <shared:ModifiableControl
                            EditTemplate="{StaticResource DT.TextBox.Center}"
                            Header="基金全称"
                            Modifier="{Binding FullName}" />


                        <DockPanel>
                            <shared:ModifiableControl
                                MinWidth="300"
                                EditTemplate="{StaticResource DT.TextBox.Center}"
                                Header="基金简称"
                                Modifier="{Binding ShortName}" />

                            <shared:ModifiableControl
                                Margin="10,0"
                                HorizontalAlignment="Left"
                                EditTemplate="{StaticResource DT.SecurityFundType}"
                                Header="基金类型"
                                Modifier="{Binding SecurityFundType}" />
                        </DockPanel>


                        <!--  风险等级 止损预警  -->
                        <DockPanel Margin="{StaticResource LineSpacing}" LastChildFill="False">

                            <shared:ModifiableControl
                                HorizontalAlignment="Left"
                                EditTemplate="{StaticResource DT.RiskLevel}"
                                Header="风险等级"
                                Modifier="{Binding RiskLevel}" />

                            <shared:ModifiableControl
                                Margin="20,0"
                                HorizontalAlignment="Left"
                                Header="存续期"
                                Modifier="{Binding DurationInMonths}" />


                            <shared:ModifiableControl
                                Margin="10,0"
                                HorizontalAlignment="Left"
                                EditTemplate="{StaticResource DT.ExpirationDate}"
                                Header="到期日"
                                Modifier="{Binding ExpirationDate}" />



                        </DockPanel>


                        <!--  开放日  -->
                        <hc:UniformSpacingPanel Margin="{StaticResource LineSpacing}" Spacing="10">

                            <shared:ModifiableControl
                                HorizontalAlignment="Left"
                                EditTemplate="{StaticResource DT.FundMode}"
                                Header="运作方式"
                                Modifier="{Binding FundModeInfo}" />

                            <shared:ModifiableControl
                                HorizontalAlignment="Left"
                                Header="封闭期"
                                Modifier="{Binding SealingRule}"
                                Visibility="{Binding DataContext.IsSealingFund, RelativeSource={RelativeSource AncestorType=local:ElementsView}, Converter={StaticResource Boolean2VisibilityReConverter}}" />


                            <shared:FactorModifiableControl
                                HorizontalAlignment="Left"
                                Header="锁定期"
                                Modifier="{Binding LockingRule}" />



                        </hc:UniformSpacingPanel>

                        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Foreground="Gray"
                                Text="基金份额" />

                            <Viewbox
                                Grid.Column="1"
                                Height="7.5"
                                VerticalAlignment="Top"
                                Visibility="{Binding IsSharesInherited, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <Path Data="{StaticResource f.arrow-turn-down}" Fill="Brown" />
                            </Viewbox>


                            <Button
                                hc:IconElement.Geometry="{StaticResource f.pencil}"
                                Command="{Binding ModifyInheritCommand}"
                                Style="{StaticResource ButtonIcon.Small}"
                                ToolTip="修改"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource Boolean2VisibilityReConverter}}" />


                            <ListBox
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                BorderThickness="0"
                                ItemsSource="{Binding Shares}"
                                Style="{StaticResource ListBoxCustom}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel IsItemsHost="True" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="5,0">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock x:Name="tb" Text=" ：" />
                                            <TextBlock
                                                x:Name="tb2"
                                                MinWidth="80"
                                                Text="{Binding Requirement}"
                                                TextWrapping="Wrap" />
                                        </DockPanel>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="1">
                                                <Setter TargetName="tb" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="tb2" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>

                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                        </DockPanel>
                    </StackPanel>
                </DockPanel>
                <!--#endregion-->


                <!--#region 投资相关-->
                <DockPanel>
                    <Border Margin="0,0,10,0" Background="Orange">
                        <TextBlock Style="{StaticResource CategoryTab}" Text="投资相关" />
                    </Border>

                    <hc:UniformSpacingPanel Orientation="Vertical" VerticalSpacing="5">

                        <DockPanel>

                            <shared:ModifiableControl
                                HorizontalAlignment="Left"
                                EditTemplate="{StaticResource DT.StopLine}"
                                Header="止损线"
                                Modifier="{Binding StopLine}" />

                            <shared:ModifiableControl
                                HorizontalAlignment="Left"
                                EditTemplate="{StaticResource DT.StopLine}"
                                Header="预警线"
                                Modifier="{Binding WarningLine}" />
                        </DockPanel>




                        <shared:ModifiableControl
                            HorizontalContentAlignment="Stretch"
                            EditTemplate="{StaticResource DT.LongText}"
                            Header="投资目标"
                            Modifier="{Binding InvestmentObjective}" />


                        <shared:ModifiableControl
                            HorizontalContentAlignment="Stretch"
                            EditTemplate="{StaticResource DT.LongText}"
                            Header="投资范围"
                            Modifier="{Binding InvestmentScope}" />

                        <Separator />

                        <shared:ModifiableControl
                            HorizontalContentAlignment="Stretch"
                            EditTemplate="{StaticResource DT.LongText}"
                            Header="投资策略"
                            Modifier="{Binding InvestmentStrategy}" />


                        <Separator />

                        <shared:ModifiableControl
                            HorizontalContentAlignment="Stretch"
                            EditTemplate="{StaticResource DT.LongText}"
                            Header="投资经理"
                            Modifier="{Binding InvestmentManager}" />

                        <!--<shared:ChangeableContainer
                                HorizontalContentAlignment="Stretch"
                                Binding="{Binding InvestmentObjective}"
                                ContentTemplate="{StaticResource DT.InvestmentObjective}" />

                            <shared:ChangeableContainer
                                HorizontalContentAlignment="Stretch"
                                Binding="{Binding InvestmentScope}"
                                ContentTemplate="{StaticResource DT.LongText}" />

                            <Border Margin="20,4">
                                <Line
                                    Stroke="Gray"
                                    StrokeDashArray="4,2"
                                    StrokeThickness="1"
                                    X1="0"
                                    X2="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=ActualWidth}"
                                    Y1="0"
                                    Y2="0" />
                            </Border>

                            <shared:ChangeableContainer
                                HorizontalContentAlignment="Stretch"
                                Binding="{Binding InvestmentStrategy}"
                                ContentTemplate="{StaticResource DT.LongText}" />

                            <Border Margin="20,4">
                                <Line
                                    Stroke="Gray"
                                    StrokeDashArray="4,2"
                                    StrokeThickness="1"
                                    X1="0"
                                    X2="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=ActualWidth}"
                                    Y1="0"
                                    Y2="0" />
                            </Border>

                            <shared:ChangeableContainer
                                HorizontalContentAlignment="Stretch"
                                Binding="{Binding InvestmentManagers}"
                                ContentTemplate="{StaticResource DT.LongText}" />-->
                    </hc:UniformSpacingPanel>
                </DockPanel>
                <!--#endregion-->


                <!--#region 费用相关-->
                <DockPanel>
                    <DockPanel.Resources>
                        <Style TargetType="Separator">
                            <Setter Property="Margin" Value="0,3" />
                        </Style>
                    </DockPanel.Resources>
                    <Border Margin="0,0,10,0" Background="Blue">
                        <TextBlock Style="{StaticResource CategoryTab}" Text="费用相关" />
                    </Border>

                    <StackPanel>


                        <shared:FactorModifiableControl
                            EditTemplate="{StaticResource DT.Fee}"
                            Header="管理费"
                            Modifier="{Binding ManageFee}" />

                        <shared:ModifiableControl
                            HorizontalAlignment="Left"
                            EditTemplate="{StaticResource DT.FeePay}"
                            Header="支付方式"
                            Modifier="{Binding ManageFeePay}" />

                        <Separator />

                        <shared:FactorModifiableControl
                            EditTemplate="{StaticResource DT.Subscription}"
                            Header="认购规则"
                            Modifier="{Binding SubscriptionRule}" />

                        <Separator />

                        <shared:FactorModifiableControl
                            EditTemplate="{StaticResource DT.Purchase}"
                            Header="申购规则"
                            Modifier="{Binding PurchasRule}" />

                        <Separator />


                        <shared:FactorModifiableControl
                            EditTemplate="{StaticResource DT.RedemptionFee}"
                            Header="赎回费"
                            Modifier="{Binding RedemptionFee}" />


                        <Separator />


                        <!--  费用  -->
                        <shared:ModifiableControl
                            HorizontalAlignment="Left"
                            EditTemplate="{StaticResource DT.Agency}"
                            Header="托管机构"
                            Modifier="{Binding TrusteeInfo}" />



                        <shared:ModifiableControl
                            HorizontalAlignment="Left"
                            EditTemplate="{StaticResource DT.Agency}"
                            Header="外包机构"
                            Modifier="{Binding OutsourcingInfo}" />



                    </StackPanel>



                </DockPanel>
                <!--#endregion-->


                <DockPanel>

                    <Border Margin="0,0,10,0" Background="SandyBrown">
                        <TextBlock Style="{StaticResource CategoryTab}" Text="业绩报酬" />
                    </Border>

                    <StackPanel>
                        <shared:ModifiableControl
                            Margin="0,0,30,0"
                            HorizontalContentAlignment="Stretch"
                            Header="业绩比较基准"
                            Modifier="{Binding PerformanceBenchmark}" />


                        <!--<shared:FactorModifiableControl
                                EditTemplate="{StaticResource DT.LongText}"
                                Header="业绩报酬"
                                Modifier="{Binding PerformanceFeeStatement}" />-->

                        <shared:ModifiableControl
                            HorizontalAlignment="Left"
                            Header="业绩报酬规则"
                            Modifier="{Binding PerformanceFeeRule}"
                            Visibility="{Binding HasPerformanceFeeStandard, Converter={StaticResource Boolean2VisibilityConverter}}" />

                        <Separator Margin="70,4" Visibility="{Binding IsReadOnly, Converter={StaticResource Boolean2VisibilityReConverter}}" />

                        <shared:FactorModifiableControl Header="业绩报酬标准" Modifier="{Binding PerformanceFeeStandard}" />
                    </StackPanel>

                </DockPanel>


                <!--#region 申赎相关-->
                <DockPanel>
                    <Border Margin="0,0,10,0" Background="Orange">
                        <TextBlock Style="{StaticResource CategoryTab}" Text="申赎相关" />
                    </Border>
                    <StackPanel>

                        <shared:FactorModifiableControl
                            ContentTemplate="{StaticResource DT.OpenRules}"
                            Header="开放规则"
                            Modifier="{Binding FundOpenRule}" />


                        <shared:FactorModifiableControl
                            HorizontalAlignment="Left"
                            Header="临时开放"
                            Modifier="{Binding TemporarilyOpenInfo}" />


                        <!--  巨额赎回  -->

                        <shared:ModifiableControl
                            HorizontalAlignment="Left"
                            Header="巨额赎回"
                            Modifier="{Binding HugeRedemption}" />



                        <!--  冷静期  -->
                        <shared:ModifiableControl
                            HorizontalAlignment="Left"
                            Header="冷静期"
                            Modifier="{Binding CoolingPeriod}" />


                        <!--  回访  -->
                        <shared:ModifiableControl
                            HorizontalAlignment="Left"
                            Header="回访"
                            Modifier="{Binding Callback}" />


                    </StackPanel>
                </DockPanel>
                <!--#endregion-->


                <!--  募集账户  -->

                <shared:ModifiableControl
                    HorizontalAlignment="Left"
                    Header="募集账户"
                    Modifier="{Binding CollectionAccount}"
                    Style="{StaticResource Modifiable.Bank}" />


                <!--  托管账户  -->

                <shared:ModifiableControl
                    HorizontalAlignment="Left"
                    Header="托管账户"
                    Modifier="{Binding CustodyAccount}"
                    Style="{StaticResource Modifiable.Bank}" />







            </shared:TwoColumnPanel>



        </ScrollViewer>
        <!--  编辑/查看  -->
        <DockPanel
            Margin="10,-25"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <DockPanel.Resources>

                <Style x:Key="RainbowGlowIconButton" TargetType="Button">
                    <Setter Property="Background" Value="{DynamicResource RegionBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Width" Value="28" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="hc:IconElement.Width" Value="14" />
                    <Setter Property="hc:IconElement.Height" Value="14" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="UseLayoutRounding" Value="True" />

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid ClipToBounds="False">

                                    <!--  🔵 外层彩虹光圈 (收紧光晕)  -->
                                    <Border
                                        x:Name="RainbowRing"
                                        Margin="-2"
                                        CacheMode="BitmapCache"
                                        CornerRadius="1000"
                                        Opacity="0.85"
                                        RenderTransformOrigin="0.5,0.5">

                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            RepeatBehavior="Forever"
                                                            Storyboard.TargetProperty="RenderTransform.Angle"
                                                            From="0"
                                                            To="360"
                                                            Duration="0:0:4" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>

                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0.00" Color="#FF0055" />
                                                <GradientStop Offset="0.14" Color="#FF7F00" />
                                                <GradientStop Offset="0.28" Color="#FFFF00" />
                                                <GradientStop Offset="0.42" Color="#00FF00" />
                                                <GradientStop Offset="0.57" Color="#00FFFF" />
                                                <GradientStop Offset="0.71" Color="#0000FF" />
                                                <GradientStop Offset="0.85" Color="#8B00FF" />
                                                <GradientStop Offset="1.00" Color="#FF0055" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <BlurEffect Radius="3" RenderingBias="Performance" />
                                        </Border.Effect>
                                    </Border>

                                    <!--  ⚪ 内层按钮主体 (紧凑贴合)  -->
                                    <Border
                                        x:Name="InnerBorder"
                                        Margin="4"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="1000"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Viewbox
                                            Width="{TemplateBinding hc:IconElement.Width}"
                                            Height="{TemplateBinding hc:IconElement.Height}"
                                            Stretch="Uniform">
                                            <Path
                                                Data="{Binding Path=(hc:IconElement.Geometry), RelativeSource={RelativeSource TemplatedParent}}"
                                                Fill="{TemplateBinding Foreground}"
                                                Stretch="Uniform" />
                                        </Viewbox>
                                    </Border>
                                </Grid>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RainbowRing" Property="Opacity" Value="1" />
                                        <Setter TargetName="RainbowRing" Property="Effect">
                                            <Setter.Value>
                                                <!--  悬停时稍微增强一点，但依然保持紧凑  -->
                                                <BlurEffect Radius="5" RenderingBias="Performance" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="InnerBorder" Property="Background" Value="{DynamicResource SecondaryRegionBrush}" />
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="InnerBorder" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>

                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="RainbowRing" Property="Opacity" Value="0.25" />
                                        <Setter TargetName="InnerBorder" Property="Opacity" Value="0.5" />
                                        <Setter TargetName="RainbowRing" Property="Effect">
                                            <Setter.Value>
                                                <BlurEffect Radius="1" RenderingBias="Performance" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

            </DockPanel.Resources>


            <Button
                Margin="10,0"
                hc:IconElement.Geometry="{StaticResource f.audible}"
                Command="{Binding GenerateBrochureCommand}"
                Style="{StaticResource RainbowGlowIconButton}"
                Visibility="{Binding IsReadOnly, Converter={StaticResource Boolean2VisibilityConverter}}" />

            <Button
                hc:IconElement.Geometry="{StaticResource f.floppy-disk}"
                Command="{Binding SaveCommand}"
                Style="{StaticResource ButtonIcon}"
                Visibility="{Binding IsReadOnly, Converter={StaticResource Boolean2VisibilityReConverter}}" />
            <ToggleButton IsChecked="{Binding IsReadOnly}" Style="{StaticResource ToggleButtonFlip}">
                <hc:StatusSwitchElement.CheckedElement>
                    <Viewbox Width="16" Height="16">
                        <Path Data="{StaticResource f.pen}" Fill="Green" />
                    </Viewbox>
                </hc:StatusSwitchElement.CheckedElement>
                <Viewbox Width="18" Height="18">
                    <Path Data="{StaticResource f.eye}" Fill="Black" />
                </Viewbox>
            </ToggleButton>
        </DockPanel>
    </Grid>
</UserControl>
