<UserControl
    x:Class="FMO.FundAccountsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:componentmodel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:FMO.Models;assembly=Models"
    xmlns:shared="clr-namespace:FMO.Shared;assembly=SharedUI"
    d:DataContext="{d:DesignInstance Type=local:FundAccountsViewModel}"
    d:DesignHeight="1450"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>


        <DataTemplate DataType="{x:Type local:SecurityCardViewModel}">

            <Border
                Width="160"
                Margin="2,0"
                Background="WhiteSmoke"
                BorderBrush="{Binding GroupBrush}"
                BorderThickness="0,0,0,4">
                <DockPanel Margin="6">
                    <DockPanel
                        Margin="0,6"
                        HorizontalAlignment="Center"
                        DockPanel.Dock="Bottom"
                        LastChildFill="False">
                        <DockPanel.Resources>
                            <Style BasedOn="{StaticResource ButtonIcon}" TargetType="Button">
                                <Setter Property="Height" Value="20" />
                                <Setter Property="Width" Value="34" />
                                <Setter Property="Padding" Value="6,1" />
                                <Setter Property="hc:IconElement.Height" Value="16" />
                            </Style>
                        </DockPanel.Resources>

                        <Button
                            Margin="-5"
                            hc:IconElement.Geometry="{DynamicResource f.book-open-reader}"
                            Command="{Binding ViewCommand}"
                            Foreground="Lime"
                            ToolTip="查看" />
                        <Button
                            Margin="-5"
                            hc:IconElement.Geometry="{DynamicResource f.file-export}"
                            Command="{Binding SaveAsCommand}"
                            ToolTip="另存为" />

                        <Button hc:IconElement.Geometry="{StaticResource f.flag}" Command="{Binding SetGroupCommand}" />

                        <Button
                            Name="switch"
                            Margin="-5"
                            hc:IconElement.Geometry="{DynamicResource f.eraser}"
                            Command="{Binding DeregisterCommand}"
                            Foreground="Red"
                            ToolTip="注销/恢复" />
                    </DockPanel>

                    <Grid DockPanel.Dock="Bottom">
                        <TextBlock
                            Margin="0,3,0,0"
                            HorizontalAlignment="Center"
                            Foreground="Gray"
                            Text="{Binding Date, StringFormat=yyyy-MM-dd}" />
                        <Popup
                            AllowsTransparency="True"
                            IsOpen="{Binding ShowGroupPop}"
                            StaysOpen="False">
                            <Border>
                                <ListBox
                                    ItemsSource="{x:Static local:SecurityCardViewModel.GroupBrushes}"
                                    SelectedIndex="{Binding Group}"
                                    SelectedItem="{Binding GroupBrush}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" Rows="3" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle
                                                Width="20"
                                                Height="20"
                                                Fill="{Binding .}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>


                    <DockPanel HorizontalAlignment="Center" LastChildFill="False">
                        <TextBlock
                            Name="card"
                            HorizontalAlignment="Center"
                            shared:MaskService.IsMask="True"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="{Binding CardNo}" />
                        <Button
                            hc:IconElement.Geometry="{DynamicResource f.copy}"
                            Command="{Binding CopyCommand}"
                            Foreground="RoyalBlue"
                            Style="{StaticResource ButtonIcon.Small}"
                            ToolTip="复制账号" />
                    </DockPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDeregistered}" Value="True">
                    <Setter TargetName="card" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="card" Property="Foreground" Value="Gray" />
                    <Setter TargetName="switch" Property="hc:IconElement.Geometry" Value="{StaticResource f.reply}" />
                    <Setter TargetName="switch" Property="Foreground" Value="Black" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:SecurityCardChangeViewModel}">
            <hc:SimplePanel>
                <Border Margin="2,1" Background="WhiteSmoke">
                    <DockPanel Margin="6">

                        <DockPanel Margin="6,0,0,0">
                            <TextBlock
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Bottom"
                                FontSize="14"
                                Text="{Binding Date, StringFormat=MM/dd}" />
                            <TextBlock
                                FontSize="18"
                                FontWeight="Black"
                                Text="{Binding Date.Year, Mode=OneWay}" />
                        </DockPanel>

                        <UniformGrid
                            Margin="8,0,0,0"
                            HorizontalAlignment="Center"
                            DockPanel.Dock="Bottom">
                            <UniformGrid.Resources>
                                <Style BasedOn="{StaticResource ButtonIcon.Small}" TargetType="Button">
                                    <Setter Property="Margin" Value="-5" />
                                </Style>
                            </UniformGrid.Resources>

                            <Button
                                hc:IconElement.Geometry="{DynamicResource f.book-open-reader}"
                                Command="{Binding ViewCommand}"
                                Foreground="Lime"
                                ToolTip="查看" />
                            <Button
                                Name="switch"
                                hc:IconElement.Geometry="{DynamicResource f.eraser}"
                                Command="{Binding DeregisterCommand}"
                                Foreground="Red"
                                ToolTip="注销/恢复" />
                            <Button
                                hc:IconElement.Geometry="{DynamicResource f.file-export}"
                                Command="{Binding SaveAsCommand}"
                                ToolTip="另存为" />

                        </UniformGrid>

                        <!--<TextBlock
                            Name="card"
                            Margin="0,8"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold">
                            <Run FontSize="18" Text="{Binding Date.Year, Mode=OneWay}" />
                            <Run Foreground="Gray" Text="/" />
                            <Run FontSize="16" Text="{Binding Date.Month, Mode=OneWay}" />
                            <Run Foreground="Gray" Text="/" />
                            <Run FontSize="16" Text="{Binding Date.Day, Mode=OneWay}" />
                        </TextBlock>-->
                    </DockPanel>
                </Border>

                <Viewbox
                    Width="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Visibility="{Binding MaybeError, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <Path Data="{StaticResource f.circle-exclamation}" Fill="Red" />
                </Viewbox>
            </hc:SimplePanel>
            <DataTemplate.Triggers>
                <!--<DataTrigger Binding="{Binding IsDeregistered}" Value="True">
                    <Setter TargetName="card" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="card" Property="Foreground" Value="Gray" />
                </DataTrigger>-->
            </DataTemplate.Triggers>
        </DataTemplate>



        <Style x:Key="EventExpander" TargetType="Expander">
            <Setter Property="BorderBrush" Value="LightGray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <DockPanel LastChildFill="True">
                                <!--  标题区域（无箭头）  -->
                                <ToggleButton
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Background="#eeeeee"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    DockPanel.Dock="Top"
                                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="OverridesDefaultStyle" Value="True" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}">
                                                            <ContentPresenter
                                                                Margin="3,2"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>

                                <!--  展开内容区域  -->
                                <ContentPresenter
                                    x:Name="ExpandSite"
                                    DockPanel.Dock="Bottom"
                                    Visibility="Collapsed" />
                            </DockPanel>
                        </Border>

                        <!--  触发展开/折叠动画  -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="EventModifier"
            BasedOn="{StaticResource {x:Type shared:ModifiableControl}}"
            TargetType="shared:ModifiableControl">
            <Setter Property="IsReadOnly" Value="{Binding IsReadOnly}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <shared:CopyableTextBlock IsMasked="True" Text="{Binding}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="EditTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBox
                            Padding="5,0"
                            VerticalContentAlignment="Center"
                            BorderThickness="0"
                            Style="{StaticResource TextBox.Small}"
                            Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=200}"
                            TextWrapping="WrapWithOverflow" />

                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <DataTemplate DataType="{x:Type local:AccountCredentialEventViewModel}">

            <Border
                Background="Transparent"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <ToggleButton
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                        Style="{StaticResource ToggleButtonCustom}">
                        <DockPanel>
                            <Button
                                x:Name="del"
                                hc:IconElement.Geometry="{StaticResource f.trash}"
                                Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.DeleteEventCommand}"
                                CommandParameter="{Binding .}"
                                DockPanel.Dock="Right"
                                Foreground="Red"
                                Style="{StaticResource ButtonIcon.Small}"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource Boolean2VisibilityReConverter}}" />


                            <TextBlock
                                Margin="3,0"
                                Padding="4"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{Binding Name}" />

                            <ToggleButton
                                IsChecked="{Binding IsReadOnly, Converter={StaticResource Boolean2BooleanReConverter}}"
                                Style="{StaticResource ToggleEditable}"
                                Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityConverter}, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />

                            <shared:CopyableTextBlock
                                Margin="15,0,0,0"
                                shared:MaskService.IsMask="True"
                                Text="{Binding Account.OldValue}"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource Boolean2VisibilityConverter}}" />


                        </DockPanel>
                    </ToggleButton>



                    <StackPanel Margin="4,0" Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Converter={StaticResource Boolean2VisibilityConverter}}">

                        <Separator />

                        <UniformGrid Rows="1">
                            <DockPanel>
                                <TextBlock FontSize="14" Text="原始材料" />
                                <Button
                                    hc:IconElement.Geometry="{StaticResource f.folder}"
                                    Command="{Binding OpenRawFolderCommand}"
                                    Style="{StaticResource ButtonIcon.Small}" />
                            </DockPanel>


                            <DockPanel>
                                <TextBlock FontSize="14" Text="用印文件" />
                                <Button
                                    hc:IconElement.Geometry="{StaticResource f.folder}"
                                    Command="{Binding OpenSealFolderCommand}"
                                    Style="{StaticResource ButtonIcon.Small}" />
                            </DockPanel>
                        </UniformGrid>




                        <shared:ModifiableControl
                            Header="资金账号"
                            Modifier="{Binding Account}"
                            Style="{StaticResource EventModifier}" />

                        <shared:ModifiableControl
                            Header="交易密码"
                            Modifier="{Binding Password}"
                            Style="{StaticResource EventModifier}" />




                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>



        <DataTemplate DataType="{x:Type local:BasicAccountViewModel}">
            <Border
                Background="Transparent"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <ToggleButton
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                        Style="{StaticResource ToggleButtonCustom}">
                        <DockPanel>
                            <Button
                                x:Name="del"
                                hc:IconElement.Geometry="{StaticResource f.trash}"
                                Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.DeleteEventCommand}"
                                CommandParameter="{Binding .}"
                                DockPanel.Dock="Right"
                                Foreground="Red"
                                Style="{StaticResource ButtonIcon.Small}"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource Boolean2VisibilityReConverter}}" />


                            <TextBlock
                                Margin="3,0"
                                Padding="4"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{Binding Name}" />

                            <ToggleButton
                                IsChecked="{Binding IsReadOnly, Converter={StaticResource Boolean2BooleanReConverter}}"
                                Style="{StaticResource ToggleEditable}"
                                Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityConverter}, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />

                            <shared:CopyableTextBlock
                                Margin="15,0,0,0"
                                shared:MaskService.IsMask="True"
                                Text="{Binding Account.OldValue}"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource Boolean2VisibilityConverter}}" />


                        </DockPanel>
                    </ToggleButton>



                    <StackPanel Margin="4,0" Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Converter={StaticResource Boolean2VisibilityConverter}}">

                        <Separator />

                        <UniformGrid Rows="1">
                            <DockPanel>
                                <TextBlock FontSize="14" Text="原始材料" />
                                <Button
                                    hc:IconElement.Geometry="{StaticResource f.folder}"
                                    Command="{Binding OpenRawFolderCommand}"
                                    Style="{StaticResource ButtonIcon.Small}" />
                            </DockPanel>


                            <DockPanel>
                                <TextBlock FontSize="14" Text="用印文件" />
                                <Button
                                    hc:IconElement.Geometry="{StaticResource f.folder}"
                                    Command="{Binding OpenSealFolderCommand}"
                                    Style="{StaticResource ButtonIcon.Small}" />
                            </DockPanel>
                        </UniformGrid>

                        <shared:FileView
                            Width="220"
                            HorizontalAlignment="Left"
                            Content="{Binding BankLetter}"
                            Header="银行关联函"
                            IsReadOnly="{Binding IsReadOnly}" />

                        <shared:FileView
                            Width="220"
                            HorizontalAlignment="Left"
                            Content="{Binding ServiceAgreement}"
                            Header="经服协议"
                            IsReadOnly="{Binding IsReadOnly}" />


                        <shared:ModifiableControl
                            Header="资金账号"
                            Modifier="{Binding Account}"
                            Style="{StaticResource EventModifier}" />


                        <UniformGrid Rows="1">
                            <shared:ModifiableControl
                                Header="交易密码"
                                Modifier="{Binding TradePassword}"
                                Style="{StaticResource EventModifier}" />

                            <shared:ModifiableControl
                                Header="资金密码"
                                Modifier="{Binding CapitalPassword}"
                                Style="{StaticResource EventModifier}" />
                        </UniformGrid>



                    </StackPanel>
                </StackPanel>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="基本账户">
                    <Setter TargetName="del" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <Style x:Key="AccountEventList" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Width" Value="300" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>




        <DataTemplate x:Key="StockItem" DataType="local:StockAccountViewModel">
            <Border
                Margin="2,0"
                Background="WhiteSmoke"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="8">
                <hc:SimplePanel>
                    <hc:Watermark
                        FontSize="50"
                        FontWeight="Bold"
                        Mark="已注销"
                        MarkMargin="30,0"
                        Visibility="{Binding IsClosed, Converter={StaticResource Boolean2VisibilityConverter}}" />

                    <StackPanel>
                        <!--  Company  -->
                        <Border Background="RoyalBlue" CornerRadius="8,8,0,0">
                            <hc:SimplePanel>
                                <TextBlock
                                    Margin="10,4"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Style="{StaticResource TextBlockDefaultBold}"
                                    Text="{Binding Company}" />

                                <ToggleButton
                                    x:Name="close"
                                    Margin="5,0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CloseCommand}"
                                    Content="注销"
                                    DockPanel.Dock="Right"
                                    IsChecked="{Binding IsClosed}"
                                    Style="{StaticResource ToggleButtonDanger.Small}"
                                    Visibility="Collapsed" />

                            </hc:SimplePanel>
                        </Border>

                        <!--#region 股卡-->
                        <DockPanel>
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Text="上证股卡" />
                            <ToggleButton
                                x:Name="sh"
                                Width="22"
                                Padding="2"
                                hc:IconElement.Geometry="{StaticResource f.connect}"
                                Background="Transparent"
                                BorderThickness="0"
                                Style="{StaticResource ToggleButtonIcon}"
                                Visibility="{Binding SHCardConnected, Converter={StaticResource Boolean2VisibilityReConverter}}" />

                            <Button
                                hc:IconElement.Geometry="{StaticResource f.disconnect}"
                                Command="{Binding DisconnectSHCommand}"
                                Foreground="Red"
                                Style="{StaticResource ButtonIcon.Small}"
                                Visibility="{Binding SHCardConnected, Converter={StaticResource Boolean2VisibilityConverter}}" />

                            <shared:CopyableTextBlock
                                Margin="8,0,2,0"
                                VerticalAlignment="Center"
                                FontWeight="Black"
                                Text="{Binding SHCard}" />

                            <Popup
                                AllowsTransparency="True"
                                IsOpen="{Binding IsChecked, ElementName=sh}"
                                Placement="Right"
                                PlacementTarget="{Binding ElementName=sh}"
                                StaysOpen="False">
                                <Border>
                                    <DockPanel>
                                        <ListBox
                                            DisplayMemberPath="CardNo"
                                            ItemsPanel="{StaticResource WrapHorizontalItemsPanelTemplate}"
                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:FundAccountsView}, Path=DataContext.SHSecurityCardSource.View}"
                                            SelectedItem="{Binding NewSHCard}"
                                            Style="{StaticResource ListBox.Small}" />

                                        <Button
                                            Margin="4,0"
                                            Command="{Binding ConfirmSHCardCommand}"
                                            Content="确认"
                                            Style="{StaticResource ButtonPrimary}" />
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </DockPanel>

                        <DockPanel>
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Text="深证股卡" />
                            <ToggleButton
                                x:Name="sz"
                                Width="22"
                                Padding="2"
                                hc:IconElement.Geometry="{StaticResource f.connect}"
                                Background="Transparent"
                                BorderThickness="0"
                                Style="{StaticResource ToggleButtonIcon}"
                                Visibility="{Binding SZCardConnected, Converter={StaticResource Boolean2VisibilityReConverter}}" />

                            <Button
                                hc:IconElement.Geometry="{StaticResource f.disconnect}"
                                Command="{Binding DisconnectSZCommand}"
                                Foreground="Red"
                                Style="{StaticResource ButtonIcon.Small}"
                                Visibility="{Binding SZCardConnected, Converter={StaticResource Boolean2VisibilityConverter}}" />

                            <shared:CopyableTextBlock
                                Margin="8,0,2,0"
                                VerticalAlignment="Center"
                                FontWeight="Black"
                                Text="{Binding SZCard}" />


                            <Popup
                                AllowsTransparency="True"
                                IsOpen="{Binding IsChecked, ElementName=sz}"
                                Placement="Right"
                                PlacementTarget="{Binding ElementName=sz}"
                                StaysOpen="False">
                                <Border>
                                    <DockPanel>
                                        <ListBox
                                            DisplayMemberPath="CardNo"
                                            ItemsPanel="{StaticResource WrapHorizontalItemsPanelTemplate}"
                                            ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=local:FundAccountsView}, Path=DataContext.SZSecurityCardSource.View}"
                                            SelectedItem="{Binding NewSZCard}"
                                            Style="{StaticResource ListBox.Small}" />

                                        <Button
                                            Margin="4,0"
                                            Command="{Binding ConfirmSZCardCommand}"
                                            Content="确认"
                                            Style="{StaticResource ButtonPrimary}" />
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </DockPanel>
                        <!--#endregion-->

                        <DockPanel
                            Margin="5,0"
                            DockPanel.Dock="Top"
                            LastChildFill="False">


                            <!--  Event  -->
                            <Button
                                Command="{Binding AddCreditCommand}"
                                Content="信用"
                                Style="{StaticResource ButtonDefault.Small}" />

                            <Button
                                Command="{Binding AddQMTCommand}"
                                Content="QMT"
                                Style="{StaticResource ButtonDefault.Small}" />

                        </DockPanel>


                        <ListBox
                            Margin="0,0,0,5"
                            VerticalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource AccountEventList}"
                            ItemsSource="{Binding Events}"
                            Style="{StaticResource ListBoxCustom}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                    </StackPanel>
                </hc:SimplePanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="close" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>



        <DataTemplate DataType="{x:Type local:FutureOpenAccountViewModel}">
            <Border
                Background="Transparent"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <ToggleButton
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                        Style="{StaticResource ToggleButtonCustom}">
                        <DockPanel>
                            <Button
                                x:Name="del"
                                hc:IconElement.Geometry="{StaticResource f.trash}"
                                Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.DeleteEventCommand}"
                                CommandParameter="{Binding .}"
                                DockPanel.Dock="Right"
                                Foreground="Red"
                                Style="{StaticResource ButtonIcon.Small}"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource Boolean2VisibilityReConverter}}" />


                            <TextBlock
                                Margin="3,0"
                                Padding="4"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{Binding Name}" />

                            <ToggleButton
                                IsChecked="{Binding IsReadOnly, Converter={StaticResource Boolean2BooleanReConverter}}"
                                Style="{StaticResource ToggleEditable}"
                                Visibility="{Binding IsSelected, Converter={StaticResource Boolean2VisibilityConverter}, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />


                            <shared:CopyableTextBlock
                                Margin="15,0,0,0"
                                shared:MaskService.IsMask="True"
                                Text="{Binding Account.OldValue}"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource Boolean2VisibilityConverter}}" />


                        </DockPanel>
                    </ToggleButton>



                    <StackPanel Margin="4,0" Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Converter={StaticResource Boolean2VisibilityConverter}}">

                        <Separator />

                        <UniformGrid Rows="1">
                            <DockPanel>


                                <TextBlock FontSize="14" Text="原始材料" />

                                <Button
                                    hc:IconElement.Geometry="{StaticResource f.wand-magic}"
                                    Command="{Binding GenerateOpenAccountFilesCommand}"
                                    Content="生成"
                                    Foreground="Orange"
                                    Style="{StaticResource ButtonIcon.Small}" />

                                <Button
                                    hc:IconElement.Geometry="{StaticResource f.folder}"
                                    Command="{Binding OpenRawFolderCommand}"
                                    Style="{StaticResource ButtonIcon.Small}" />
                            </DockPanel>


                            <DockPanel>
                                <TextBlock FontSize="14" Text="用印文件" />
                                <Button
                                    hc:IconElement.Geometry="{StaticResource f.folder}"
                                    Command="{Binding OpenSealFolderCommand}"
                                    Style="{StaticResource ButtonIcon.Small}" />
                            </DockPanel>
                        </UniformGrid>

                        <shared:FileView
                            Width="220"
                            HorizontalAlignment="Left"
                            Content="{Binding BankLetter}"
                            Header="银行关联函"
                            IsReadOnly="{Binding IsReadOnly}" />

                        <shared:FileView
                            Width="220"
                            HorizontalAlignment="Left"
                            Content="{Binding ServiceAgreement}"
                            Header="经服协议"
                            IsReadOnly="{Binding IsReadOnly}" />

                        <shared:FileView
                            Width="220"
                            HorizontalAlignment="Left"
                            Content="{Binding AccountLetter}"
                            Header="账户信息函"
                            IsReadOnly="{Binding IsReadOnly}" />

                        <shared:ModifiableControl
                            Header="资金账号"
                            Modifier="{Binding Account}"
                            Style="{StaticResource EventModifier}" />

                        <UniformGrid Rows="1">
                            <shared:ModifiableControl
                                Header="交易密码"
                                Modifier="{Binding TradePassword}"
                                Style="{StaticResource EventModifier}" />

                            <shared:ModifiableControl
                                Header="资金密码"
                                Modifier="{Binding CapitalPassword}"
                                Style="{StaticResource EventModifier}" />
                        </UniformGrid>



                    </StackPanel>
                </StackPanel>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="基本账户">
                    <Setter TargetName="del" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <DataTemplate x:Key="FutureItem" DataType="local:FutureAccountViewModel">
            <Border
                Margin="2,0"
                Background="WhiteSmoke"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="8">
                <hc:SimplePanel>
                    <hc:Watermark
                        FontSize="50"
                        FontWeight="Bold"
                        Mark="已注销"
                        MarkMargin="30,0"
                        Visibility="{Binding IsClosed, Converter={StaticResource Boolean2VisibilityConverter}}" />

                    <StackPanel>
                        <!--  Company  -->
                        <Border Background="RoyalBlue" CornerRadius="8,8,0,0">
                            <hc:SimplePanel>
                                <TextBlock
                                    Margin="10,4"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Style="{StaticResource TextBlockDefaultBold}"
                                    Text="{Binding Company}" />

                                <ToggleButton
                                    x:Name="close"
                                    Margin="5,0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CloseCommand}"
                                    Content="注销"
                                    DockPanel.Dock="Right"
                                    IsChecked="{Binding IsClosed}"
                                    Style="{StaticResource ToggleButtonDanger.Small}"
                                    Visibility="Collapsed" />

                            </hc:SimplePanel>
                        </Border>


                        <!--<DockPanel
                            Margin="5,0"
                            DockPanel.Dock="Top"
                            LastChildFill="False">


                        -->
                        <!--  Event  -->
                        <!--

                            <Button
                                Command="{Binding AddQMTCommand}"
                                Content="QMT"
                                Style="{StaticResource ButtonDefault.Small}" />

                        </DockPanel>-->


                        <ListBox
                            Margin="0,0,0,5"
                            VerticalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource AccountEventList}"
                            ItemsSource="{Binding Events}"
                            Style="{StaticResource ListBoxCustom}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                    </StackPanel>
                </hc:SimplePanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="close" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>



        <ItemsPanelTemplate x:Key="SecurityCardPanel">
            <WrapPanel IsItemsHost="True" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="SecurityCardChangePanel">
            <WrapPanel IsItemsHost="True" Orientation="Vertical" />
        </ItemsPanelTemplate>


        <ItemsPanelTemplate x:Key="StockAccountPanel">
            <hc:UniformSpacingPanel
                IsItemsHost="True"
                Orientation="Horizontal"
                VerticalSpacing="6" />
        </ItemsPanelTemplate>


        <ItemsPanelTemplate x:Key="FutureAccountPanel">
            <hc:UniformSpacingPanel IsItemsHost="True" VerticalSpacing="6" />
        </ItemsPanelTemplate>


    </UserControl.Resources>
    <DockPanel Margin="10,10,0,10">

        <UniformGrid
            DataContext="{Binding Singleton}"
            DockPanel.Dock="Top"
            Rows="1">
