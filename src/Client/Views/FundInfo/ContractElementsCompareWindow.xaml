<Window
    x:Class="FMO.ContractElementsCompareWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:FMO.Shared;assembly=SharedUI"
    Title="AI 合同要素解析结果"
    Width="1400"
    Height="800"
    d:DataContext="{d:DesignInstance Type=local:ContractElementsCompareViewModel}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <SolidColorBrush x:Key="LabelBrush">Gray</SolidColorBrush>

        <!--  分类标签  -->
        <Style x:Key="CategoryTab" TargetType="TextBlock">
            <Setter Property="MaxWidth" Value="22" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  字段名  -->
        <Style x:Key="FieldNameStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="105" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  新值：变化时红色  -->
        <Style x:Key="NewValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasChanged}" Value="True">
                    <Setter Property="Foreground" Value="Tomato" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  旧值：灰色小字  -->
        <Style x:Key="OldValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#999" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!--  标题  -->
        <TextBlock
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            FontSize="15"
            FontWeight="Bold"
            Text="合同要素对比（变化的要素以红色标注）" />

        <!--  份额信息  -->
        <DockPanel Margin="0,0,0,8" DockPanel.Dock="Top">
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="Gray"
                Text="份额：" />
            <ListBox
                BorderThickness="0"
                ItemsSource="{Binding ShareClasses}"
                Style="{StaticResource ListBoxCustom}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <hc:UniformSpacingPanel
                            ChildWrapping="Wrap"
                            IsItemsHost="True"
                            Spacing="6" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="：" />
                            <TextBlock Text="{Binding Requirement}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!--  解析警告  -->
        <Expander
            Margin="0,0,0,8"
            DockPanel.Dock="Top"
            Foreground="DarkOrange"
            Header="{Binding Warnings.Count, StringFormat='解析警告 ({0} 条)'}"
            IsExpanded="{Binding HasWarnings, Mode=OneWay}"
            Visibility="{Binding HasWarnings, Converter={StaticResource Boolean2VisibilityConverter}}">
            <ItemsControl Margin="8,4,0,0" ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Foreground="DarkOrange"
                            Text="{Binding}"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <shared:TwoColumnPanel>

                <!--  ==================== 基本要素 ====================  -->
                <DockPanel Margin="0,0,0,16">
                    <Border
                        Margin="0,0,10,0"
                        Background="#228B22"
                        CornerRadius="2">
                        <TextBlock Style="{StaticResource CategoryTab}" Text="基" />
                    </Border>
                    <StackPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding FullNameField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="基金全称"
                                ToolTip="基金全称" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding ShortNameField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="基金简称"
                                ToolTip="基金简称" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding SecurityFundTypeField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="证券基金类型"
                                ToolTip="证券基金类型" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding FundModeInfoField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="运作方式"
                                ToolTip="运作方式" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding SealingRuleField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="封闭期"
                                ToolTip="封闭期" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding RiskLevelField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="风险等级"
                                ToolTip="风险等级" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding DurationInMonthsField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="存续期"
                                ToolTip="存续期" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding ExpirationDateField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="到期日"
                                ToolTip="到期日" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding StopLineField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="止损线"
                                ToolTip="止损线" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding WarningLineField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="预警线"
                                ToolTip="预警线" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding LockingRuleField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="锁定期"
                                ToolTip="锁定期" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding StructureInfoField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="结构化信息"
                                ToolTip="结构化信息" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                    </StackPanel>
                </DockPanel>

                <!--  ==================== 投资相关 ====================  -->
                <DockPanel Margin="0,0,0,16">
                    <Border
                        Margin="0,0,10,0"
                        Background="#FF8C00"
                        CornerRadius="2">
                        <TextBlock Style="{StaticResource CategoryTab}" Text="投" />
                    </Border>
                    <StackPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding InvestmentObjectiveField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="投资目标"
                                ToolTip="投资目标" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding InvestmentScopeField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="投资范围"
                                ToolTip="投资范围" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding InvestmentStrategyField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="投资策略"
                                ToolTip="投资策略" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding InvestmentManagersField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="投资经理"
                                ToolTip="投资经理" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding PerformanceBenchmarkField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="业绩比较基准"
                                ToolTip="业绩比较基准" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                    </StackPanel>
                </DockPanel>

                <!--  ==================== 费用相关 ====================  -->
                <DockPanel Margin="0,0,0,16">
                    <Border
                        Margin="0,0,10,0"
                        Background="#4169E1"
                        CornerRadius="2">
                        <TextBlock Style="{StaticResource CategoryTab}" Text="费" />
                    </Border>
                    <StackPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding ManageFeeField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="管理费"
                                ToolTip="管理费" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding ManageFeePayField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="管理费支付方式"
                                ToolTip="管理费支付方式" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding SubscriptionRuleField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="认购规则"
                                ToolTip="认购规则" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding PurchasRuleField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="申购规则"
                                ToolTip="申购规则" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding RedemptionFeeField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="赎回费"
                                ToolTip="赎回费" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding TrusteeInfoField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="托管机构"
                                ToolTip="托管机构" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding OutsourcingInfoField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="外包机构"
                                ToolTip="外包机构" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                    </StackPanel>
                </DockPanel>

                <!--  ==================== 业绩报酬 ====================  -->
                <DockPanel Margin="0,0,0,16">
                    <Border
                        Margin="0,0,10,0"
                        Background="#D2691E"
                        CornerRadius="2">
                        <TextBlock Style="{StaticResource CategoryTab}" Text="绩" />
                    </Border>
                    <StackPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding PerformanceFeeStatementField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="业绩报酬说明"
                                ToolTip="业绩报酬说明" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding PerformanceFeeStandardField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="业绩报酬标准"
                                ToolTip="业绩报酬标准" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding PerformanceFeeRuleField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="业绩报酬规则"
                                ToolTip="业绩报酬规则" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                    </StackPanel>
                </DockPanel>

                <!--  ==================== 申赎相关 ====================  -->
                <DockPanel Margin="0,0,0,16">
                    <Border
                        Margin="0,0,10,0"
                        Background="#FF8C00"
                        CornerRadius="2">
                        <TextBlock Style="{StaticResource CategoryTab}" Text="申" />
                    </Border>
                    <StackPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding FundOpenRuleField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="开放日规则"
                                ToolTip="开放日规则" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding TemporarilyOpenInfoField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="临时开放"
                                ToolTip="临时开放" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding HugeRedemptionField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="巨额赎回"
                                ToolTip="巨额赎回" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding CoolingPeriodField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="冷静期"
                                ToolTip="冷静期" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding CallbackField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="回访"
                                ToolTip="回访" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                    </StackPanel>
                </DockPanel>

                <!--  ==================== 账户信息 ====================  -->
                <DockPanel Margin="0,0,0,16">
                    <Border
                        Margin="0,0,10,0"
                        Background="#8B4513"
                        CornerRadius="2">
                        <TextBlock Style="{StaticResource CategoryTab}" Text="账" />
                    </Border>
                    <StackPanel>

                        <DockPanel Margin="0,3" DataContext="{Binding CollectionAccountField}">
                            <TextBlock
                                Style="{StaticResource FieldNameStyle}"
                                Text="募集账户"
                                ToolTip="募集账户" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource NewValueStyle}" Text="{Binding NewDisplay}" />
                                <TextBlock
                                    Style="{StaticResource OldValueStyle}"
                                    Text="{Binding OldDisplay, StringFormat='旧: {0}'}"
                                    Visibility="{Binding HasChanged, Converter={StaticResource Boolean2VisibilityConverter}}" />
                            </StackPanel>
                        </DockPanel>

                    </StackPanel>
                </DockPanel>

            </shared:TwoColumnPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
