<UserControl
    x:Class="FMO.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:FMO.Shared;assembly=SharedUI"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <local:LogViewModel />
    </UserControl.DataContext>
    <Grid>
        <DataGrid
            local:InfiniteScrollExtension.Command="{Binding ScrollToEndCommand}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding CommonLogs}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            Style="{StaticResource DataGrid.Small}">


            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <shared:CopyableTextBlock
                        Margin="8"
                        Foreground="Black"
                        Text="{Binding Exception}" />
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Header="时间" />
                <DataGridTextColumn Binding="{Binding Caller}" Header="Method" />
                <DataGridTextColumn Binding="{Binding Message}" Header="Log" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
