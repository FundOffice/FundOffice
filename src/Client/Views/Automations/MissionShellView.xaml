<UserControl
    x:Class="FMO.MissionShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>



        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <sys:Boolean x:Key="Bool.True">True</sys:Boolean>
        <sys:Boolean x:Key="Bool.False">False</sys:Boolean>

        <sys:Double x:Key="TaskButtonSize">14</sys:Double>
        <sys:Double x:Key="TaskButtonSize2">18</sys:Double>


        <ControlTemplate x:Key="TaskRunTime" TargetType="ContentControl">
            <Grid>
                <Viewbox Width="{StaticResource TaskButtonSize}" Height="{StaticResource TaskButtonSize}">
                    <Path
                        x:Name="lb"
                        Data="{StaticResource f.angle-right}"
                        Fill="White" />
                </Viewbox>

                <Grid
                    VerticalAlignment="Center"
                    Background="{TemplateBinding Background}"
                    Visibility="{Binding IsActivated, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <ToggleButton
                        x:Name="toggle"
                        Width="{StaticResource TaskButtonSize}"
                        Height="{StaticResource TaskButtonSize}"
                        Padding="0"
                        VerticalContentAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource f.pen}"
                        Background="Transparent"
                        BorderThickness="0"
                        IsChecked="{Binding ManualSetNextRun}"
                        Style="{StaticResource ToggleButtonIcon}"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="toggle" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding ManualSetNextRun}" Value="True">

                    <Setter TargetName="lb" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>
    <UserControl.Template>
        <ControlTemplate TargetType="UserControl">

            <hc:SimplePanel
                MinWidth="300"
                Margin="2,4"
                Background="Transparent">
                <Border x:Name="tar" Height="0" />
                <Border
                    x:Name="border"
                    Background="Transparent"
                    BorderBrush="Green"
                    BorderThickness="2"
                    CornerRadius="5">
                    <DockPanel Margin="5">
                        <DockPanel Height="28" DockPanel.Dock="Top">

                            <hc:CircleProgressBar
                                Width="20"
                                Height="20"
                                DockPanel.Dock="Right"
                                IsIndeterminate="True"
                                ShowText="False"
                                Style="{StaticResource ProgressBarSuccessCircle}"
                                Visibility="{Binding IsWorking, Converter={StaticResource Boolean2VisibilityConverter}}" />


                            <Border
                                VerticalAlignment="Center"
                                Background="Orange"
                                CornerRadius="3">
                                <TextBlock Margin="3,1" Text="{Binding Id}" />
                            </Border>


                            <TextBlock
                                Margin="8,0"
                                VerticalAlignment="Center"
                                FontWeight="Black"
                                Text="{Binding Title}" />

                            <!--  Title  -->
                            <hc:SimplePanel>
                                <DockPanel x:Name="status" LastChildFill="False">

                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Foreground="Red"
                                        Text="未启动"
                                        Visibility="{Binding IsActivated, Converter={StaticResource Boolean2VisibilityReConverter}}" />

                                    <Border
                                        VerticalAlignment="Center"
                                        Background="LightGray"
                                        Visibility="{Binding IsActivated, Converter={StaticResource Boolean2VisibilityConverter}}">
                                        <DockPanel Margin="5,2">
                                            <Viewbox Height="14">
                                                <Path Data="{StaticResource f.angles-right}" Fill="Green" />
                                            </Viewbox>

                                            <TextBlock
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="{Binding NextRunTime, StringFormat=M/d HH:mm}" />
                                        </DockPanel>
                                    </Border>

                                </DockPanel>



                                <ContentControl
                                    x:Name="btns"
                                    ContentTemplate="{x:Null}"
                                    Visibility="Collapsed" />
                            </hc:SimplePanel>

                            <!--  Title  -->
                        </DockPanel>

                        <StackPanel x:Name="cont" Visibility="Collapsed">
                            <Border
                                x:Name="borderTime"
                                Background="LightGray"
                                IsEnabled="{Binding IsActivated}"
                                TextElement.Foreground="#666666">
                                <Border.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                    <Style
                                        x:Key="Style.Calendar"
                                        BasedOn="{StaticResource CalendarBaseStyle}"
                                        TargetType="Calendar">
                                        <Setter Property="Background" Value="Gray" />
                                    </Style>
                                </Border.Resources>
                                <UniformGrid
                                    Height="28"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Rows="1">
                                    <DockPanel Margin="0,2" Visibility="{Binding ManualSetNextRun, Converter={StaticResource Boolean2VisibilityReConverter}}">
                                        <Viewbox Width="{StaticResource TaskButtonSize}" Height="{StaticResource TaskButtonSize}">
                                            <Path Data="{StaticResource f.clock-rotate-left}" Fill="White" />
                                        </Viewbox>
                                        <TextBlock Text="{Binding LastRunTime, StringFormat=M/d HH:mm}" />
                                    </DockPanel>


                                    <DockPanel>
                                        <hc:SimplePanel x:Name="ng">
                                            <ContentControl Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}}" Template="{StaticResource TaskRunTime}" />

                                            <UniformGrid
                                                x:Name="btn"
                                                Width="50"
                                                Rows="1">
                                                <Button
                                                    Width="{StaticResource TaskButtonSize2}"
                                                    Height="{StaticResource TaskButtonSize2}"
                                                    Padding="0"
                                                    hc:IconElement.Geometry="{DynamicResource f.circle-check}"
                                                    Command="{Binding DoManualSetNextRunTimeCommand}"
                                                    CommandParameter="{StaticResource Bool.True}"
                                                    Foreground="White"
                                                    Style="{StaticResource ButtonIcon}"
                                                    Visibility="{Binding ManualSetNextRun, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Button
                                                    Width="{StaticResource TaskButtonSize2}"
                                                    Height="{StaticResource TaskButtonSize2}"
                                                    Padding="0"
                                                    hc:IconElement.Geometry="{DynamicResource f.ban}"
                                                    Command="{Binding DoManualSetNextRunTimeCommand}"
                                                    CommandParameter="{StaticResource Bool.False}"
                                                    Foreground="White"
                                                    Style="{StaticResource ButtonIcon}"
                                                    Visibility="{Binding ManualSetNextRun, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </UniformGrid>
                                        </hc:SimplePanel>
                                        <Grid>
                                            <UniformGrid
                                                Margin="5,0,0,0"
                                                Columns="1"
                                                Visibility="{Binding ManualSetNextRun, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <hc:DateTimePicker HorizontalContentAlignment="Center" SelectedDateTime="{Binding NextRunTime}" />
                                            </UniformGrid>

                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Text="{Binding NextRunTime, StringFormat=M/d HH:mm}"
                                                Visibility="{Binding ManualSetNextRun, Converter={StaticResource Boolean2VisibilityReConverter}}" />

                                        </Grid>
                                    </DockPanel>
                                </UniformGrid>
                            </Border>


                            <Separator />

                            <ContentPresenter
                                x:Name="content"
                                HorizontalAlignment="Stretch"
                                Content="{TemplateBinding Content}"
                                IsEnabled="{Binding IsActivated, Converter={StaticResource Boolean2BooleanReConverter}}" />

                            <Separator />

                            <ScrollViewer MaxHeight="200">
                                <TextBlock Text="{Binding WorkLog}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </StackPanel>
                    </DockPanel>
                </Border>

            </hc:SimplePanel>

            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBackground}" Value="False">
                    <Setter TargetName="btns" Property="Content" Value="{Binding}" />
                    <Setter TargetName="btns" Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <DockPanel LastChildFill="False">

                                    <!--  删除  -->
                                    <DockPanel
                                        Margin="5,0,0,0"
                                        LastChildFill="False"
                                        Visibility="{Binding IsActivated, Converter={StaticResource Boolean2VisibilityReConverter}}">
                                        <ToggleButton
                                            x:Name="a"
                                            hc:IconElement.Geometry="{StaticResource f.trash}"
                                            Style="{StaticResource ToggleButtonDanger.Small}"
                                            Visibility="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={StaticResource Boolean2VisibilityReConverter}}" />

                                        <Border
                                            VerticalAlignment="Center"
                                            BorderBrush="Red"
                                            BorderThickness="0,0,0,1"
                                            Visibility="{Binding ElementName=a, Path=IsChecked, Converter={StaticResource Boolean2VisibilityConverter}}">
                                            <DockPanel x:Name="b" Margin="4,0">
                                                <Button
                                                    Width="18"
                                                    Margin="0"
                                                    Padding="0"
                                                    hc:IconElement.Geometry="{StaticResource f.check}"
                                                    Command="{Binding DeleteMissionCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Foreground="Red"
                                                    Style="{StaticResource ButtonIcon.Small}" />
                                                <ToggleButton
                                                    x:Name="c"
                                                    Margin="0,0,-5,0"
                                                    hc:IconElement.Geometry="{StaticResource f.x}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Style="{StaticResource ToggleButtonIcon.Small}" />
                                            </DockPanel>
                                        </Border>
                                    </DockPanel>

                                    <ToggleButton
                                        Margin="0"
                                        Padding="0,-4,0,0"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        DockPanel.Dock="Right"
                                        IsChecked="{Binding IsActivated}"
                                        IsEnabled="{Binding IsAvailable}"
                                        Style="{StaticResource ToggleButtonFlip}">
                                        <hc:StatusSwitchElement.CheckedElement>
                                            <Viewbox Width="20" Height="20">
                                                <Path Data="{StaticResource f.play}" Fill="Green" />
                                            </Viewbox>
                                        </hc:StatusSwitchElement.CheckedElement>
                                        <Viewbox Width="20" Height="20">
                                            <Path Data="{StaticResource f.pause}" Fill="Red" />
                                        </Viewbox>
                                    </ToggleButton>


                                    <Button
                                        x:Name="runonce"
                                        Height="24"
                                        Margin="10,0"
                                        hc:IconElement.Geometry="{StaticResource f.check-double}"
                                        Background="AliceBlue"
                                        BorderThickness="0"
                                        Command="{Binding RunOnceCommand}"
                                        DockPanel.Dock="Right"
                                        IsEnabled="{Binding IsAvailable}"
                                        ToolTip="运行一次" />
                                </DockPanel>

                                <DataTemplate.Triggers>
                                    <Trigger SourceName="c" Property="IsChecked" Value="True">
                                        <Setter TargetName="a" Property="IsChecked" Value="False" />
                                        <Setter TargetName="c" Property="IsChecked" Value="False" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="cont" Property="Visibility" Value="Visible" />
                    <Setter TargetName="btns" Property="Visibility" Value="Visible" />
                    <Setter TargetName="status" Property="Visibility" Value="Hidden" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsActivated}" Value="False">
                    <Setter TargetName="content" Property="Opacity" Value="0.8" />
                    <Setter TargetName="border" Property="BorderBrush" Value="Gray" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActivated}" Value="True">
                    <Setter TargetName="borderTime" Property="Background" Value="Green" />
                    <Setter TargetName="borderTime" Property="TextElement.Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ManualSetNextRun}" Value="True">
                    <Setter TargetName="btn" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Template>
</UserControl>
