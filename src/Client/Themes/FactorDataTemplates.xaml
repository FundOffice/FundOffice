            <ListBox
                x:Name="ls"
                BorderThickness="0"
                ItemsSource="{Binding Rules}"
                Style="{StaticResource ListBoxCustom}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <hc:UniformSpacingPanel IsItemsHost="True" Spacing="5" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Border
                            Height="22"
                            MinWidth="120"
