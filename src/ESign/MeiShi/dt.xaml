<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO.ESigning.MeiShi">


    <DataTemplate DataType="{x:Type local:MeiShiChannelConfigViewModel}">
        <StackPanel>
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Width" Value="60" />
                </Style>

                <Style TargetType="BulletDecorator">
                    <Setter Property="Margin" Value="0,1" />
                </Style>
            </StackPanel.Resources>


            <BulletDecorator>
                <BulletDecorator.Bullet>
                    <TextBlock Text="用户名" />
                </BulletDecorator.Bullet>
                <TextBox Text="{Binding UserName}" />
            </BulletDecorator>


            <BulletDecorator>
                <BulletDecorator.Bullet>
                    <TextBlock Text="密码" />
                </BulletDecorator.Bullet>
                <TextBox Text="{Binding Password}" />
            </BulletDecorator>

        </StackPanel>
    </DataTemplate>



    <DataTemplate DataType="{x:Type local:MeiShiViewModel}">
        <hc:UniformSpacingPanel Orientation="Vertical">
            <BulletDecorator>
                <BulletDecorator.Bullet>
                    <TextBlock Width="50" Text="用户名" />
                </BulletDecorator.Bullet>
                <TextBox HorizontalContentAlignment="Center" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
            </BulletDecorator>
            <BulletDecorator>
                <BulletDecorator.Bullet>
                    <TextBlock Width="50" Text="密码" />
                </BulletDecorator.Bullet>
                <TextBox HorizontalContentAlignment="Center" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
            </BulletDecorator>
        </hc:UniformSpacingPanel>
    </DataTemplate>


    <DataTemplate DataType="{x:Type local:MeiShiWorkConfig}">
        <hc:UniformSpacingPanel Orientation="Vertical" VerticalSpacing="5">
            <CheckBox Content="通知投资人（邮件+短信）" IsChecked="{Binding Notify}" />
            <CheckBox Content="电子盖章" IsChecked="{Binding Seal}" />
        </hc:UniformSpacingPanel>
    </DataTemplate>

</ResourceDictionary>