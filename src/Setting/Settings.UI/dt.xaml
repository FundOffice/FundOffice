<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FMO.Settings">


    <DataTemplate DataType="{x:Type local:AbilityUnitViewModel}">
        <CheckBox
            Margin="2"
            Content="{Binding Title}"
            IsChecked="{Binding IsEnabled}"
            ToolTip="{Binding Description}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:SwitchUnitViewModel}">
        <CheckBox
            Margin="2"
            Content="{Binding Title}"
            IsChecked="{Binding IsEnabled}"
            ToolTip="{Binding Description}" />
    </DataTemplate>

</ResourceDictionary>