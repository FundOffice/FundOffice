<UserControl
    x:Class="FMO.Schedule.MissionShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO.Schedule"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>



        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />

        <sys:Boolean x:Key="Bool.True">True</sys:Boolean>
        <sys:Boolean x:Key="Bool.False">False</sys:Boolean>

        <sys:Double x:Key="TaskButtonSize">14</sys:Double>
        <sys:Double x:Key="TaskButtonSize2">18</sys:Double>


        <ControlTemplate x:Key="TaskRunTime" TargetType="ContentControl">
            <Grid>
                <Viewbox Width="{StaticResource TaskButtonSize}" Height="{StaticResource TaskButtonSize}">
                    <Path
                        x:Name="lb"
                        Data="{StaticResource f.angle-right}"
                        Fill="White" />
                </Viewbox>

                <Grid
                    VerticalAlignment="Center"
                    Background="{TemplateBinding Background}"
                    Visibility="{Binding IsActivated, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <ToggleButton
                        x:Name="toggle"
                        Width="{StaticResource TaskButtonSize}"
                        Height="{StaticResource TaskButtonSize}"
                        Padding="0"
                        VerticalContentAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource f.pen}"
                        Background="Transparent"
                        BorderThickness="0"
                        IsChecked="{Binding ManualSetNextRun}"
                        Style="{StaticResource ToggleButtonIcon}"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="toggle" Property="Visibility" Value="Visible" />
                </Trigger>
                <DataTrigger Binding="{Binding ManualSetNextRun}" Value="True">

                    <Setter TargetName="lb" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>
    <UserControl.Template>
        <ControlTemplate TargetType="UserControl">

            <hc:SimplePanel
                MinWidth="300"
                Margin="0,8"
                Background="Transparent">
                <Border
                    x:Name="tar"
                    Width="0"
                    Height="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" />
                <Border
                    x:Name="border"
                    Background="Transparent"
                    BorderBrush="Green"
                    BorderThickness="2"
                    CornerRadius="5">
                    <StackPanel>
                        <DockPanel Height="28" Margin="5">

                            <hc:CircleProgressBar
                                Width="20"
                                Height="20"
                                DockPanel.Dock="Right"
                                IsIndeterminate="True"
                                ShowText="False"
                                Style="{StaticResource ProgressBarSuccessCircle}"
                                Visibility="{Binding IsWorking, Converter={StaticResource Boolean2VisibilityConverter}}" />


                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Foreground="Red"
                                Text="未启动"
                                Visibility="{Binding IsActivated, Converter={StaticResource Boolean2VisibilityReConverter}}" />

                            <!--  Title  -->
                            <DockPanel LastChildFill="False">
                                <TextBlock
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    FontWeight="Black"
                                    Text="{Binding Title}" />




                                <Border
                                    VerticalAlignment="Center"
                                    Background="LightGray"
                                    Visibility="{Binding IsActivated, Converter={StaticResource Boolean2VisibilityConverter}}">
                                    <DockPanel Margin="5,2">
                                        <Viewbox Height="14">
                                            <Path Data="{StaticResource f.angles-right}" Fill="Green" />
                                        </Viewbox>

                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding NextRunTime, StringFormat=M/d HH:mm}" />
                                    </DockPanel>
                                </Border>

                            </DockPanel>
                            <!--  Title  -->
                        </DockPanel>

                    </StackPanel>
                </Border>

                <Popup
                    x:Name="pop"
                    Width="{Binding ActualWidth, ElementName=border}"
                    AllowsTransparency="True"
                    IsHitTestVisible="False"
                    Placement="Right"
                    PlacementTarget="{Binding ElementName=tar}"
                    StaysOpen="True">
                    <Border Background="White">
                        <Border
                            x:Name="extra"
                            Background="{Binding Background, ElementName=border}"
                            BorderBrush="{Binding BorderBrush, ElementName=border}"
                            BorderThickness="{Binding BorderThickness, ElementName=border}"
                            CornerRadius="{Binding CornerRadius, ElementName=border}"
                            IsHitTestVisible="True">
                            <StackPanel Margin="5">

                                <!--  head  -->
                                <DockPanel Height="28" Margin="5,0">

                                    <hc:CircleProgressBar
                                        Width="20"
                                        Height="20"
                                        DockPanel.Dock="Right"
                                        IsIndeterminate="True"
                                        ShowText="False"
                                        Style="{StaticResource ProgressBarSuccessCircle}"
                                        Visibility="{Binding IsWorking, Converter={StaticResource Boolean2VisibilityConverter}}" />


                                    <ToggleButton
                                        Margin="0"
                                        Padding="0,-4,0,0"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        DockPanel.Dock="Right"
                                        IsChecked="{Binding IsActivated}"
                                        IsEnabled="{Binding IsAvailable}"
                                        Style="{StaticResource ToggleButtonFlip}">
                                        <hc:StatusSwitchElement.CheckedElement>
                                            <Viewbox Width="20" Height="20">
                                                <Path Data="{StaticResource f.play}" Fill="Green" />
                                            </Viewbox>
                                        </hc:StatusSwitchElement.CheckedElement>
                                        <Viewbox Width="20" Height="20">
                                            <Path Data="{StaticResource f.pause}" Fill="Red" />
                                        </Viewbox>
                                    </ToggleButton>


                                    <Button
                                        x:Name="runonce"
                                        Height="24"
                                        Margin="10,0"
                                        hc:IconElement.Geometry="{StaticResource f.check-double}"
                                        Background="AliceBlue"
                                        BorderThickness="0"
                                        Command="{Binding RunOnceCommand}"
                                        Content="运行一次"
                                        DockPanel.Dock="Right"
                                        IsEnabled="{Binding IsAvailable}" />


                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="Black"
                                        Text="{Binding Title}" />



                                </DockPanel>

                                <Border
                                    x:Name="borderTime"
                                    Background="LightGray"
                                    IsEnabled="{Binding IsActivated}"
                                    TextElement.Foreground="#666666">
                                    <Border.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                        <Style
                                            x:Key="Style.Calendar"
                                            BasedOn="{StaticResource CalendarBaseStyle}"
                                            TargetType="Calendar">
                                            <Setter Property="Background" Value="Gray" />
                                        </Style>
                                    </Border.Resources>
                                    <UniformGrid
                                        Height="28"
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        Rows="1">
                                        <DockPanel Margin="0,2" Visibility="{Binding ManualSetNextRun, Converter={StaticResource Boolean2VisibilityReConverter}}">
                                            <Viewbox Width="{StaticResource TaskButtonSize}" Height="{StaticResource TaskButtonSize}">
                                                <Path Data="{StaticResource f.clock-rotate-left}" Fill="White" />
                                            </Viewbox>
                                            <TextBlock Text="{Binding LastRunTime, StringFormat=M/d HH:mm}" />
                                        </DockPanel>


                                        <DockPanel>
                                            <hc:SimplePanel x:Name="ng">
                                                <ContentControl Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}}" Template="{StaticResource TaskRunTime}" />

                                                <UniformGrid
                                                    x:Name="btn"
                                                    Width="50"
                                                    Rows="1">
                                                    <Button
                                                        Width="{StaticResource TaskButtonSize2}"
                                                        Height="{StaticResource TaskButtonSize2}"
                                                        Padding="0"
                                                        hc:IconElement.Geometry="{DynamicResource f.circle-check}"
                                                        Command="{Binding DoManualSetNextRunTimeCommand}"
                                                        CommandParameter="{StaticResource Bool.True}"
                                                        Foreground="White"
                                                        Style="{StaticResource ButtonIcon}"
                                                        Visibility="{Binding ManualSetNextRun, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <Button
                                                        Width="{StaticResource TaskButtonSize2}"
                                                        Height="{StaticResource TaskButtonSize2}"
                                                        Padding="0"
                                                        hc:IconElement.Geometry="{DynamicResource f.ban}"
                                                        Command="{Binding DoManualSetNextRunTimeCommand}"
                                                        CommandParameter="{StaticResource Bool.False}"
                                                        Foreground="White"
                                                        Style="{StaticResource ButtonIcon}"
                                                        Visibility="{Binding ManualSetNextRun, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </UniformGrid>
                                            </hc:SimplePanel>
                                            <Grid>
                                                <UniformGrid
                                                    Margin="5,0,0,0"
                                                    Columns="1"
                                                    Visibility="{Binding ManualSetNextRun, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <hc:DateTimePicker HorizontalContentAlignment="Center" SelectedDateTime="{Binding NextRunTime}" />
                                                </UniformGrid>

                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Text="{Binding NextRunTime, StringFormat=M/d HH:mm}"
                                                    Visibility="{Binding ManualSetNextRun, Converter={StaticResource Boolean2VisibilityReConverter}}" />

                                            </Grid>
                                        </DockPanel>
                                    </UniformGrid>
                                </Border>


                                <Separator />

                                <ContentPresenter
                                    x:Name="content"
                                    Content="{TemplateBinding Content}"
                                    IsEnabled="{Binding IsActivated, Converter={StaticResource Boolean2BooleanReConverter}}" />

                                <Separator />

                                <ListBox
                                    BorderThickness="0"
                                    ItemsSource="{Binding Logs}"
                                    Style="{StaticResource ListBoxCustom}" />
                            </StackPanel>
                        </Border>
                    </Border>
                </Popup>
            </hc:SimplePanel>

            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="pop" Property="IsOpen" Value="True" />
                </Trigger>

                <!--  1. 鼠标离开 Popup 内容(extra)时，启动延迟关闭  -->
                <EventTrigger RoutedEvent="MouseLeave" SourceName="extra">
                    <BeginStoryboard x:Name="CloseDelayTimer">
                        <!--  关键：添加 FillBehavior="Stop" 避免动画结束后锁定属性值  -->
                        <Storyboard FillBehavior="Stop">
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="pop" Storyboard.TargetProperty="IsOpen">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{StaticResource Bool.False}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>



                <DataTrigger Binding="{Binding IsActivated}" Value="False">
                    <Setter TargetName="content" Property="Opacity" Value="0.8" />
                    <Setter TargetName="border" Property="BorderBrush" Value="Gray" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActivated}" Value="True">
                    <Setter TargetName="borderTime" Property="Background" Value="Green" />
                    <Setter TargetName="borderTime" Property="TextElement.Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ManualSetNextRun}" Value="True">
                    <Setter TargetName="btn" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Template>
</UserControl>
