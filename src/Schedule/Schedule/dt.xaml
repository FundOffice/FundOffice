<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:FMO.Schedule"
    xmlns:m="clr-namespace:FMO.Schedule;assembly=Mission"
    xmlns:shared="clr-namespace:FMO.Shared;assembly=SharedUI">


    <DataTemplate DataType="{x:Type m:MissionViewModel}">
        <TextBlock Text="后台任务" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type m:OnceMissionViewModel}">
        <TextBlock Text="{Binding Description}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:DailyFromMailViewModel}">
        <DataTemplate.Resources>
            <Style BasedOn="{StaticResource TextBlockDefault}" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Style>
        </DataTemplate.Resources>
        <StackPanel
            Margin="8,0"
            VerticalAlignment="Center"
            DockPanel.Dock="Top"
            IsEnabled="{Binding IsWorking, Converter={StaticResource Boolean2BooleanReConverter}}">


            <hc:TextBox
                hc:InfoElement.Placeholder="邮箱 user@mail.com"
                shared:MaskService.IsMask="True"
                Text="{Binding MailName, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                TextAlignment="Center" />

            <DockPanel>
                <TextBlock Margin="10,0,0,0" Text="运行时间间隔" />
                <hc:NumericUpDown Margin="4,0" Value="{Binding Interval}" />
                <TextBlock Text="分" />

                <Button
                    Margin="10,0"
                    Command="{Binding RebuildDataCommand}"
                    Content="重建"
                    IsEnabled="{Binding IsAvailable}" />
            </DockPanel>

            <ProgressBar
                Margin="0,6,0,0"
                DockPanel.Dock="Bottom"
                Visibility="{Binding IsWorking, Converter={StaticResource Boolean2VisibilityConverter}}"
                Value="{Binding ProgressValue}" />

        </StackPanel>
    </DataTemplate>





    <DataTemplate DataType="{x:Type local:MailCacheViewModel}">
        <DataTemplate.Resources>
            <local:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
            <Style TargetType="Viewbox">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
            </Style>
            <Style BasedOn="{StaticResource TextBlockDefault}" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style
                x:Key="Style.Credential"
                BasedOn="{StaticResource TextBoxExtend}"
                TargetType="TextBox">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="220" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style BasedOn="{StaticResource PasswordBoxExtend}" TargetType="PasswordBox">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="220" />
                <Setter Property="FontSize" Value="14" />
            </Style>
        </DataTemplate.Resources>
        <StackPanel>
            <hc:SimplePanel>

                <TextBox
                    Padding="5,0,0,0"
                    hc:InfoElement.Placeholder="POP3"
                    Style="{StaticResource Style.Credential}"
                    Text="{Binding MailPop3, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                    TextAlignment="Left" />

                <Viewbox Margin="5,0" HorizontalAlignment="Right">
                    <Path Data="{StaticResource f.globe}" Fill="{Binding IsServerAvailable, Converter={StaticResource BooleanToBrushConverter}}" />
                </Viewbox>
            </hc:SimplePanel>


            <TextBox
                hc:InfoElement.Placeholder="用户名"
                shared:MaskService.IsMask="True"
                Style="{StaticResource Style.Credential}"
                Text="{Binding MailName, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                TextAlignment="Left" />

            <DockPanel>

                <Button
                    HorizontalAlignment="Right"
                    Command="{Binding VerifyAccountCommand}"
                    Content="验证"
                    DockPanel.Dock="Right"
                    Visibility="{Binding IsAccountVerified, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                <hc:SimplePanel>
                    <hc:PasswordBox
                        x:Name="pMail"
                        Width="auto"
                        Padding="5,0,30,0"
                        hc:InfoElement.Placeholder="密码"
                        IsSafeEnabled="False"
                        ShowEyeButton="True"
                        Tag="MailPwd"
                        UnsafePassword="{Binding MailPassword}" />

                    <Viewbox Margin="5,0" HorizontalAlignment="Right">
                        <Path Data="{StaticResource f.envelope-circle-check}" Fill="{Binding IsAccountVerified, Converter={StaticResource BooleanToBrushConverter}}" />
                    </Viewbox>
                </hc:SimplePanel>
            </DockPanel>

            <DockPanel
                Margin="8,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Top"
                IsEnabled="{Binding IsWorking, Converter={StaticResource Boolean2VisibilityReConverter}}"
                LastChildFill="False">
                <TextBlock Text="运行时间间隔" />
                <TextBox
                    Width="40"
                    Margin="4,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                <TextBlock Text="分" />

                <Button
                    Margin="10,0"
                    Command="{Binding RebuildDataCommand}"
                    Content="重建"
                    IsEnabled="{Binding IsAccountVerified}" />
            </DockPanel>

            <ProgressBar Visibility="{Binding IsWorking, Converter={StaticResource Boolean2VisibilityConverter}}" Value="{Binding ProgressValue}" />
        </StackPanel>
    </DataTemplate>





    <DataTemplate DataType="{x:Type local:DisclosureFromMailViewModel}">
        <DataTemplate.Resources>
            <Style BasedOn="{StaticResource TextBlockDefault}" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Style>
        </DataTemplate.Resources>
        <StackPanel
            Margin="8,0"
            VerticalAlignment="Center"
            DockPanel.Dock="Top"
            IsEnabled="{Binding IsWorking, Converter={StaticResource Boolean2BooleanReConverter}}">


            <hc:TextBox
                hc:InfoElement.Placeholder="邮箱 user@mail.com"
                shared:MaskService.IsMask="True"
                Text="{Binding MailName, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                TextAlignment="Center" />

            <DockPanel>
                <TextBlock Margin="10,0,0,0" Text="运行时间间隔" />
                <hc:NumericUpDown Margin="4,0" Value="{Binding Interval}" />
                <TextBlock Text="小时" />

                <Button
                    Margin="10,0"
                    Command="{Binding RebuildDataCommand}"
                    Content="重建"
                    IsEnabled="{Binding IsAvailable}" />
            </DockPanel>



            <ProgressBar
                Margin="0,6,0,0"
                DockPanel.Dock="Bottom"
                Visibility="{Binding IsWorking, Converter={StaticResource Boolean2VisibilityConverter}}"
                Value="{Binding ProgressValue}" />

        </StackPanel>
    </DataTemplate>


    <DataTemplate DataType="{x:Type local:SendDailyReportToWebhookViewModel}">
        <DataTemplate.Resources>
            <local:DateTimeToTimeOnlyConverter x:Key="DateTimeToTimeOnlyConverter" />
        </DataTemplate.Resources>
        <DockPanel>

            <DockPanel>
                <DockPanel
                    Margin="0,2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Bottom">
                    <TextBlock
                        HorizontalAlignment="Center"
                        DockPanel.Dock="Top"
                        Text="发送时间" />
                    <hc:TimePicker Width="90" SelectedTime="{Binding Time, Converter={StaticResource DateTimeToTimeOnlyConverter}}" />
                </DockPanel>
                <Border Background="Lavender">
                    <TextBlock VerticalAlignment="Center" Text="WebHook地址" />
                </Border>
            </DockPanel>


            <ListBox
                Background="Lavender"
                ItemsSource="{Binding WebHooks}"
                Style="{StaticResource ListBoxCustom}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <CheckBox IsChecked="{Binding IsEnabled}" />
                            <TextBox
                                HorizontalAlignment="Stretch"
                                shared:MaskService.IsMask="True"
                                AcceptsReturn="True"
                                Text="{Binding Url, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                TextWrapping="Wrap" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DataTemplate>



    <DataTemplate DataType="{x:Type local:TAFromMailViewModel}">
        <DataTemplate.Resources>
            <Style BasedOn="{StaticResource TextBlockDefault}" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="14" />
            </Style>
        </DataTemplate.Resources>
        <StackPanel
            Margin="8,0"
            VerticalAlignment="Center"
            DockPanel.Dock="Top"
            IsEnabled="{Binding IsWorking, Converter={StaticResource Boolean2BooleanReConverter}}">


            <hc:TextBox
                hc:InfoElement.Placeholder="邮箱 user@mail.com"
                shared:MaskService.IsMask="True"
                Text="{Binding MailName, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                TextAlignment="Center" />

            <DockPanel>
                <TextBlock Margin="10,0,0,0" Text="运行时间间隔" />
                <hc:NumericUpDown Margin="4,0" Value="{Binding Interval}" />
                <TextBlock Text="分" />

                <Button
                    Margin="10,0"
                    Command="{Binding RebuildDataCommand}"
                    Content="重建"
                    IsEnabled="{Binding IsAvailable}" />
            </DockPanel>



            <ProgressBar
                Margin="0,6,0,0"
                DockPanel.Dock="Bottom"
                Visibility="{Binding IsWorking, Converter={StaticResource Boolean2VisibilityConverter}}"
                Value="{Binding ProgressValue}" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>