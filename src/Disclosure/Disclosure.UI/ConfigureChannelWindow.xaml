<Window
    x:Class="FMO.Disclosure.ConfigureChannelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FMO.Disclosure"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="配置信批通道"
    Width="350"
    Height="350"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <DockPanel>
        <DockPanel.Resources>
            <DataTemplate x:Key="ChannelTpl">
                <TextBlock Text="{Binding Name}" />
            </DataTemplate>








        </DockPanel.Resources>


        <DockPanel DataContext="{Binding Config}" DockPanel.Dock="Bottom">
            <TextBlock
                Margin="5,2"
                DockPanel.Dock="Bottom"
                Foreground="Red"
                Text="{Binding Error}"
                TextWrapping="Wrap" />
            <Button
                Margin="5,2"
                HorizontalAlignment="Stretch"
                Command="{Binding SaveCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Content="保存"
                Style="{StaticResource ButtonPrimary}" />
        </DockPanel>

        <ContentControl Margin="8" Content="{Binding Config}" />
    </DockPanel>

</Window>
