<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FMO.Disclosure">
    <DataTemplate DataType="{x:Type local:EmailChannelConfigViewModel}">
        <StackPanel>
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Width" Value="60" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>

                <Style TargetType="BulletDecorator">
                    <Setter Property="Margin" Value="0,1" />
                </Style>
            </StackPanel.Resources>
            <TextBlock
                Width="auto"
                Foreground="Orange"
                TextWrapping="Wrap">
                <Run>邮件通道只保证发出，不保证投资人收到</Run>
                <LineBreak />
                <Run>请仔细确认投资人Email是否正确</Run>
                <LineBreak />
                <Run>请自行检查是否有退信</Run>
            </TextBlock>

            <Separator />

            <BulletDecorator>
                <BulletDecorator.Bullet>
                    <TextBlock Text="SMTP" />
                </BulletDecorator.Bullet>
                <TextBox Text="{Binding SmtpHost}" />
            </BulletDecorator>

            <DockPanel>
                <TextBlock Text="Port" />
                <TextBox Width="50" Text="{Binding SmtpPort}" />

                <CheckBox
                    Margin="8,0"
                    Content="SSL"
                    IsChecked="{Binding UseSsl}" />
            </DockPanel>

            <BulletDecorator>
                <BulletDecorator.Bullet>
                    <TextBlock Text="用户名" />
                </BulletDecorator.Bullet>
                <TextBox Text="{Binding UserName}" />
            </BulletDecorator>


            <BulletDecorator>
                <BulletDecorator.Bullet>
                    <TextBlock Text="授权码" />
                </BulletDecorator.Bullet>
                <TextBox Text="{Binding Password}" />
            </BulletDecorator>

        </StackPanel>
    </DataTemplate>


    <DataTemplate DataType="{x:Type local:PfidChannelConfigViewModel}">
        <StackPanel>
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Width" Value="60" />
                </Style>

                <Style TargetType="BulletDecorator">
                    <Setter Property="Margin" Value="0,1" />
                </Style>
            </StackPanel.Resources>


            <BulletDecorator>
                <BulletDecorator.Bullet>
                    <TextBlock Text="用户名" />
                </BulletDecorator.Bullet>
                <TextBox Text="{Binding UserName}" />
            </BulletDecorator>


            <BulletDecorator>
                <BulletDecorator.Bullet>
                    <TextBlock Text="密码" />
                </BulletDecorator.Bullet>
                <TextBox Text="{Binding Password}" />
            </BulletDecorator>

            <BulletDecorator>
                <BulletDecorator.Bullet>
                    <TextBlock Text="密钥" />
                </BulletDecorator.Bullet>
                <TextBox Text="{Binding Secret}" />
            </BulletDecorator>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:QuarterlyUpdateChannelConfigViewModel}">
        <StackPanel>
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Width" Value="60" />
                </Style>

                <Style TargetType="BulletDecorator">
                    <Setter Property="Margin" Value="0,1" />
                </Style>
            </StackPanel.Resources>

            <TextBlock Width="auto" Foreground="Blue">
                <Run Text="此处填直连报送的账号" />
            </TextBlock>

            <Separator />

            <BulletDecorator>
                <BulletDecorator.Bullet>
                    <TextBlock Text="用户名" />
                </BulletDecorator.Bullet>
                <TextBox Text="{Binding UserName}" />
            </BulletDecorator>


            <BulletDecorator>
                <BulletDecorator.Bullet>
                    <TextBlock Text="密码" />
                </BulletDecorator.Bullet>
                <TextBox Text="{Binding Password}" />
            </BulletDecorator>

            <BulletDecorator>
                <BulletDecorator.Bullet>
                    <TextBlock Text="密钥" />
                </BulletDecorator.Bullet>
                <TextBox Text="{Binding Secret}" />
            </BulletDecorator>
        </StackPanel>
    </DataTemplate>


</ResourceDictionary>